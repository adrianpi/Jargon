void FreeImage_ConvertLine32To16_555(byte* target, byte* source, int widthInPixels) external;

// To 16-bit 565
void FreeImage_ConvertLine1To16_565(byte* target, byte* source, int widthInPixels, RGBQUAD* palette) external;
