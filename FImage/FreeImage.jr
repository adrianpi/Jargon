// =======================================================
// Enums
// =======================================================

// I/O image format identifiers
enum ImageFormat
{
    Unknown     = 0xFFFFFFFF,
    Bmp         = 0x00,
    Ico         = 0x01,
    Jpeg        = 0x02,
    Jng         = 0x03,
    Koala       = 0x04,
    Lbm         = 0x05,
    Mng         = 0x06,
    Pbm         = 0x07,
    PbmRaw      = 0x08,
    Pcd         = 0x09,
    Pcx         = 0x0A,
    Pgm         = 0x0B,
    PgmRaw      = 0x0C,
    Png         = 0x0D,
    Ppm         = 0x0E,
    PpmRaw      = 0x0F,
    Ras         = 0x10,
    Targa       = 0x11,
    Tiff        = 0x12,
    Wbmp        = 0x13,
    Psd         = 0x14,
    Cut         = 0x15,
    Xbm         = 0x16,
    Xpm         = 0x17,
    Dds         = 0x18,
    Gif         = 0x19,
    Hdr         = 0x1A,
    FaxG3       = 0x1B,
    Sgi         = 0x1C,
    Exr         = 0x1D,
    J2k         = 0x1E,
    Jp2         = 0x1F,
    Pfm         = 0x20,
    Pict        = 0x21,
    Raw         = 0x22,
    Webp        = 0x23,
    Jxr         = 0x24,
}

// Image type
enum ImageType
{
    Unknown     = 0x00,
    Bitmap      = 0x01,
    UInt16      = 0x02,
    Int16       = 0x03,
    UInt32      = 0x04,
    Int32       = 0x05,
    Float       = 0x06,
    Double      = 0x07,
    Complex     = 0x08,
    Rgb16       = 0x09,
    Rgba16      = 0x0A,
    RgbF        = 0x0B,
    RgbaF       = 0x0C,
}

// Image color type
enum ColorType
{
    MinIsWhite  = 0x00,
    MinIsBlack  = 0x01,
    Rgb         = 0x02,
    Palette     = 0x03,
    RgbAlpha    = 0x04,
    Cmyk        = 0x05,
}

// Color quantization algorithms
enum Quantize
{
    WuQuant     = 0x00,
    NnQuant     = 0x01,
    LfpQuant    = 0x02,
}

// Dithering algorithms
enum Dither
{
    FloydSteinberg = 0x00,
    Bayer4x4       = 0x01,
    Bayer8x8       = 0x02,
    Cluster6x6     = 0x03,
    Cluster8x8     = 0x04,
    Cluster16x16   = 0x05,
    Bayer16x16     = 0x06,
}

// Lossless JPEG transformations
enum JpegOperation
{
    None        = 0x00,
    FlipH       = 0x01,
    FlipV       = 0x02,
    Transpose   = 0x03,
    Transverse  = 0x04,
    Rotate90    = 0x05,
    Rotate180   = 0x06,
    Rotate270   = 0x07,
}

// Tone mapping operators
enum ToneMappingOperator
{
    Drago03     = 0x00,
    Reinhard05  = 0x01,
    Fattal02    = 0x02,
}

// Upsampling / downsampling filters
enum Filter
{
    Box         = 0x00,
    Bicubic     = 0x01,
    Bilinear    = 0x02,
    BSpline     = 0x03,
    CatmullRom  = 0x04,
    Lanczos3    = 0x05,
}

// Color channels
enum ColorChannel
{
    Rgb         = 0x00,
    Red         = 0x01,
    Green       = 0x02,
    Blue        = 0x03,
    Alpha       = 0x04,
    Black       = 0x05,
    Real        = 0x06,
    Imag        = 0x07,
    Mag         = 0x08,
    Phase       = 0x09,
}

// Metadata data type (based on TIFF specifications)
enum MetadataType
{
    NoType      = 0x00,
    Byte        = 0x01,
    Ascii       = 0x02,
    Short       = 0x03,
    Long        = 0x04,
    Rational    = 0x05,
    SByte       = 0x06,
    Undefined   = 0x07,
    SShort      = 0x08,
    SLong       = 0x09,
    SRational   = 0x0A,
    Float       = 0x0B,
    Double      = 0x0C,
    Ifd         = 0x0D,
    Palette     = 0x0E,
    Long8       = 0x10,
    SLong8      = 0x11,
    Ifd8        = 0x12,
}

// Metadata models
enum MetadataModel
{
    NoData         = 0xFFFFFFFF,
    Comments       = 0x00,
    ExifMain       = 0x01,
    ExifExif       = 0x02,
    ExifGps        = 0x03,
    ExifMakerNote  = 0x04,
    ExifInterop    = 0x05,
    Iptc           = 0x06,
    Xmp            = 0x07,
    GeoTiff        = 0x08,
    Animation      = 0x09,
    Custom         = 0x0A,
    ExifRaw        = 0x0B,
}

// =======================================================
// Structs
// =======================================================

// 32-bit RGBA (BGR order on little-endian)
struct RGBQUAD {
    byte blue;
    byte green;
    byte red;
    byte reserved;
}

// 24-bit RGB (BGR order on little-endian)
struct RGBTRIPLE {
    byte blue;
    byte green;
    byte red;
}

// Bitmap info header (Windows BITMAPINFOHEADER)
struct BITMAPINFOHEADER {
    uint  biSize;
    int   biWidth;
    int   biHeight;
    short biPlanes;
    short biBitCount;
    uint  biCompression;
    uint  biSizeImage;
    int   biXPelsPerMeter;
    int   biYPelsPerMeter;
    uint  biClrUsed;
    uint  biClrImportant;
}

// 48-bit RGB (16-bit per channel)
struct FIRGB16 {
    short red;
    short green;
    short blue;
}

// 64-bit RGBA (16-bit per channel)
struct FIRGBA16 {
    short red;
    short green;
    short blue;
    short alpha;
}

// 96-bit RGB Float
struct FIRGBF {
    float red;
    float green;
    float blue;
}

// 128-bit RGBA Float
struct FIRGBAF {
    float red;
    float green;
    float blue;
    float alpha;
}

// Complex number
struct FICOMPLEX {
    double r;
    double i;
}

// ICC profile
struct FIICCPROFILE {
    short flags;
    uint  size;
    void* data;
}

// I/O structure (function pointers)
struct FreeImageIO {
    void* readProc;
    void* writeProc;
    void* seekProc;
    void* tellProc;
}

// =======================================================
// Init / DeInit
// =======================================================
void FreeImage_Initialise(int loadLocalPluginsOnly) external;
void FreeImage_DeInitialise() external;

// =======================================================
// Version
// =======================================================
byte* FreeImage_GetVersion() external;
byte* FreeImage_GetCopyrightMessage() external;

// =======================================================
// Message output
// =======================================================
void FreeImage_SetOutputMessageStdCall(void* omf) external;
void FreeImage_SetOutputMessage(void* omf) external;

// =======================================================
// Allocate / Clone / Unload
// =======================================================
void* FreeImage_Allocate(int width, int height, int bpp, uint redMask, uint greenMask, uint blueMask) external;
void* FreeImage_AllocateT(int type, int width, int height, int bpp, uint redMask, uint greenMask, uint blueMask) external;
void* FreeImage_Clone(void* dib) external;
void  FreeImage_Unload(void* dib) external;

// Header loading
int FreeImage_HasPixels(void* dib) external;

// =======================================================
// Load / Save
// =======================================================
void* FreeImage_Load(int fif, byte* filename, int flags) external;
void* FreeImage_LoadFromHandle(int fif, FreeImageIO* io, void* handle, int flags) external;
int   FreeImage_Save(int fif, void* dib, byte* filename, int flags) external;
int   FreeImage_SaveToHandle(int fif, void* dib, FreeImageIO* io, void* handle, int flags) external;

// =======================================================
// Memory I/O stream
// =======================================================
void* FreeImage_OpenMemory(byte* data, uint sizeInBytes) external;
void  FreeImage_CloseMemory(void* stream) external;
void* FreeImage_LoadFromMemory(int fif, void* stream, int flags) external;
int   FreeImage_SaveToMemory(int fif, void* dib, void* stream, int flags) external;
int   FreeImage_TellMemory(void* stream) external;
int   FreeImage_SeekMemory(void* stream, int offset, int origin) external;
int   FreeImage_AcquireMemory(void* stream, byte** data, uint* sizeInBytes) external;
uint  FreeImage_ReadMemory(void* buffer, uint size, uint count, void* stream) external;
uint  FreeImage_WriteMemory(void* buffer, uint size, uint count, void* stream) external;
void* FreeImage_LoadMultiBitmapFromMemory(int fif, void* stream, int flags) external;
int   FreeImage_SaveMultiBitmapToMemory(int fif, void* bitmap, void* stream, int flags) external;

// =======================================================
// Plugin Interface
// =======================================================
int   FreeImage_GetFIFCount() external;
int   FreeImage_SetPluginEnabled(int fif, int enable) external;
int   FreeImage_IsPluginEnabled(int fif) external;
int   FreeImage_GetFIFFromFormat(byte* format) external;
int   FreeImage_GetFIFFromMime(byte* mime) external;
byte* FreeImage_GetFormatFromFIF(int fif) external;
byte* FreeImage_GetFIFExtensionList(int fif) external;
byte* FreeImage_GetFIFDescription(int fif) external;
byte* FreeImage_GetFIFRegExpr(int fif) external;
byte* FreeImage_GetFIFMimeType(int fif) external;
int   FreeImage_GetFIFFromFilename(byte* filename) external;
int   FreeImage_FIFSupportsReading(int fif) external;
int   FreeImage_FIFSupportsWriting(int fif) external;
int   FreeImage_FIFSupportsExportBPP(int fif, int bpp) external;
int   FreeImage_FIFSupportsExportType(int fif, int type) external;
int   FreeImage_FIFSupportsICCProfiles(int fif) external;
int   FreeImage_FIFSupportsNoPixels(int fif) external;

// =======================================================
// Multipage
// =======================================================
void* FreeImage_OpenMultiBitmap(int fif, byte* filename, int createNew, int readOnly, int keepCacheInMemory, int flags) external;
void* FreeImage_OpenMultiBitmapFromHandle(int fif, FreeImageIO* io, void* handle, int flags) external;
int   FreeImage_SaveMultiBitmapToHandle(int fif, void* bitmap, FreeImageIO* io, void* handle, int flags) external;
int   FreeImage_CloseMultiBitmap(void* bitmap, int flags) external;
int   FreeImage_GetPageCount(void* bitmap) external;
void  FreeImage_AppendPage(void* bitmap, void* data) external;
void  FreeImage_InsertPage(void* bitmap, int page, void* data) external;
void  FreeImage_DeletePage(void* bitmap, int page) external;
void* FreeImage_LockPage(void* bitmap, int page) external;
void  FreeImage_UnlockPage(void* bitmap, void* data, int changed) external;
int   FreeImage_MovePage(void* bitmap, int target, int source) external;
int   FreeImage_GetLockedPageNumbers(void* bitmap, int* pages, int* count) external;

// =======================================================
// File type request
// =======================================================
int FreeImage_GetFileType(byte* filename, int size) external;
int FreeImage_GetFileTypeFromHandle(FreeImageIO* io, void* handle, int size) external;
int FreeImage_GetFileTypeFromMemory(void* stream, int size) external;
int FreeImage_Validate(int fif, byte* filename) external;
int FreeImage_ValidateFromHandle(int fif, FreeImageIO* io, void* handle) external;
int FreeImage_ValidateFromMemory(int fif, void* stream) external;

// =======================================================
// Image type request
// =======================================================
int FreeImage_GetImageType(void* dib) external;

// =======================================================
// Helper routines
// =======================================================
int FreeImage_IsLittleEndian() external;
int FreeImage_LookupX11Color(byte* szColor, byte* nRed, byte* nGreen, byte* nBlue) external;
int FreeImage_LookupSVGColor(byte* szColor, byte* nRed, byte* nGreen, byte* nBlue) external;

// =======================================================
// Pixel access
