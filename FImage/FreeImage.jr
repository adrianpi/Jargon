// =======================================================
// Version
// =======================================================
const int FREEIMAGE_MAJOR_VERSION = 0x03;
const int FREEIMAGE_MINOR_VERSION = 0x13;
const int FREEIMAGE_RELEASE_SERIAL = 0x00;

// =======================================================
// RGBA channel indices (little-endian BGR order)
// =======================================================
const int FI_RGBA_RED   = 0x02;
const int FI_RGBA_GREEN = 0x01;
const int FI_RGBA_BLUE  = 0x00;
const int FI_RGBA_ALPHA = 0x03;

// RGBA channel masks
const uint FI_RGBA_RED_MASK   = 0x00FF0000U;
const uint FI_RGBA_GREEN_MASK = 0x0000FF00U;
const uint FI_RGBA_BLUE_MASK  = 0x000000FFU;
const uint FI_RGBA_ALPHA_MASK = 0xFF000000U;

// RGBA channel shifts
const int FI_RGBA_RED_SHIFT   = 0x10;
const int FI_RGBA_GREEN_SHIFT = 0x08;
const int FI_RGBA_BLUE_SHIFT  = 0x00;
const int FI_RGBA_ALPHA_SHIFT = 0x18;

// 16-bit 555 masks and shifts
const int FI16_555_RED_MASK    = 0x7C00;
const int FI16_555_GREEN_MASK  = 0x03E0;
const int FI16_555_BLUE_MASK   = 0x001F;
const int FI16_555_RED_SHIFT   = 0x0A;
const int FI16_555_GREEN_SHIFT = 0x05;
const int FI16_555_BLUE_SHIFT  = 0x00;

// 16-bit 565 masks and shifts
const int FI16_565_RED_MASK    = 0xF800;
const int FI16_565_GREEN_MASK  = 0x07E0;
const int FI16_565_BLUE_MASK   = 0x001F;
const int FI16_565_RED_SHIFT   = 0x0B;
const int FI16_565_GREEN_SHIFT = 0x05;
const int FI16_565_BLUE_SHIFT  = 0x00;

