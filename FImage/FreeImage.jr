void FreeImage_SetDotsPerMeterX(void* dib, uint res) external;
void FreeImage_SetDotsPerMeterY(void* dib, uint res) external;

BITMAPINFOHEADER* FreeImage_GetInfoHeader(void* dib) external;
void* FreeImage_GetInfo(void* dib) external;
int  FreeImage_GetColorType(void* dib) external;

uint FreeImage_GetRedMask(void* dib) external;
uint FreeImage_GetGreenMask(void* dib) external;
uint FreeImage_GetBlueMask(void* dib) external;

