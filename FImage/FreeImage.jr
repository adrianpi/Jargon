int  FreeImage_HasBackgroundColor(void* dib) external;
int  FreeImage_GetBackgroundColor(void* dib, RGBQUAD* bkcolor) external;
int  FreeImage_SetBackgroundColor(void* dib, RGBQUAD* bkcolor) external;

void* FreeImage_GetThumbnail(void* dib) external;
int   FreeImage_SetThumbnail(void* dib, void* thumbnail) external;

// =======================================================
// ICC profile
