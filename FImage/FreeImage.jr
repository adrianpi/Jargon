int   FreeImage_GetPixelIndex(void* dib, uint x, uint y, byte* value) external;
int   FreeImage_GetPixelColor(void* dib, uint x, uint y, RGBQUAD* value) external;
int   FreeImage_SetPixelIndex(void* dib, uint x, uint y, byte* value) external;
int   FreeImage_SetPixelColor(void* dib, uint x, uint y, RGBQUAD* value) external;

