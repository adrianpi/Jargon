using jargon;

//////////////////////////////////////////////////////////
// Minimal FreeImage viewer — loads a JPEG and displays it
// in a Win32 window using SetDIBitsToDevice.
// FreeImage is a powerful open-source library for image 
// loading, saving, and manipulation.
// Its available at https://github.com/danoli3/FreeImage
// You may need to adjust the library include path.
//////////////////////////////////////////////////////////

// =======================================================
// Win32 constants
// =======================================================
const int WS_OVERLAPPEDWINDOW = 0x00CF0000;
const int SW_SHOW = 0x05;
const uint WM_DESTROY = 0x0002;
const uint WM_PAINT   = 0x000F;
const int  DIB_RGB_COLORS = 0x00;
const int  SRCCOPY = 0x00CC0020;

// =======================================================
// Win32 structures
// =======================================================
struct POINT {
    int x;
    int y;
}

struct MSG {
    long    hwnd;
    uint    message;
    ulong   wParam;
    ulong   lParam;
    uint    time;
    POINT   pt;
}

struct RECT {
    int left;
    int top;
    int right;
    int bottom;
}

struct PAINTSTRUCT {
    long  hdc;
    int   fErase;
    RECT  rcPaint;
    int   fRestore;
    int   fIncUpdate;
    byte  rgbReserved[32];
}

struct WNDCLASSA {
    uint    style;
    void*   lpfnWndProc;
    int     cbClsExtra;
    int     cbWndExtra;
    long    hInstance;
    long    hIcon;
    long    hCursor;
    long    hbrBackground;
    byte*   lpszMenuName;
    byte*   lpszClassName;
}

// =======================================================
// Win32 external functions
// =======================================================
void  PostQuitMessage(int nExitCode) external;
long  DefWindowProcA(long hwnd, uint uMsg, ulong wParam, ulong lParam) external;
short RegisterClassA(WNDCLASSA* lpWndClass) external;
long  CreateWindowExA(
    uint dwExStyle,
    byte* lpClassName,
    byte* lpWindowName,
    uint dwStyle,
    int X, int Y, int nWidth, int nHeight,
    long hWndParent,
    long hMenu,
    long hInstance,
    void* lpParam
) external;
void ShowWindow(long hWnd, int nCmdShow) external;
void UpdateWindow(long hWnd) external;
short GetMessageA(MSG* lpMsg, long hWnd, uint wMsgFilterMin, uint wMsgFilterMax) external;
void TranslateMessage(MSG* lpMsg) external;
void DispatchMessageA(MSG* lpMsg) external;
long GetModuleHandleA(byte* lpModuleName) external;
long BeginPaint(long hWnd, PAINTSTRUCT* lpPaint) external;
int  EndPaint(long hWnd, PAINTSTRUCT* lpPaint) external;
int  SetDIBitsToDevice(
    long hdc,
    int xDest, int yDest,
    uint w, uint h,
    int xSrc, int ySrc,
    uint startScan, uint numScans,
    byte* bits,
    void* bmi,
    uint colorUse
) external;
int  GetClientRect(long hWnd, RECT* lpRect) external;

// =======================================================
// Globals
// =======================================================
void* gBitmap = null;

// =======================================================
// Window procedure
// =======================================================
long WindowProc(long hwnd, uint uMsg, ulong wParam, ulong lParam)
{
    if (uMsg == WM_PAINT)
    {
        PAINTSTRUCT ps = {};
        long hdc = BeginPaint(hwnd, &ps);

        if (gBitmap != null)
        {
            uint w = FreeImage_GetWidth(gBitmap);
            uint h = FreeImage_GetHeight(gBitmap);
            byte* bits = FreeImage_GetBits(gBitmap);
            void* info = FreeImage_GetInfo(gBitmap);

            SetDIBitsToDevice(
                hdc,
                0, 0,
                w, h,
                0, 0,
                0, h,
                bits,
                info,
                DIB_RGB_COLORS
            );
        }

        EndPaint(hwnd, &ps);
        return 0;
    }
    else if (uMsg == WM_DESTROY)
    {
        PostQuitMessage(0);
        return 0;
    }

    return DefWindowProcA(hwnd, uMsg, wParam, lParam);
}

// =======================================================
// Entry point
// =======================================================
int WinStart(long hInstance, long hPrevInstance, byte* pCmdLine, int nCmdShow)
{
    // Init FreeImage
    FreeImage_Initialise(0);

    // Load image
    int fif = FreeImage_GetFileType("image.jpg", 0);
    if (fif == ImageFormat.Unknown)
        fif = ImageFormat.Jpeg;

    void* dib = FreeImage_Load(fif, "image.jpg", 0);
    if (dib == null)
    {
        FreeImage_DeInitialise();
        return 0;
    }

    // Convert to 24-bit for display
    void* dib24 = FreeImage_ConvertTo24Bits(dib);
    FreeImage_Unload(dib);
    gBitmap = dib24;

    uint imgW = FreeImage_GetWidth(gBitmap);
    uint imgH = FreeImage_GetHeight(gBitmap);

    // Register window class
    WNDCLASSA wc = {};
    wc.lpfnWndProc   = WindowProc;
    wc.hInstance      = hInstance;
    wc.lpszClassName  = "FImageViewer";

    RegisterClassA(&wc);

    // Create window sized to image
    long hwnd = CreateWindowExA(
        0,
        "FImageViewer",
        "Using FreeImage library - FreeImage Copyright (c) 2003-2023 by the FreeImage Project",
        WS_OVERLAPPEDWINDOW,
        100, 100, imgW + 16, imgH + 39,
        0, 0, hInstance, null
    );

    if (hwnd == null)
    {
        FreeImage_Unload(gBitmap);
        FreeImage_DeInitialise();
        return 0;
    }

    ShowWindow(hwnd, nCmdShow);
    UpdateWindow(hwnd);

    // Message loop
    MSG msg = {};
    while (GetMessageA(&msg, null, 0, 0))
    {
        TranslateMessage(&msg);
        DispatchMessageA(&msg);
    }

    // Cleanup
    FreeImage_Unload(gBitmap);
    FreeImage_DeInitialise();
    return 0;
}
