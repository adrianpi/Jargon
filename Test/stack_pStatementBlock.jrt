class stack_pStatementBlock{
	array<StatementBlock*> items;

	// Lightweight generic stack used by codegen to track loops and nested
	// statement blocks.
	stack<StatementBlock*> constructor()
	{
		base();
		items = new array<StatementBlock*>();
		return this;
	}

	int get count() => items.count;

	void push(StatementBlock* item)
	{
		items.add(item);
	}

	void pop()
	{
		items.removeAt(items.count-1);
	}

	StatementBlock* peek()
	{
		return items.last();
	}

	array<StatementBlock*> toArray()
	{
		array<StatementBlock*> arr = new array<StatementBlock*>();
		for(int i = items.count-1; i >= 0; --i)
			arr.add(items[i]);
		return arr;
	}
}