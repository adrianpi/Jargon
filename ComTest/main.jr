using jargon;
using JargonCom;

///////////////////////////////////////////////////////////////
// This is a simple test of hosting the JScript engine via COM.
// It creates an instance of the engine, sets up a minimal 
// IActiveScriptSite implementation, and runs a simple script.
//
// It registers a named item "MyObject" which is a custom
// IDispatch object with a SayHello(name) method that can be
// called from JavaScript.
//
// It also instantiates and uses a MyComObject object from the 
// ComServer example.
///////////////////////////////////////////////////////////////

struct EXCEPINFO {
    ushort  wCode;
    ushort  wReserved;
    short*  bstrSource;
    short*  bstrDescription;
    short*  bstrHelpFile;
    uint    dwHelpContext;
    void*   pvReserved;
    void*   pfnDeferredFillIn;
    int     scode;
}

struct DECIMAL
{
    ushort  wReserved;
    byte    scale;
    byte    sign;
    uint    Hi32;
    ulong   Lo64;
}

union VARIANT_DATA {
    long            llVal;
    int             lVal;
    byte            bVal;
    short           iVal;
    float           fltVal;
    double          dblVal;
    bool            boolVal;
    short*          bstrVal;
    IUnknown*       punkVal;
    IDispatch*      pdispVal;
    byte*           pbVal;
    short*          piVal;
    int*            plVal;
    long*           pllVal;
    float*          pfltVal;
    double*         pdblVal;
    bool*           pboolVal;
    short**         pbstrVal;
    IUnknown**      ppunkVal;
    IDispatch**     ppdispVal;
    void*           byref;
    DECIMAL         decVal;
}

struct VARIANT {
    ushort vt;
    ushort wReserved1;
    ushort wReserved2;
    ushort wReserved3;
    VARIANT_DATA data;
}

struct DISPPARAMS {
    VARIANT*    rgvarg;
    int*        rgdispidNamedArgs;
    uint        cArgs;
    uint        cNamedArgs;
}

[ComInterface("00020400-0000-0000-C000-000000000046")]
class IDispatch : IUnknown
{
    virtual uint GetTypeInfoCount(uint *pctinfo);
    virtual uint GetTypeInfo(uint iTInfo, uint lcid, void **ppTInfo);
    virtual uint GetIDsOfNames(IID *riid, short **rgszNames, uint cNames, uint lcid, int *rgDispId);
    virtual uint Invoke(int dispIdMember, IID *riid, uint lcid, ushort wFlags, DISPPARAMS *pDispParams, VARIANT *pVarResult, EXCEPINFO *pExcepInfo, uint *puArgErr);
}

[ComInterface("BB1A2AE1-A4F9-11CF-8F20-00805F2CD064")]
class IActiveScript : IUnknown
{
    virtual uint SetScriptSite(void *pScriptSite);
    virtual uint GetScriptSite(IID *riid, void **ppvObject);
    virtual uint SetScriptState(uint ss);
    virtual uint GetScriptState(uint *pssState);
    virtual uint Close();
    virtual uint AddNamedItem(short *pstrName, uint dwFlags);
    virtual uint AddTypeLib(IID *rguidTypeLib, uint dwMajor, uint dwMinor, uint dwFlags);
    virtual uint GetScriptDispatch(short *pstrItemName, IDispatch **ppdisp);
    virtual uint GetCurrentScriptThreadID(uint *pstidThread);
    virtual uint GetScriptThreadID(uint dwWin32ThreadId, uint *pstidThread);
    virtual uint GetScriptThreadState(uint stidThread, uint *pstsState);
    virtual uint InterruptScriptThread(uint stidThread, EXCEPINFO *pexcepinfo, uint dwFlags);
    virtual uint Clone(void **ppscript);
}

[ComInterface("C7EF7658-E1EE-480E-97EA-D52CB4D76D17")]
class IActiveScriptParse : IUnknown
{
    virtual uint InitNew();
    virtual uint AddScriptlet(
        short *pstrDefaultName, short *pstrCode, short *pstrItemName,
        short *pstrSubItemName, short *pstrEventName, short *pstrDelimiter,
        ulong dwSourceContextCookie, uint ulStartingLineNumber,
        uint dwFlags, short **pbstrName, EXCEPINFO *pexcepinfo);
    virtual uint ParseScriptText(
        short *pstrCode, short *pstrItemName, void *punkContext,
        short *pstrDelimiter, ulong dwSourceContextCookie,
        uint ulStartingLineNumber, uint dwFlags,
        VARIANT *pvarResult, EXCEPINFO *pexcepinfo);
}

[ComInterface("EAE1BA61-A4ED-11CF-8F20-00805F2CD064")]
class IActiveScriptError : IUnknown
{
    virtual uint GetExceptionInfo(EXCEPINFO *pexcepinfo);
    virtual uint GetSourcePosition(uint *pdwSourceContext, uint *pulLineNumber, int *plCharacterPosition);
    virtual uint GetSourceLineText(short **pbstrSourceLine);
}

[ComInterface("DB01A1E3-A42B-11CF-8F20-00805F2CD064")]
class IActiveScriptSite : IUnknown
{
    virtual uint QueryLcid(uint *plcid);
    virtual uint GetItemInfo(short *pstrName, uint dwReturnMask, IUnknown **ppunkItem, void **ppti);
    virtual uint GetDocVersionString(short **pbstrVersion);
    virtual uint OnScriptTerminate(VARIANT *pvarResult, EXCEPINFO *pei);
    virtual uint OnStateChange(uint ssScriptState);
    virtual uint OnScriptError(IActiveScriptError pScriptError);
    virtual uint OnEnterScript();
    virtual uint OnLeaveScript();
}

uint VariantInit(VARIANT *pvarg) external;
void VariantClear(VARIANT *pvarg) external;
short* SysAllocString(short *psz) external;
void SysFreeString(short *psz) external;

const uint SCRIPTSTATE_UNINITIALIZED = 0;
const uint SCRIPTSTATE_INITIALIZED   = 5;
const uint SCRIPTSTATE_STARTED       = 1;
const uint SCRIPTSTATE_CONNECTED     = 2;
const uint SCRIPTSTATE_DISCONNECTED  = 3;
const uint SCRIPTSTATE_CLOSED        = 4;

const uint SCRIPTTEXT_ISEXPRESSION = 0x00000020;

const uint LOCALE_USER_DEFAULT = 0x0400;

const ushort VT_EMPTY    = 0;
const ushort VT_BSTR     = 8;
const ushort VT_DISPATCH = 9;
const ushort VT_UNKNOWN  = 13;

const ushort DISPATCH_METHOD      = 0x1;
const ushort DISPATCH_PROPERTYGET = 0x2;
const ushort DISPATCH_PROPERTYPUT = 0x4;

const uint SCRIPTITEM_ISVISIBLE      = 0x00000002; 

//////////////////////////////////////////////////////////

[ComClass("10D51383-4EBE-430C-A7E0-D37F82932BFE")]
class MyObject : IDispatch
{
    int refCount = 1;

    uint QueryInterface(IID* riid, void** ppvObject)
    {
        IID iidUnk = uuidof(IUnknown);
        IID iidDisp = uuidof(IDispatch);
        if(GuidsEqual(*riid, iidUnk) || GuidsEqual(*riid, iidDisp))
        {
            *ppvObject = this;
            ++refCount;
            return S_OK;
        }
        *ppvObject = null;
        return E_NOINTERFACE;
    }

    uint AddRef()
    {
        return ++refCount;
    }

    uint Release()
    {
        --refCount;
        int rc = refCount;
        if(refCount == 0)
            delete this;
        return rc;
    }

    uint GetTypeInfoCount(uint *pctinfo)
    {
        *pctinfo = 0;
        return S_OK;
    }

    uint GetTypeInfo(uint iTInfo, uint lcid, void **ppTInfo)
    {
        return E_NOTIMPL;
    }

    uint GetIDsOfNames(IID *riid, short **rgszNames, uint cNames, uint lcid, int *rgDispId)
    {
        wstring name = rgszNames[0];
        if(name == L"SayHello")
        {
            rgDispId[0] = 1;
            return S_OK;
        }
        rgDispId[0] = -1;
        return 0x80020006; // DISP_E_UNKNOWNNAME
    }

    uint Invoke(int dispIdMember, IID *riid, uint lcid, ushort wFlags, DISPPARAMS *pDispParams, VARIANT *pVarResult, EXCEPINFO *pExcepInfo, uint *puArgErr)
    {
        if(dispIdMember == 1) // SayHello
        {
            wstring greeting;

            if(pDispParams.cArgs >= 1 && pDispParams.rgvarg[0].vt == VT_BSTR)
            {
                short* name = pDispParams.rgvarg[0].data.bstrVal;
                greeting = wstring.format(L"Hello %ls, greetings from MyObject!", name);
            }
            else
            {
                greeting = L"Hello from MyObject!";
            }

            if(pVarResult != null)
            {                
                pVarResult.vt = VT_BSTR;
                pVarResult.data.bstrVal = SysAllocString(greeting.c_str());
            }

            return S_OK;
        }

        return 0x80020003; // DISP_E_MEMBERNOTFOUND
    }
}

[ComClass("FE489AA2-744E-4466-8147-9CFBED576585")]
class MySite : IActiveScriptSite
{
    int refCount = 1;
    MyObject myObject;

    MySite constructor()
    {
        myObject = new MyObject();
        return this;
    }

    void destructor()
    {
        myObject.Release();
    }

    uint QueryInterface(IID* riid, void** ppvObject)
    {
        IID iidUnk = uuidof(IUnknown);
        IID iidSite = uuidof(IActiveScriptSite);
        if(GuidsEqual(*riid, iidUnk) || GuidsEqual(*riid, iidSite))
        {
            *ppvObject = this;
            ++refCount;
            return S_OK;
        }
        *ppvObject = null;
        return E_NOINTERFACE;
    }

    uint AddRef()
    {
        return ++refCount;
    }

    uint Release()
    {
        --refCount;
        int rc = refCount;
        if(refCount == 0)
            delete this;
        return rc;
    }

    uint QueryLcid(uint *plcid)
    {
        *plcid = LOCALE_USER_DEFAULT;
        return S_OK;
    }

    uint GetItemInfo(short *pstrName, uint dwReturnMask, IUnknown **ppunkItem, void **ppti)
    {
        if((dwReturnMask & 1) != 0 && ppunkItem != null)
        {
            if(new wstring(pstrName) == new wstring(L"MyObject"))
            {
                *ppunkItem = myObject;
                myObject.AddRef();
                if(ppti != null) 
                    *ppti = null;
                return S_OK;
            }
        }

        if(ppunkItem != null) *ppunkItem = null;
        if(ppti != null) *ppti = null;
        return E_INVALIDARG;
    }

    uint GetDocVersionString(short **pbstrVersion)
    {
        *pbstrVersion = SysAllocString(L"1.0");
        return S_OK;
    }

    uint OnScriptTerminate(VARIANT *pvarResult, EXCEPINFO *pei)
    {
        return S_OK;
    }

    uint OnStateChange(uint ssScriptState)
    {
        return S_OK;
    }

    uint OnScriptError(IActiveScriptError error)
    {
        EXCEPINFO info = {};

        uint context;
        uint line;
        int column;
        short* sourceLine = null;

        error.GetExceptionInfo(&info);
        error.GetSourcePosition(
            &context,
            &line,
            &column);
        error.GetSourceLineText(
            &sourceLine);

        wprintln(
            L"Error %lu:%ld: %s",
            line + 1,
            column + 1,
            info.bstrDescription);

        wprintln(
            L"Source: %s",
            sourceLine);

        SysFreeString(sourceLine);
        SysFreeString(info.bstrDescription);
        SysFreeString(info.bstrSource);
        SysFreeString(info.bstrHelpFile);

        return S_OK;
    }

    uint OnEnterScript()
    {
        return S_OK;
    }

    uint OnLeaveScript()
    {
        return S_OK;
    }
}

// From ComServer example project
[ComInterface("A96BAFB4-5CDE-4560-A2EC-1B724984C621")]
class IMyComObject : IUnknown
{
    virtual void Foo();
}

int MessageBoxA(long hWnd, byte *lpText, byte *lpCaption, uint uType) external;

// ============================================================
// Main
// ============================================================

int start(int argc, byte **argv)
{
    uint hr = COM.Initialize();
    assertMsg(hr == S_OK, "COM.Initialize failed");

    IID iidJScript = GuidFromString("F414C260-6AC0-11CF-B6D1-00AA00BBBB58");
    IID iidActiveScript = uuidof(IActiveScript);
    IID iidActiveScriptParse = uuidof(IActiveScriptParse);

    IActiveScript activeScript;
    hr = COM.CreateInstance(&iidJScript, null, 1, &iidActiveScript, (void**)&activeScript);
    assertMsg(hr == S_OK, "Failed to create JScript COM object");

    IActiveScriptParse parser;
    hr = activeScript.QueryInterface(&iidActiveScriptParse, (void**)&parser);
    assertMsg(hr == S_OK, "Failed to get IActiveScriptParse interface");

    hr = parser.InitNew();
    assertMsg(hr == S_OK, "Failed to initialize script parser");

    MySite mySite = new MySite();

    hr = activeScript.SetScriptSite(mySite);
    assertMsg(hr == S_OK, "Failed to set script site");
    
    hr = activeScript.AddNamedItem(L"MyObject", SCRIPTITEM_ISVISIBLE);
    assertMsg(hr == S_OK, "Failed to add named item");

    hr = activeScript.SetScriptState(SCRIPTSTATE_STARTED);
    assertMsg(hr == S_OK, "Failed to set script state");

    wstring jscriptCode = L"MyObject.SayHello('JavaScript')";

    VARIANT result;
    VariantInit(&result);
    EXCEPINFO excep = {};

    hr = parser.ParseScriptText(
        jscriptCode.c_str(), // code
        null,               // item name
        null,               // context
        null,               // delimiter
        0,                  // source context cookie
        0,                  // starting line
        SCRIPTTEXT_ISEXPRESSION,
        &result,
        &excep
    );
    assertMsg(hr == S_OK, "Failed to parse script text");

    string strResult = string.format("Result: %ls", result.data.bstrVal);
    MessageBoxA(0, strResult.c_str(), "Javascript Result", 0);

    VariantClear(&result);

    hr = activeScript.SetScriptState(SCRIPTSTATE_CLOSED);
    assertMsg(hr == S_OK, "Failed to close script");
    parser.Release();
    activeScript.Release();
    mySite.Release();

    IMyComObject comObj;
    IID iidObj = GuidFromString("EF30D8D6-99C5-408B-B202-9BF19AB77667");
    IID iidIObj = uuidof(IMyComObject);
    hr = COM.CreateInstance(&iidObj, null, 1, &iidIObj, (void**)&comObj);    

    if(hr == S_OK && comObj != null)
    {
        comObj.Foo();

        comObj.Release();
    }
    else
    {
        MessageBoxA(0, "Failed to create MyComObject.\r\nMake sure ComServer project is compiled and is properly setup in the registry.", "Error", 0);
    }

    COM.Uninitialize();
    return 0;
}

