void print(string *fmt, ...)
{
	void *ap;
	va_start(ap);
	vprintf(fmt.c_str(), ap);
	va_end(ap);
}

void println(string *fmt, ...)
{
	void *ap;
	va_start(ap);
	vprintf(fmt.c_str(), ap);
	va_end(ap);
	printf("\n");
}

void Log(string fmt, ...)
{
	byte buffer[4096];
	void *ap;
	va_start(ap);
	__stdio_common_vsprintf(null, buffer, 4096, fmt.c_str(), null, ap);
	va_end(ap);
	OutputDebugStringA(buffer);
	OutputDebugStringA("\n");
}

void assert(bool condition)
{
	if(!condition)
	{
		Log("Assertion failed.");
		debugBreak();
	}
}

void assertMsg(bool condition, string msg)
{
	if(!condition)
	{
		Log("Assertion failed: %s", msg);
		debugBreak();
	}
}

int objectInstances = 0;
bool collectInstances = false;

struct obj_instance
{
	void *obj;
	obj_instance* next;
}

obj_instance *obj_instances = null;

void _collect(object *obj)
{
	if(collectInstances)
	{
		obj_instance *inst = malloc(sizeof(obj_instance));
		inst.obj = obj;
		inst.next = obj_instances;
		obj_instances = inst;
	}
}

void _release(object *obj)
{
	if(collectInstances)
	{
		obj_instance *prev = null;
		obj_instance *inst = obj_instances;
		while(inst) {
			if(inst.obj == obj)
			{
				prev ? prev.next : obj_instances = inst.next;				
				free(inst);
				return;
			}
			prev = inst;
			inst = inst.next;
		}
	}
}

class object
{
	int refCount;

	object* constructor()
	{
		++objectInstances;
		_collect(this);
		return this;
	}

	virtual void destructor()
	{
		//printf("Destroying object %s %x\n", getClassName(), this);
		_release(this);
		--objectInstances;
	}

	virtual void finalize()
	{
		//printf("Finalizing object %s %x\n", getClassName(), this);
	}

	void addRef()
	{
		if(this != null)
		{
			int *p = &refCount;
			_atomicInc(p);
		}
	}

	void release()
	{
		if(this != null)
		{
			int *p = &refCount;
			int oldVal;
			int *r = &oldVal;
			_atomicSub(p, r);
			if(oldVal == 1)
				delete this;
		}
	}

	virtual byte* getClassName() { return "object"; }

	virtual long getHash() { return ((long) this) & 0x7fffffff; }

	virtual string* toString() => new string(getClassName());

	RTTIClassType getClassType()
	{
		return RTTIType.GetType(getClassName());
	}
}

object* newObj(int sz, void **vtab)
{
	void *mem = malloc(sz);
	memset(mem, 0, sz);
	object *obj = (object*)mem;
	obj.vtable = vtab;
	return obj;
}

void _checkLeaks()
{
	if(objectInstances == 0)
		Log("No leaks detected!");
	else {
		Log("Detected %d object leaks", objectInstances);
		if(collectInstances)
		{
			obj_instance *inst = obj_instances;
			while(inst) {
				Log("%s %p [%d], %s", ((object*)inst.obj).getClassName(), inst.obj, ((object*)inst.obj).refCount, ((object*)inst.obj).toString());
				inst = inst.next;
			}
		}
	}
}

int _getObjectInstances() => objectInstances;

//-----------------------------------------------------------------------------

void _free(void *ptr)
{
	free(ptr);
}

class memory
{
	static void* alloc(long size)
	{
		return malloc(size);
	}

	static void free(void *ptr)
	{
		_free(ptr);
	}

	static void put(void *ptr, int value, long size)
	{
		memset(ptr, value, size);
	}

	static void copy(void *dst, void *src, long size)
	{
		memcpy(dst, src, size);
	}

	static void move(void *dst, void *src, long size)
	{
		memmove(dst, src, size);
	}
}

//-----------------------------------------------------------------------------

class string
{
	byte *str;
	
	string *constructor(byte *pValue)
	{
		base();
		str = (byte*) memory.alloc(strlen(pValue)+1);
		strcpy(str, pValue);
		return this;
	}
	
	void destructor()
	{
		base();
		memory.free(str);
	}

	long getHash()
	{
		byte *ptr = str;
		// two random prime numbers
		ulong hash = 3253;
        int c = 0;
        while ((c = *ptr++))
			hash += (ulong)c * 83UL;
		hash = hash & 0x7fffffff; // keep positive
        return (long)hash;
	}

	string* toString() 
	{
		return this;
	}
	
	byte * c_str()
	{
		if(this == null)
			return null;
		return str;
	}
	
	int get length()
	{
		return strlen(str);
	}
	
	byte get_item(int index)
	{
		return str[index];
	}

	string* substr(int start, int len)
	{
		if(length == 0)
			return new string("");
		start = 0 >? start <? length;
		len = len <? (length-start);
		byte *temp = memory.alloc(len+1);
		memset(temp, 0, len+1);
		strncpy(temp, str + start, len);
		string *result = new string(temp);
		memory.free(temp);
		return result;
	}

	string* toLower()
	{
		byte *temp = memory.alloc(length+1);
		byte *src = str;
		byte *dst = temp;
		while(*src) 
		{
			byte c = *src++;
			if(c >= 'A' && c <= 'Z')
				c = c + ('a' - 'A');
			*dst++ = c;
		}
		*dst = 0;
		string *result = new string(temp);
		memory.free(temp);
		return result;
	}

	string* toUpper()
	{
		byte *temp = memory.alloc(length+1);
		byte *src = str;
		byte *dst = temp;
		while(*src) 
		{
			byte c = *src++;
			if(c >= 'a' && c <= 'z')
				c = c - ('a' - 'A');
			*dst++ = c;
		}
		*dst = 0;
		string *result = new string(temp);
		memory.free(temp);
		return result;
	}

	int indexOf(string *other)
	{
		byte *pos = strstr(str, other.str);
		if(pos == null)
			return -1;
		else
			return pos - str;
	}

	int indexOfChar(byte c)
	{
		byte *pos = strchr(str, c);
		if(pos == null)
			return -1;
		else
			return pos - str;
	}

	int lastIndexOfChar(byte c)
	{
		for(int i = length - 1; i >= 0; --i)
		{
			if(str[i] == c)
				return i;
		}
		return -1;
	}

	bool contains(string *other)
	{
		return indexOf(other) != -1;
	}

	bool startsWith(string *other)
	{
		return indexOf(other) == 0;
	}

	bool endsWith(string *other)
	{
		if(other.length > length)
			return false;
		return strcmp(str + length - other.length, other.str) == 0;
	}

	string* reverse()
	{
		byte *temp = memory.alloc(length+1);
		strcpy(temp, str);
		for(int i = 0; i < length >> 1; i++) {
			byte c = temp[i];
			temp[i] = temp[length-i-1];
			temp[length-i-1] = c;
		}
		string *result = new string(temp);
		memory.free(temp);
		return result;
	}

	string* ltrim()
	{
		if(length == 0)
			return new string("");

		int pos = 0;
		while((this[pos] == ' ' || this[pos] == '\t' || this[pos] == '\r' || this[pos] == '\n') && pos < length)
		{
			pos++;
		}
		
		return substr(pos, length-pos);
	}

	string* rtrim()
	{
		if(length == 0)
			return new string("");

		int pos = length;
		while((this[pos-1] == ' ' || this[pos-1] == '\t' || this[pos-1] == '\r' || this[pos-1] == '\n') && pos > 0)
		{
			pos--;
		}

		return substr(0, pos);
	}

	string* trim()
	{
		return ltrim().rtrim();
	}

	static string* format(string *fmt, ...)
	{
		byte buffer[4096];
		void *ap;
		va_start(ap);
		__stdio_common_vsprintf(null, buffer, 4096, fmt.c_str(), null, ap);
		va_end(ap);
		return new string(buffer);
	}

    string replace(string find, string repl)
    {
        string temp = this;
        int idx = temp.indexOf(find);
        while(idx != -1)
        {
            temp = temp.substr(0, idx) + repl + temp.substr(idx + find.length, temp.length - (idx + find.length));
            idx = temp.indexOf(find);
        }
        return temp;
    }
}

string* operator+(string *a, string *b)
{
	byte *mem = (byte*)memory.alloc(a.length+b.length+1);
	strcpy(mem, a.c_str());
	strcat(mem, b.c_str());
	string *result = new string(mem);
	memory.free(mem);
	return result;
}

string* operator+(string *a, byte b)
{
	byte *mem = (byte*)memory.alloc(a.length+2);
	strcpy(mem, a.c_str());
	mem[a.length] = b;
	mem[a.length+1] = 0;
	string *result = new string(mem);
	memory.free(mem);
	return result;
}

string* operator+(byte a, string *b)
{
	byte *mem = (byte*)memory.alloc(b.length+2);
	mem[0] = a;
	strcpy(mem+1, b.c_str());
	string *result = new string(mem);
	memory.free(mem);
	return result;
}

bool operator==(string *a, string *b)
{
	return strcmp(a.str, b.str) == 0;
}

bool operator!=(string *a, string *b)
{
	return strcmp(a.str, b.str) != 0;
}

bool operator<(string *a, string *b)
{
	return strcmp(a.str, b.str) < 0;
}

bool operator>(string *a, string *b)
{
	return strcmp(a.str, b.str) > 0;
}

bool operator<=(string *a, string *b)
{
	return strcmp(a.str, b.str) <= 0;
}

bool operator>=(string *a, string *b)
{
	return strcmp(a.str, b.str) >= 0;
}

bool operator!(string *a)
{
	if(a == null || strcmp(a.str, "") == 0)
		return true;
	else	
		return false;
}

