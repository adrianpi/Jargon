		return this;
	}
}

class RTTIEnumValue : RTTISymbol
{
	long value;

	RTTIEnumType get ParentEnum() => _dynamicCast(this.parent, "RTTIEnumType");

	RTTIEnumValue constructor(string name, SymbolFlags flags, long value)
	{
		base(SymbolType.EnumValue, flags, name);
		this.value = value;
		return this;
	}
}

class RTTIEnumType : RTTIType
{
	RTTIType enumType;

	bool IsEnum() => true;

	RTTIEnumType constructor(string name, RTTIType etype, SymbolFlags flags)
	{
		base(SymbolType.Enum, flags, name);
		this.enumType = etype;
		return this;
	}

	RTTIEnumValue GetValue(string name)
	{
		return _dynamicCast(Find(name), "RTTIEnumValue");
	}

	array<string> EnumValues()
	{
		return EnumChildren("RTTIEnumValue");
	}

	long Parse(string value)
	{
		for(int i = 0; i < children.count; ++i)
		{
			RTTISymbol child = children[i];
			if(child.name == value)
			{
				RTTIEnumValue ev = _dynamicCast(child, "RTTIEnumValue");
				if(ev)
					return ev.value;
			}
		}
		return 0;
	}

	string Stringify(long value)
	{
		for(int i = 0; i < children.count; ++i)
		{
			RTTISymbol child = children[i];
			RTTIEnumValue ev = _dynamicCast(child, "RTTIEnumValue");
			if(ev && ev.value == value)
				return ev.name;
		}
		return string.format("%lld", value);
	}
}

