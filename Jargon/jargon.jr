
// Jargon.jr

// This file contains the core library for the Jargon language,
// including object base class, string manipulation, collections, 
// and file handling.

void* malloc(int size) external;
void free(void *ptr) external;
void memset(void* ptr, int val, int size) external;
void memcpy(void* dst, void *src, int size) external;
void memmove(void* dst, void *src, int size) external;
int printf(byte* fmt, ...) external;
int strlen(byte *str) external;
int strcmp(byte *a, byte *b) external;
byte* strcpy(byte *dst, byte *src) external;
byte* strcat(byte *dst, byte *src) external;
byte* strncpy(byte *dst, byte *src, long len) external;
byte* strstr(byte *where, byte *what) external;
byte* strchr(byte *src, byte c) external;
void* fopen(byte *fileName, byte *mode) external;
void fclose(void *fptr) external;
long ftell(void *fptr) external;
void fseek(void *fptr, long offset, int whence) external;
long fread(void *buffer, long size, long count, void *fptr) external;
long fwrite(void *buffer, long size, long count, void *fptr) external;
int rename(byte *oldFileName, byte *newFileName) external;
int remove(byte *fileName) external;
byte* _getcwd(byte *buffer, int maxLen) external;
int _mkdir(byte *dir) external;
int _rmdir(byte *dir) external;
int _access(byte *dir, int mode) external;

struct _finddata_t
{
    uint    attrib;
    long    time_create;
    long    time_access;
    long    time_write;
    uint    size;
    byte    name[260];
}

const int _A_SUBDIR = 0x10;

long _findfirst64i32(byte *path, _finddata_t *file) external;
int _findnext64i32(long handle,  _finddata_t *file) external;
void _findclose(long handle) external;

void OutputDebugStringA(byte *str) external;

void __stdio_common_vsprintf(void *options, byte *buffer, long bufferCount, byte *fmt, void *locale, void *ap) external;
int vprintf(byte *fmt, void *ap) external;

void va_start(void *ap) verbatim "call void @llvm.va_start.p0(ptr #ap)";
void va_end(void *ap) verbatim "call void @llvm.va_end.p0(ptr #ap)";
long va_arg_long(void *ap) verbatim "va_arg ptr #ap, i64";
double va_arg_double(void *ap) verbatim "va_arg ptr #ap, f64";
void* va_arg_ptr(void *ap) verbatim "va_arg ptr #ap, ptr";
void debugBreak() verbatim "call void @llvm.debugtrap()";
void _atomicInc(int *p) verbatim "%$ai1 = load ptr, ptr #p\n\t%$ai2 = atomicrmw add ptr %$ai1, i32 1 seq_cst";
void _atomicSub(int *p, int *r) verbatim "%$as1 = load ptr, ptr #p\n\t%$as2 = atomicrmw sub ptr %$as1, i32 1 seq_cst\n\t%$as3 = load ptr, ptr #r\n\tstore i32 %$as2, ptr %$as3";

