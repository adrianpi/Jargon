enum SymbolType
{
    None = 0,
    Primitive = 1,
    LocalVar,
    GlobalVar,
    Function,
    Module,
    Root,
    Array,
    Pointer,
    Field,
    Struct,
    BlockScope,
    Class,
    Method,
    Property,
    Enum,
    EnumValue,
	Template,
	Constant,
}

enum TypeCode
{
    None = 0,
    Void = 1,
    Bool,
    Byte,
    UByte,
    Short,
    UShort,
    Int,
    UInt,
    Long,
    ULong,
    Float,
    Double,
    Function,
    Array,
    Pointer,
    Struct,
    CStr,
}

byte *__bptr = null;

void __initBinaryRead(byte* ptr)
{
	__bptr = ptr;
}

byte __readByte()
{
	byte value = *__bptr;
	__bptr++;
	return value;
}

short __readShort()
{
	short value = *(short*)__bptr;
	__bptr+=2;
	return value;
}

int __readInt()
{
	int value = *(int*)__bptr;
	__bptr+=4;
	return value;
}

long __readLong()
{
	long value = *(long*)__bptr;
	__bptr+=8;
	return value;
}

long __readString(byte *buffer)
{
	byte *dst = buffer;
	while(*__bptr)
	{
		*dst++ = *__bptr++;
	}
	*dst = 0;
	__bptr++;
}

float __readFloat()
{
	float value = *(float*)__bptr;
	__bptr+=4;
	return value;
}

double __readDouble()
{
	double value = *(double*)__bptr;
	__bptr+=8;
	return value;
}

int ReadType()
{
	int tc = __readByte();
	if(tc == TypeCode.Pointer)
	{
		tc = 0x1000 + ReadType();
	}
	else if(tc == TypeCode.Array)
	{
		int sz = __readInt();
		tc = 0x10000 + ReadType();
	}
	else if(tc == TypeCode.Struct)
	{
		byte name[256];
		__readString(name);
	}
	return tc;
}

struct ClassInfo
{
	byte name[256];
	ClassInfo *baseClass;
	ClassInfo *next;
}

ClassInfo* _classes = null;

void _addClassInfo(ClassInfo *info)
{
	info.next = _classes;
	_classes = info;
}

ClassInfo *_getClassInfo(byte *name)
{
	ClassInfo *ci = _classes;
	while(ci != null) {
		if(!strcmp(&ci.name[0], name))
			return ci;
		ci = ci.next;
	}
	return null;
}

bool _isClassOf(object *obj, byte *clsName)
{
	if(obj == null)
		return false;

	ClassInfo *ci = _getClassInfo(obj.getClassName());
	while(ci) {
		if(!strcmp(&ci.name[0], clsName))
			return true;
		ci = ci.baseClass;
	}
	return false;
}

object* _dynamicCast(object *obj, byte *clsName)
{
	if(obj == null)
		return null;

	ClassInfo *ci = _getClassInfo(obj.getClassName());
	while(ci) {
		if(!strcmp(&ci.name[0], clsName))
			return obj;
		ci = ci.baseClass;
	}
	return null;
}

bool _readTypeLog = false;

void _setReadTypeLog(bool value)
{
	_readTypeLog = value;
}

bool _readTypeInfo(byte *address)
{
	byte *ptr = address;
	short dosHeader = *(short*)ptr;
	ptr += 2;
	if(dosHeader != 0x5A4D) {
		printf("Not a DOS header");
		return false;
	}
	if(_readTypeLog) printf("DOS Header OK\n");

	ptr = address + 0x3c;
	int ntOffset = *(int*)ptr;
	
	ptr = address + ntOffset;	
	int peHeader = *(int*)ptr;
	ptr += 4;
	
	if(peHeader != 0x00004550) {
		printf("Not a PE header");
		return false;
	}
	if(_readTypeLog) printf("NT Header OK\n");
	
	ptr += 2; // machine
	ushort numSections = *(ushort*)ptr;
	ptr += 2;
	ptr += 4; // TimeDateStamp
	ptr += 4; // PointerToSymbolTable
	ptr += 4; // NumberOfSymbols
	ushort sizeOfOptionalHeader = *(ushort*)ptr;
	ptr += 2;
	ptr += 2; // Characteristics
	
	ptr += sizeOfOptionalHeader;

	if(_readTypeLog) printf("NumSections: %d\n", (int)numSections);
	
	for(int i = 0; i < numSections; ++i) 
	{
		byte secName[9];
		for(int j = 0; j < 8; j++) 
			secName[j] = *ptr++;
		secName[8] = 0;
		
		uint virtualSize = *(uint*)ptr;
		ptr += 4;
		uint virtualAddress = *(uint*)ptr;
		ptr += 4;
		uint sizeOfRawData = *(uint*)ptr;
		ptr += 4;
		uint pointerToRawData = *(uint*)ptr;
		ptr += 4;
		
		ptr += 16;
	
		if(!strcmp(secName, ".module")) {
			if(_readTypeLog) printf("Module data:\n");
			if(_readTypeLog) printf("\tVirtual Size: %x\n", virtualSize);
			if(_readTypeLog) printf("\tVirtual Address: %x\n", virtualAddress);
			if(_readTypeLog) printf("\tRaw Data Size: %x\n", sizeOfRawData);
			if(_readTypeLog) printf("\tRaw Data Pointer: %x\n", pointerToRawData);
			
			ptr = address + virtualAddress;
			
			__initBinaryRead(ptr);

			SymbolType st = __readByte();
			if(st != SymbolType.Module) {
				printf("Bad data\n");
				return false;
			}
			if(_readTypeLog) printf("\tData Present\n");
			uint version = __readInt();
			if(version != 0x01000000) {
				printf("Bad version");
				return false;
			}
			if(_readTypeLog) printf("\tVersion OK\n");
			byte name[256];
			__readString(name);
			if(_readTypeLog) printf("\tModule Name: %s\n", (byte*)name);

			// usings
			__readString(name);
			while(strcmp(name, "")) {
				__readString(name);
			}
			
			int flags = 0;
			st = __readByte();

			while(st != SymbolType.None)
			{
				if(st == SymbolType.Constant)
				{
					flags = __readShort();
					int t = ReadType();
					__readString(name);
					if(_readTypeLog) printf("constant %s\n", (byte*)name);
					if(t == TypeCode.Bool || t == TypeCode.Byte || t == TypeCode.UByte) {
						byte value = __readByte();
						if(_readTypeLog) printf("\tvalue %d\n", value);
					}
					if(t == TypeCode.Short || t == TypeCode.UShort) {
						int value = __readShort();
						if(_readTypeLog) printf("\tvalue %d\n", value);
					}
					if(t == TypeCode.Int || t == TypeCode.UInt) {
						int value = __readInt();
						if(_readTypeLog) printf("\tvalue %d\n", value);
					}
					if(t == TypeCode.Long || t == TypeCode.ULong) {
						long value = __readInt();
						if(_readTypeLog) printf("\tvalue %lld\n", value);
					}
					else if(t == TypeCode.Float) {
						float value = __readFloat();
						if(_readTypeLog) printf("\tvalue %f\n", value);
					}
					else if(t == TypeCode.Double) {
						double value = __readDouble();
						if(_readTypeLog) printf("\tvalue %f\n", value);
					}
				}
				else if(st == SymbolType.Enum)
				{
					flags = __readShort();
					int et = ReadType();
					__readString(name);
					if(_readTypeLog) printf("enum %s\n", (byte*)name);
					int st2 = __readByte();
					while(st2 != 0) 
					{
						flags = __readShort();
						__readString(name);
						long value = __readLong();
						if(_readTypeLog) printf("\tvalue %s=%d\n", (byte*)name, value);
						st2 = __readByte();
					}
				}
				else if(st == SymbolType.Function)
				{
					flags = __readShort();
					int t = ReadType();
					__readString(name);
					if(_readTypeLog) printf("function %s\n", (byte*)name);
					__readString(name); // verbatim
					int st2 = __readByte();
					while(st2 != 0)
					{
						flags = __readShort();
						int pt = ReadType();
						__readString(name);
						int offs = __readByte();
						if(_readTypeLog) printf("\targ %d %s\n", offs, (byte*)name);
						st2 = __readByte();
					}
				}
				else if(st == SymbolType.Struct)
				{
					flags = __readShort();
					__readString(name);
					int sz = __readShort();
					if(_readTypeLog) printf("struct %s\n", (byte*)name);
					int st2 = __readByte();
					while(st2 != 0)
					{
						flags = __readShort();
						int ft = ReadType();
						__readString(name);
						int offs = __readShort();
						int idx = __readShort();
						if(_readTypeLog) printf("\tfield %s\n", (byte*)name);
						st2 = __readByte();
					}
				}
				else if(st == SymbolType.Class)
				{
					flags = __readShort();
					__readString(name);
					byte baseName[256];
					strcpy(baseName, "");
					int ctype = __readByte();
					if(ctype == TypeCode.Struct)
					{
						__readString(baseName);
					}
					int sz = __readShort();
					int fcnt = __readShort();
					if(_readTypeLog) printf("class %s : %s\n", (byte*)name, (byte*)baseName);
					
					ClassInfo *ci = malloc(sizeof(ClassInfo));
					strcpy(&ci.name[0], name);
					ci.baseClass = null;
					if(strcmp(baseName, "")) {
						ci.baseClass = _getClassInfo(baseName);
					}
					_addClassInfo(ci);
					
					int st2 = __readByte();
					while(st2 != 0)
					{
						if(st2 == SymbolType.Constant)
						{
							flags = __readShort();
							int t = ReadType();
							__readString(name);
							if(_readTypeLog) printf("constant %s\n", (byte*)name);
							if(t == TypeCode.Bool || t == TypeCode.Byte || t == TypeCode.UByte) {
								byte value = __readByte();
								if(_readTypeLog) printf("\tvalue %d\n", value);
							}
							if(t == TypeCode.Short || t == TypeCode.UShort) {
								int value = __readShort();
								if(_readTypeLog) printf("\tvalue %d\n", value);
							}
							if(t == TypeCode.Int || t == TypeCode.UInt) {
								int value = __readInt();
								if(_readTypeLog) printf("\tvalue %d\n", value);
							}
							if(t == TypeCode.Long || t == TypeCode.ULong) {
								long value = __readInt();
								if(_readTypeLog) printf("\tvalue %lld\n", value);
							}
							else if(t == TypeCode.Float) {
								float value = __readFloat();
								if(_readTypeLog) printf("\tvalue %f\n", value);
							}
							else if(t == TypeCode.Double) {
								double value = __readDouble();
								if(_readTypeLog) printf("\tvalue %f\n", value);
							}
						}
						else if(st2 == SymbolType.Field)
						{
							flags = __readShort();
							int ft = ReadType();
							__readString(name);
							int offs = __readShort();
							int idx = __readShort();
							if(_readTypeLog) printf("\tfield %s\n", (byte*)name);						
						}
						else if(st2 == SymbolType.Method) 
						{
							flags = __readShort();
							__readString(name);
							byte fname[256];
							__readString(fname);
							int vslot = __readShort();
							if(_readTypeLog) printf("\tmethod %s -> %s [%d]\n", (byte*)name, (byte*)fname, vslot);
						}
						else if(st2 == SymbolType.Property) 
						{
							flags = __readShort();
							int pt = ReadType();
							__readString(name);
							__readByte();
						}
						st2 = __readByte();
					}
					__readString(name);
					while(strcmp(name, "")) {
						__readString(name);
					}
				}
				else if(st == SymbolType.Template)
				{
					flags = __readShort();
					__readString(name);
					__readString(name);
					while(strcmp(name, ""))
						__readString(name);
					byte ch = __readByte();
					while(ch != 0)
						ch = __readByte();
				}
				st = __readByte();
			}
			
			return true;
		}		
	}
	
	return false;
}

int DllMain(long hModule, int dwReason, void *pReserved)
{
	if(dwReason == 1)
	{
		_readTypeInfo((byte*)hModule);
	}
	return 1;
}
