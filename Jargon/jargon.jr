class RTTIProperty : RTTISymbol
{
	RTTIType propertyType;
	RTTIMethod getter;
	RTTIMethod setter;
	weak RTTIClassType Class;
	string getterName;
	string setterName;

	RTTIClassType get ParentClass() => _dynamicCast(this.parent, "RTTIClassType");

	RTTIProperty constructor(string name, SymbolFlags flags, RTTIType ptype)
	{
		base(SymbolType.Property, flags, name);
		this.propertyType = ptype;
		return this;
	}

	void SetBoolValue(object obj, bool value)
	{
		if(propertyType != RTTIType.Bool)
			return;
		RTTIFunction fSet = setter.function;
		if((flags & SymbolFlags.Static) != 0)
		{
			void (*pfSet)(bool value) = fSet.address;
			(*pfSet)(value);
		}
		else
		{
			void (*pfSet)(object* _this, bool value) = fSet.address;
			(*pfSet)(obj, value);
		}
	}

	bool GetBoolValue(object obj)
	{
		if(propertyType != RTTIType.Bool)
			return false;
		RTTIFunction fGet = getter.function;
		if((flags & SymbolFlags.Static) != 0)
		{
			bool (*pfGet)() = fGet.address;
			return (*pfGet)();
		}
		else
		{
			bool (*pfGet)(object* _this) = fGet.address;
			return (*pfGet)(obj);
		}
	}

	void SetByteValue(object obj, byte value)
	{
		RTTIType propType = propertyType;
		if(propertyType.IsEnum())
			propType = ((RTTIEnumType)propertyType).enumType;
		if(propType != RTTIType.Byte && propType != RTTIType.UByte)
			return;
		RTTIFunction fSet = setter.function;
		if((flags & SymbolFlags.Static) != 0)
		{
			void (*pfSet)(byte value) = fSet.address;
			(*pfSet)(value);
		}
		else
		{
			void (*pfSet)(object* _this, byte value) = fSet.address;
			(*pfSet)(obj, value);
		}
	}

	byte GetByteValue(object obj)
	{
		RTTIType propType = propertyType;
		if(propertyType.IsEnum())
			propType = ((RTTIEnumType)propertyType).enumType;
		if(propType != RTTIType.Byte && propType != RTTIType.UByte)
			return 0;
		RTTIFunction fGet = getter.function;
		if((flags & SymbolFlags.Static) != 0)
		{
			byte (*pfGet)() = fGet.address;
			return (*pfGet)();
		}
		else
		{
			byte (*pfGet)(object* _this) = fGet.address;
			return (*pfGet)(obj);
		}
	}

