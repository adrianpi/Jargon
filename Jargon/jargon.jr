enum SymbolType
{
    None = 0,
    Primitive = 1,
    LocalVar,
    GlobalVar,
    Function,
    Module,
    Root,
    Array,
    Pointer,
    Field,
    Struct,
    BlockScope,
    Class,
    Method,
    Property,
    Enum,
    EnumValue,
	Template,
	Constant,
}

enum TypeCode
{
    None = 0,
    Void = 1,
    Bool,
    Byte,
    UByte,
    Short,
    UShort,
    Int,
    UInt,
    Long,
    ULong,
    Float,
    Double,
    Function,
    Array,
    Pointer,
    Struct,
    CStr,
	Enum,	// Used only during serialization
}

enum SymbolFlags
{
	None = 0x00,
    Variadic = 0x01,
    External = 0x02,
    Internal = 0x04,
    Virtual = 0x08,
    NoDebug = 0x10,
    Static = 0x20,
    ByRef = 0x40,
    Weak = 0x80,
    Verbatim = 0x100,
    Union = 0x200,
    Protected = 0x400,
    Private = 0x800,
	HasAttributes = 0x1000,
    VisibilityMask = 0xc04, // (Internal|Private|Protected)
}

byte *__bptr = null;

void __initBinaryRead(byte* ptr)
{
	__bptr = ptr;
}

byte __readByte()
{
	byte value = *__bptr;
	__bptr++;
	return value;
}

short __readShort()
{
	short value = *(short*)__bptr;
	__bptr+=2;
	return value;
}

int __readInt()
{
	int value = *(int*)__bptr;
	__bptr+=4;
	return value;
}

long __readLong()
{
	long value = *(long*)__bptr;
	__bptr+=8;
	return value;
}

long __readString(byte *buffer)
{
	byte *dst = buffer;
	while(*__bptr)
	{
		*dst++ = *__bptr++;
	}
	*dst = 0;
	__bptr++;
}

float __readFloat()
{
	float value = *(float*)__bptr;
	__bptr+=4;
	return value;
}

double __readDouble()
{
	double value = *(double*)__bptr;
	__bptr+=8;
	return value;
}

bool _isClassOf(object *obj, byte *clsName)
{
	if(obj == null)
		return false;

	RTTIClassType ct = obj.getClassType();
	string scn = clsName;
	while(ct)
	{
		if(ct.name == scn)
			return true;
		ct = ct.baseClass;
	}
	return false;
}

object* _dynamicCast(object *obj, byte *clsName)
{
	if(obj == null)
		return null;

	RTTIClassType ct = obj.getClassType();
	string scn = clsName;
	while(ct)
	{
		if(ct.name == scn)
			return obj;
		ct = ct.baseClass;
	}
	return null;
}

union RTTIConstValue
{
	long l;
	ulong ul;
	int i;
	uint ui;
	short s;
	ushort us;
	byte b;
	ubyte ub;
	float f;
	double d;
}

class RTTISymbol
{
	SymbolType stype;
	SymbolFlags flags;
	string name;
	array<RTTIType> children = new array<RTTIType>();
	weak RTTISymbol parent = null;
	array<string> attributes = new array<string>();

	virtual bool IsType() => false;
	virtual bool IsFunction() => false;

	RTTISymbol constructor(SymbolType stype, SymbolFlags flags, string name)
	{
		base();
		this.stype = stype;
		this.flags = flags;
		this.name = name;
		return this;
	}

	void addChild(RTTISymbol child)
	{
		children.add(child);
		child.parent = this;
	}

	RTTISymbol Find(string name)
	{
		for(int i = 0; i < children.count; ++i)
		{
			RTTISymbol child = children[i];
			if(child.name == name)
				return child;
		}
		return null;
	}

	array<string> EnumChildren(string className)
	{
		array<string> result = new array<string>();
		for(int i = 0; i < children.count; ++i)
		{
			RTTISymbol child = children[i];
			if(!strcmp(child.getClassName(), className.c_str()))
				result.add(child.name);
		}
		return result;
	}

	bool HasAttribute(string name)
	{
		if(attributes == null)
			return false;

		string key = name + "(";
		for(int i = 0; i < attributes.count; ++i)
		{
			string attr = attributes[i];
			if(attr.startsWith(key))
				return true;
		}
		return false;
	}

	array<string> GetAttributes()
	{
		array<string> result = new array<string>();
		if(attributes != null)
		{
			for(int i = 0; i < attributes.count; ++i)
			{
				string attr = attributes[i];
				int pos = attr.indexOfChar('(');
				if(pos != -1)
					attr = attr.substr(0, pos);
				result.add(attr);
			}
		}
		return result;
	}

	bool GetAttributeBool(string name)
	{
		if(attributes == null)
			return false;

		string key = name + "(";
		for(int i = 0; i < attributes.count; ++i)
		{
			string attr = attributes[i];
			if(attr.startsWith(key))
			{
				int pos = attr.indexOfChar(')');
				if(pos != -1)
				{
					string value = attr.substr(key.length, pos-key.length);
					return value == "true";
				}
			}
		}
		return false;
	}

	int GetAttributeInt(string name)
	{
		if(attributes == null)
			return 0;

		string key = name + "(";
		for(int i = 0; i < attributes.count; ++i)
		{
			string attr = attributes[i];
			if(attr.startsWith(key))
			{
				int pos = attr.indexOfChar(')');
				if(pos != -1)
				{
					string value = attr.substr(key.length, pos-key.length);
					return atoi(value.c_str());
				}
			}
		}
		return 0;
	}

	string GetAttributeString(string name)
	{
		if(attributes == null)
			return null;

		string key = name + "(";
		for(int i = 0; i < attributes.count; ++i)
		{
			string attr = attributes[i];
			if(attr.startsWith(key))
			{
				int pos = attr.indexOfChar(')');
				if(pos != -1)
				{
					string value = attr.substr(key.length, pos-key.length);
					if(value.startsWith("\"") && value.endsWith("\""))
					{
						value = value.substr(1, value.length-2);
						return value;
					}
					return null;
				}
			}
		}
		return null;
	}
}

class RTTIType : RTTISymbol
{
	static dictionary<string, RTTIType> allTypes = new dictionary<string, RTTIType>();
	RTTIPointerType pointerType;

	bool IsType() => true;
	virtual bool IsPrimitive() => false;
	virtual bool IsPointer() => false;
	virtual bool IsArray() => false;
	virtual bool IsEnum() => false;
	virtual bool IsStruct() => false;
	virtual bool IsClass() => false;
	virtual bool IsClassRef() => false;

	RTTIModule get ParentModule() => _dynamicCast(this.parent, "RTTIModule");

	static RTTIType _Void = new RTTIPrimitiveType("void", 0);
	static RTTIType _Bool = new RTTIPrimitiveType("bool", 1);
	static RTTIType _Byte = new RTTIPrimitiveType("byte", 1);
	static RTTIType _UByte = new RTTIPrimitiveType("ubyte", 1);
	static RTTIType _Short = new RTTIPrimitiveType("short", 2);
	static RTTIType _UShort = new RTTIPrimitiveType("ushort", 2);
	static RTTIType _Int = new RTTIPrimitiveType("int", 4);
	static RTTIType _UInt = new RTTIPrimitiveType("uint", 4);
	static RTTIType _Long = new RTTIPrimitiveType("long", 8);
	static RTTIType _ULong = new RTTIPrimitiveType("ulong", 8);
	static RTTIType _Float = new RTTIPrimitiveType("float", 4);
	static RTTIType _Double = new RTTIPrimitiveType("double", 8);

	static RTTIType get Void() => _Void;
	static RTTIType get Bool() => _Bool;
	static RTTIType get Byte() => _Byte;
	static RTTIType get UByte() => _UByte;
	static RTTIType get Short() => _Short;
	static RTTIType get UShort() => _UShort;
	static RTTIType get Int() => _Int;
	static RTTIType get UInt() => _UInt;
	static RTTIType get Long() => _Long;
	static RTTIType get ULong() => _ULong;
	static RTTIType get Float() => _Float;
	static RTTIType get Double() => _Double;

	RTTIType constructor(SymbolType stype, SymbolFlags flags, string name)
	{
		base(stype, flags, name);
		if(stype != SymbolType.Function)
			allTypes[name] = this;
		return this;
	}

	RTTIPointerType GetPointerType()
	{
		if(pointerType == null)
		{
			pointerType = new RTTIPointerType(this);
		}
		return pointerType;		
	}

	RTTIArrayType GetArrayType(int sz)
	{
		return new RTTIArrayType(this, sz);
	}

	static RTTIType GetType(string name)
	{
		return allTypes[name];
	}
}

class RTTIPrimitiveType : RTTIType
{
	int size;

	bool IsPrimitive() => true;

	RTTIPrimitiveType constructor(string name, int size)
