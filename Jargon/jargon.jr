//-----------------------------------------------------------------------------

template class array<T>
{
	T *data;
	int _size;
	int _count;
	
	array<T>* constructor()
	{
		base();
		_size = 128;
		_count = 0;
		data = memory.alloc(sizeof(T) * _size);
		memory.put(data, 0, sizeof(T) * _size);
		return this;
	}
	
	void destructor()
	{
		clear();
		base();
	}
	
	int get count() => _count;
	
	int get size() => _size;
	
	T get_item(int index)
	{
		index = 0 >? index <? _count-1;
		return data[index];
	}
	
	void set_item(int index, T value)
	{
		index = 0 >? index <? _count-1;
		data[index] = value;
	}
	
	int add(T value)
	{
		if(_count == _size)
		{
			_size *= 2;
			T* newData = memory.alloc(sizeof(T) * _size);
			memory.put(newData, 0, sizeof(T) * _size);
			memory.copy(newData, data, sizeof(T) * _count);
			memory.free(data);
			data = newData;
		}
		data[_count++] = value;
		return _count-1;
	}
	
	void insert(int index, T value)
	{
		if(_count == _size)
		{
			_size *= 2;
			T* newData = memory.alloc(sizeof(T) * _size);
			memory.put(newData, 0, sizeof(T) * _size);
			memory.move(newData, data, sizeof(T) * _count);
			memory.free(data);
			data = newData;
		}
		index = 0 >? index <? _count;
		memory.move(data + index + 1, data + index, (count - index) * sizeof(T));
		memory.put(data + index, 0, sizeof(T));
		data[index] = value;
		++_count;
	}
	
	void removeAt(int index)
	{
		if(_count == 0)
			return;
			
		index = 0 >? index <? _count-1;
		data[index] = (T)0;
		memory.move(data + index, data + index + 1, (count - index - 1) * sizeof(T));
		--_count;
		
		if(_size > 8 && _count < _size >> 2)
		{
			_size >>= 2;
			T* newData = memory.alloc(sizeof(T) * _size);
			memory.put(newData, 0, sizeof(T) * _size);
			memory.move(newData, data, sizeof(T) * _count);
			memory.free(data);
			data = newData;
		}
	}
	
	int indexOf(T value)
	{
		for(int i = 0; i < _count; ++i)
		{
			if(data[i] == value)
				return i;
		}
		return -1;
	}
	
	void remove(T value)
	{
		int index = indexOf(value);
		if(index != -1)
		{
			removeAt(index);
		}
	}
	
	bool contains(T value)
	{
		return indexOf(value) != -1;
	}
	
	void clear()
	{
		for(int i = 0; i < _count; ++i)
		{
			data[i] = (T)0;
		}
		memory.free(data);
		_size = 8;
		_count = 0;
		data = memory.alloc(sizeof(T) * _size);
		memory.put(data, 0, sizeof(T) * _size);
	}

	T first() => data[0];

	T last() => data[_count-1];
	
	void reverse()
	{
		for(int i = 0; i < _count >> 1; i++) {
			T c = data[i];
			data[i] = data[_count-i-1];
			data[_count-i-1] = c;
		}
	}
	
	void resize(int newCount)
	{
		if(newCount == _count)
			return;
			
		if(newCount < _count)
		{
			for(int i = newCount; i < _count; ++i)
			{
				data[i] = (T)0;
			}
			
			if(_size > 8 && newCount  < _size >> 2)			
			{
				while(size > 8 && newCount < size >> 2)
					_size >>= 2;
				T* newData = memory.alloc(sizeof(T) * _size);
				memory.put(newData, 0, sizeof(T) * _size);
				memory.move(newData, data, sizeof(T) * newCount);
				memory.free(data);
				data = newData;
			} 	
			
			_count = newCount;
		}
		else
		{
			while(_size < newCount)
				_size *= 2;
			
			T* newData = memory.alloc(sizeof(T) * _size);
			memory.put(newData, 0, sizeof(T) * _size);
			memory.move(newData, data, sizeof(T) * _count);
			memory.free(data);
			data = newData;
		}
	}
	
	void reserve(int newSize)
	{
		if (newSize == _size) 
			return;
		
		if (newSize < _size)
		{		
			if (newSize < _count)
			{
				for(int i = newSize; i < count; ++i)
					data[i] = (T)0;
				_count = newSize;
			}
			
			if(_size > 32 && newSize < _size / 4)
			{
				_size = newSize;
				
				byte *newData = memory.alloc(sizeof(T) * _size);
				memory.put(newData, 0, sizeof(T) * _size);
				
				if(_count > 0)
					memory.move(newData, data, sizeof(T) * _count);
				
				memory.free(data);
				data = newData;
			}
			else
			{
				_size = newSize;
			}
		}
		else
		{	
			while(_size < newSize)
				_size = _size * 2;
			
			byte *newData = memory.alloc(sizeof(T) * _size);
			memory.put(newData, 0, sizeof(T) * _size);
			
			if(_count > 0)
				memory.copy(newData, data, sizeof(T) * _count);
			
			memory.free(data);
			data = newData;
		}
	}

	// From Kernighan & Ritchie's "The C Programming Language" book
	void _qsort(int left, int right) 
	{
		int i = 0;
		int last = 0;

		if (left >= right)
			return;

		T temp = data[left];
		data[left] = data[(left+right)/2];
		data[(left+right)/2] = temp;
		last = left;
		for (i = left + 1; i <= right; i++) {
			if(data[i] < data[left])
			{
				++last;
				temp = data[last];
				data[last] = data[i];
				data[i] = temp;
			}
		}
		temp = data[left];
		data[left] = data[last];
		data[last] = temp;
		_qsort(left, last - 1);
		_qsort(last + 1, right);
	}

	void sort()
	{
		_qsort(0, _count - 1);
	}

	string join(string sep)
	{
		string result = "";
		for(int i = 0; i < count; i++)
		{
			if(i != 0)
				result += sep;
			result += data[i].toString();
		}
		return result;
	}
}

//-----------------------------------------------------------------------------

class StringExtensions
{
	static array<string*>* split(string *this, string *separator)
	{	
		array<string*> *result = new array<string*>();	
	
		byte *ptr = this.c_str();
		byte *sep = separator.c_str();
		int prev = 0;
		byte *p = strstr(ptr, sep);	
		int pos = p == null ? -1 : p - ptr;
		while(pos != -1)
		{
			result.add(this.substr(prev, pos-prev));
			prev = pos + separator.length;
			if(prev == this.length) {
				result.add("");
				break;
			}
			p = strstr(ptr + prev, sep);
			pos = p == null ? -1 : p - ptr;
			if(pos == -1 && prev < this.length)
			result.add(this.substr(prev, this.length-prev));
		}
		return result;
	}
}

//-----------------------------------------------------------------------------

template class hash_pair<K,T>
{
	K key;
	T data;
	hash_pair<K,T>* next;
	
	void destructor()
	{
		base();
	}
}

template class dictionary<K,T>
{
	hash_pair<K,T>** buckets;
	int size;
	int count;
	
	dictionary<K,T>* constructor() {
        base();        
        size = 64;
		count = 0;
        buckets = memory.alloc(size * sizeof(hash_pair<K,T>));  
		memory.put(buckets, 0, size * sizeof(hash_pair<K,T>));
        return this;
    }
	
	void destructor() { 
        clear();
        memory.free(buckets);
        base();
    }
	
	void clear() {
        for (int i = 0; i < size; ++i) {
            hash_pair<K,T>* current = buckets[i];
            hash_pair<K,T>* prev = null;
            while (current != null) {
				hash_pair<K,T>* temp = current;
                current = current.next;
                temp.key = (K)0;
                temp.data = (T)0;
                if(prev != null)
                    prev.next = null;
                prev = temp;
            }
            buckets[i] = null;
        }
		count = 0;
    }
	
	void set_item(K key, T value) {
        long h = key.getHash();
        //int index = (int)(h % size);
		int index = (int)(h & 0x3f);

		hash_pair<K,T>* current = buckets[index];

        while (current != null) {
            if (current.key == key) {
                current.data = value;
				return;
            }
            current = current.next;
        }

        hash_pair<K,T>* newItem = new hash_pair<K,T>();        
        newItem.key = key;    
        newItem.data = value;
        newItem.next = buckets[index];
        buckets[index] = newItem;
		++count;
    }
	
	T get_item(K key) {

        long h = key.getHash();
        //int index = (int)(h % size);
		int index = (int)(h & 0x3f);

        hash_pair<K,T>* current = buckets[index];

        while (current != null) {
            if (current.key == key) {
                return current.data;
            }
            current = current.next;
        }
		
        return (T)0;
    }

	void remove(K key)
	{
		long h = key.getHash();
        //int index = (int)(h % size);
		int index = (int)(h & 0x3f);

        hash_pair<K,T>* current = buckets[index];
		hash_pair<K,T>* prev = null;

        while (current != null) {
            if (current.key == key) {
                
				if(prev) {
					prev.next = current.next;
				}
				else {
					buckets[index] = current.next;
				}
				--count;
                return;
            }
			prev = current;
            current = current.next;
        }
	}

	array<K>* get keys()
	{
		array<K>* result = new array<K>();
		for(int i = 0; i < size; ++i)
		{
			hash_pair<K,T>* pair = buckets[i];
			while(pair != null)
			{
				result.add(pair.key);
				pair = pair.next;
			}
		}
		return result;
	}

	array<T>* get values()
	{
		array<T>* result = new array<T>();
		for(int i = 0; i < size; ++i)
		{
			hash_pair<K,T>* pair = buckets[i];
			while(pair != null)
			{
				result.add(pair.data);
				pair = pair.next;
			}
		}
		return result;
	}

	bool contains(K key)
	{
		long h = key.getHash();
        //int index = (int)(h % size);
		int index = (int)(h & 0x3f);

        hash_pair<K,T>* current = buckets[index];

        while (current != null) {
            if (current.key == key) {
                return true;
            }
            current = current.next;
        }
		
        return false;
	}
}

//-----------------------------------------------------------------------------

template class hash_item<K>
{
	K key;
	hash_item<K>* next;
	
	void destructor()
	{
		base();
	}
}

template class hash_set<K>
{
	hash_item<K>** buckets;
	int size;
	int count;
	
	hash_set<K>* constructor() {
        base();        
        size = 64;
		count = 0;
        buckets = memory.alloc(size * sizeof(hash_item<K>));  
		memory.put(buckets, 0, size * sizeof(hash_item<K>));
        return this;
    }
	
	void destructor() { 
        clear();
        memory.free(buckets);
        base();
    }
	
	void clear() {
        for (int i = 0; i < size; ++i) {
            hash_item<K>* current = buckets[i];
            hash_item<K>* prev = null;
            while (current != null) {
				hash_item<K>* temp = current;
                current = current.next;
                temp.key = (K)0;
                if(prev != null)
                    prev.next = null;
                prev = temp;
            }
            buckets[i] = null;
        }
		count = 0;
    }
	
	void add(K key) {
        long h = key.getHash();
        //int index = (int)(h % size);
		int index = (int)(h & 0x3f);

        hash_item<K>* current = buckets[index];

        while (current != null) {
            if (current.key == key) {
                return;
            }
            current = current.next;
        }

        hash_item<K>* newItem = new hash_item<K>();        
        newItem.key = key;
        newItem.next = buckets[index];
        buckets[index] = newItem;
		++count;
    }
	
	void remove(K key)
	{
		long h = key.getHash();
        //int index = (int)(h % size);
		int index = (int)(h & 0x3f);

        hash_item<K>* current = buckets[index];
		hash_item<K>* prev = null;

        while (current != null) {
            if (current.key == key) {
                
				if(prev) {
					prev.next = current.next;
				}
				else {
					buckets[index] = current.next;
				}
				--count;
                return;
            }
			prev = current;
            current = current.next;
        }
	}

	array<K>* get keys()
	{
		array<K>* result = new array<K>();
		for(int i = 0; i < size; ++i)
		{
			hash_item<K>* pair = buckets[i];
			while(pair != null)
			{
				result.add(pair.key);
				pair = pair.next;
			}
		}
		return result;
	}

	bool contains(K key)
	{
		long h = key.getHash();
        //int index = (int)(h % size);
		int index = (int)(h & 0x3f);

        hash_item<K>* current = buckets[index];

        while (current != null) {
            if (current.key == key) {
                return true;
            }
            current = current.next;
        }
		
        return false;
	}
}

//-----------------------------------------------------------------------------

enum SeekPos
{
	Start,
	Current,
	End,
}

class file
{
	void *fptr;

	file* constructor()
	{
		base();
		fptr = null;
		return this;
	}

	void destructor()
	{
		close();
		base();
	}

	void seek(long offset, SeekPos whence)
	{
		fseek(fptr, offset, whence);
	}

	long get position()
	{
		return ftell(fptr);	
	}

	long read(void *buffer, long size)
	{
		return fread(buffer, size, 1, fptr);
	}

	long write(void *buffer, long size)
	{
		return fwrite(buffer, size, 1, fptr);
	}

	void close()
	{
		if(fptr)
			fclose(fptr);
	}

	static file* open(string *fileName, string *mode)
	{
		file *f = new file();
		f.fptr = fopen(fileName.c_str(), mode.c_str());
		if(f.fptr == null)
			return null;
		else
			return f;
	}

	static string* readAllText(string *fileName)
	{
		file *f = file.open(fileName, "rb");
		if(f == null)
			return null;
		f.seek(0, SeekPos.End);
		long size = f.position;
		f.seek(0, SeekPos.Start);
		byte *buffer = memory.alloc(size+1);
		f.read(buffer, size);
		buffer[(int)size] = 0;
		string* result = new string(buffer);
		memory.free(buffer);
		return result;
	}	

	static bool writeAllText(string *fileName, string *text)
	{
		file *f = file.open(fileName, "wb");
		if(f == null)
			return false;
		f.write(text.c_str(), text.length);
		return true;
	}

	static bool rename(string *oldFileName, string *newFileName)
	{
		return rename(oldFileName.c_str(), newFileName.c_str()) == 0;
	}

	static bool deleteFile(string *fileName)
	{
		return remove(fileName.c_str()) != 0;
	}

	static bool exists(string *fileName)
	{
		void *f = fopen(fileName.c_str(), "rb");
		if(f != null) {
			fclose(f);
			return true;
		}
		else {
			return false;
		}
	}
}

//-----------------------------------------------------------------------------

class directory
{
	static bool create(string *path)
	{
		return _mkdir(path.c_str()) == 0;
	}

	static bool remove(string *path)
	{
		return _rmdir(path.c_str()) == 0;
	}

	static bool rename(string *oldPath, string *newPath)
	{
		return rename(oldPath.c_str(), newPath.c_str()) == 0;
	}

	static bool exists(string *path)
	{
		return _access(path.c_str(), 0) == 0;
	}

	static array<string> getFiles(string path, string filter)
	{
		array<string> result = new array<string>();
		string *searchPath = path + "\\" + filter;
		_finddata_t fileInfo;
		long handle = _findfirst64i32(searchPath.c_str(), &fileInfo);
		if(handle != -1)
		{
			do
			{
				if((fileInfo.attrib & _A_SUBDIR) == 0)
				{
					result.add(new string(&fileInfo.name[0]));
				}
			} while(_findnext64i32(handle, &fileInfo) == 0);
			_findclose(handle);
		}
		return result;
	}

	static array<string> getDirectories(string path, string filter)
	{
		array<string> result = new array<string>();
		string *searchPath = path + "\\" + filter;
		_finddata_t fileInfo;
		long handle = _findfirst64i32(searchPath.c_str(), &fileInfo);
		if(handle != -1)
		{
			do
			{
				if((fileInfo.attrib & _A_SUBDIR) != 0)
				{
					result.add(new string(&fileInfo.name[0]));
				}
			} while(_findnext64i32(handle, &fileInfo) == 0);
			_findclose(handle);
		}
		return result;
	}
}

//-----------------------------------------------------------------------------

class path
{
	static string getCurrentDirectory()
    {
        byte buffer[256];
        if(_getcwd(buffer, 256))
        {
            return new string(buffer);
        }
        return null;
    }

	static string getDirectoryName(string filePath)
	{
		int index = filePath.lastIndexOfChar('\\');
		if(index >= 0)
		{
			return filePath.substr(0, index);
		}
		else
		{
			return ".";
		}
	}

	static string getFileName(string filePath)
    {
        int index = filePath.lastIndexOfChar('\\');
		if(index >= 0)
			return filePath.substr(index+1, filePath.length-index-1);
		else
			return filePath;
    }

	static string getExtension(string filePath)
	{
		int index = filePath.lastIndexOfChar('.');
		if(index >= 0)
			return filePath.substr(index, filePath.length-index);
		else
			return "";
	}

	static string getFileNameWithoutExtension(string filePath)
	{
		int index = filePath.lastIndexOfChar('\\');
		int dotIndex = filePath.lastIndexOfChar('.');
		if(dotIndex > index)
			return filePath.substr(index+1, dotIndex-index-1);
		else
			return path.getFileName(filePath);
	}

	static string canonize(string filePath)
	{
		array<string> source = filePath.split("\\");
		array<string> dest = new array<string>();

		for(int i = 0; i < source.count; ++i)
		{
			string part = source[i];

			if(part == ".") // skip current folder
			{
				continue;
			}
			else if(part == "..") // pop previous folder
			{
				if(dest.count > 0)
				{
					dest.removeAt(dest.count-1);
				}
			}
			else
			{
				dest.add(part);
			}
		}

		string result = dest.join("\\");	

		return result;
	}

	static string getFullPath(string filePath)
    {
        if(filePath.indexOf(":") == -1)
        {
            string cwd = path.getCurrentDirectory();
            if(cwd != null)
            {
                return path.canonize(cwd + '\\' + filePath);
            }
            else
            {
                return null;
            }
        }
        else
        {
            return filePath;
        }
    }
}

