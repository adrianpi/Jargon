		else
		{
			double (*pfGet)(object* _this) = fGet.address;
			return (*pfGet)(obj);
		}
	}

	void SetPointerValue(object obj, void *value)
	{
		if(!propertyType.IsPointer())
			return;
		RTTIFunction fSet = setter.function;
		if((flags & SymbolFlags.Static) != 0)
		{
			void (*pfSet)(void* value) = fSet.address;
			(*pfSet)(value);
		}
		else
		{
			void (*pfSet)(object* _this, void* value) = fSet.address;
			(*pfSet)(obj, value);
		}
	}

	void* GetPointerValue(object obj)
	{
		if(!propertyType.IsPointer())
			return null;
		RTTIFunction fGet = getter.function;
		if((flags & SymbolFlags.Static) != 0)
		{
			void* (*pfGet)() = fGet.address;
			return (*pfGet)();
		}
		else
		{
			void* (*pfGet)(object* _this) = fGet.address;
			return (*pfGet)(obj);
		}
	}

	void SetObjectValue(object obj, object value)
	{
		if(propertyType.IsClassRef())
		{
			RTTIFunction fSet = setter.function;
			if((flags & SymbolFlags.Static) != 0)
			{
				void (*pfSet)(object value) = fSet.address;
				(*pfSet)(value);
			}
			else
			{
				void (*pfSet)(object* _this, object value) = fSet.address;
				(*pfSet)(obj, value);
			}
		}
	}

	object GetObjectValue(object obj)
	{
		if(!propertyType.IsClassRef())
			return null;
		RTTIFunction fGet = getter.function;
		if((flags & SymbolFlags.Static) != 0)
		{
			object (*pfGet)() = fGet.address;
			return (*pfGet)();
		}
		else
		{
			object (*pfGet)(object* _this) = fGet.address;
			return (*pfGet)(obj);
		}
	}
}

class RTTIClassType : RTTIType
{
	RTTIClassType baseClass;
	int size;
	//int alignment;

	bool IsClass() => true;

	RTTIClassType constructor(string name, SymbolFlags flags)
	{
		base(SymbolType.Class, flags, name);
		return this;
	}

	RTTIConstant GetConstant(string name)
	{
		return _dynamicCast(Find(name), "RTTIConstant");
	}

	RTTIField GetField(string name)
	{
		return _dynamicCast(Find(name), "RTTIField");
	}

	RTTIProperty GetProperty(string name)
	{
		return _dynamicCast(Find(name), "RTTIProperty");
	}

	RTTIMethod GetMethod(string name)
	{
		return _dynamicCast(Find(name), "RTTIMethod");
	}

	RTTIFunction GetCreator()
	{
		RTTIModule parentModule = ParentModule;
		return parentModule.GetFunction(string.format("%s__new", name));
	}

	array<string> EnumConstants()
	{
		return EnumChildren("RTTIConstant");
	}

	array<string> EnumFields()
	{
		return EnumChildren("RTTIField");
	}

	array<string> EnumMethods()
	{
		return EnumChildren("RTTIMethod");
	}

	array<string> EnumProperties()
	{
		return EnumChildren("RTTIProperty");
	}
}

class RTTIModuleUsing
{
	string name;
	weak RTTIModule module;
}

class RTTIModule : RTTISymbol
{
	ulong handle;
	array<RTTIModuleUsing> usings = new array<RTTIModuleUsing>();

	RTTIModule constructor(string name, ulong handle)
	{
		base(SymbolType.Module, SymbolFlags.None, name);
		this.handle = handle;
		return this;
	}

	static RTTIModule GetModule(string name)
	{
		return _dynamicCast(RTTIRoot.Instance.Find(name), "RTTIModule");
	}

	RTTIConstant GetConstant(string name)
	{
		return _dynamicCast(Find(name), "RTTIConstant");
	}

	RTTIEnumType GetEnum(string name)
	{
		return _dynamicCast(Find(name), "RTTIEnumType");
	}

	RTTIFunction GetFunction(string name)
	{
		return _dynamicCast(Find(name), "RTTIFunction");
	}

	RTTIStructType GetStruct(string name)
	{
		return _dynamicCast(Find(name), "RTTIStructType");
	}

	RTTIClassType GetClass(string name)
	{
		return _dynamicCast(Find(name), "RTTIClassType");
	}

	array<string> EnumConstants()
	{
		return EnumChildren("RTTIConstant");
	}

	array<string> EnumEnums()
	{
		return EnumChildren("RTTIEnumType");
	}

	array<string> EnumFunctions()
	{
		return EnumChildren("RTTIFunction");
	}

	array<string> EnumStructs()
	{
		return EnumChildren("RTTIStructType");
	}

	array<string> EnumClasses()
	{
		return EnumChildren("RTTIClassType");
	}

}

class RTTIRoot : RTTISymbol
{
	static RTTIRoot instance = null;

	static RTTIRoot get Instance() => instance;

	RTTIRoot constructor()
	{
		base(SymbolType.Root, SymbolFlags.None, "root");
		return this;
	}
}

int ReadType0(RTTIModule module)
{
	int tc = __readByte();
	if(tc == TypeCode.Pointer)
	{
		tc = 0x1000 + ReadType0(module);
	}
	else if(tc == TypeCode.Array)
	{
		int sz = __readInt();
		tc = 0x10000 + ReadType0(module);
	}
	else if(tc == TypeCode.Struct)
	{
		byte name[256];
		__readString(name);
	}
	else if(tc == TypeCode.Function)
	{
		int returnType = ReadType0(module);
		int paramCount = __readInt();
		for(int i = 0; i < paramCount; ++i)
		{
			ReadType0(module);
		}
	}
	return tc;
}


RTTIType ReadType(RTTIModule module)
{
	int tc = __readByte();

	if(tc == TypeCode.Enum)
	{
		byte name[256];
		__readString(name);

		RTTIType ts = module.Find(name);
        if(ts == null)
        {
            for(int i = 0; i < module.usings.count; ++i)
            {
                RTTIModuleUsing u = module.usings[i];
				if(u.module != null)
				{
					ts = u.module.Find(name);
					if (ts != null)
						return ts;
				}
            }
            //assert(false);
            return null;
        }
        return ts;
	}

	if (tc == TypeCode.None)
        return null;
    // Return built-in primitive type symbols
    else if (tc == TypeCode.Void)
        return RTTIType.Void;
    else if (tc == TypeCode.Bool)
        return RTTIType.Bool;
    else if (tc == TypeCode.Byte)
        return RTTIType.Byte;
    else if (tc == TypeCode.UByte)
        return RTTIType.UByte;
    else if (tc == TypeCode.Short)
        return RTTIType.Short;
    else if (tc == TypeCode.UShort)
        return RTTIType.UShort;
    else if (tc == TypeCode.Int)
        return RTTIType.Int;
    else if (tc == TypeCode.UInt)
        return RTTIType.UInt;
    else if (tc == TypeCode.Long)
        return RTTIType.Long;
    else if (tc == TypeCode.ULong)
        return RTTIType.ULong;
    else if (tc == TypeCode.Float)
        return RTTIType.Float;
    else if (tc == TypeCode.Double)
        return RTTIType.Double;
	else if(tc == TypeCode.Pointer)
	{
		RTTIType t = ReadType(module);
		if(t == null)
			return null;
        RTTIPointerType ptrt = t.GetPointerType();
        return ptrt;
	}
	else if(tc == TypeCode.Array)
	{
		int sz = __readInt();
        RTTIType t = ReadType(module);
		if(t == null)
			return null;
        return t.GetArrayType(sz);
	}
	else if(tc == TypeCode.Struct)
	{
		byte name[256];
		__readString(name);

		RTTIType ts = module.Find(name) as RTTIType;
        if(ts == null)
        {
            for(int i = 0; i < module.usings.count; ++i)
            {
                RTTIModuleUsing u = module.usings[i];
				if(u.module != null)
				{
					ts = u.module.Find(name) as RTTIType;
					if (ts != null)
						return ts;
				}
            }
            //assert(false);
            return null;
        }
        return ts;
	}
	else if(tc == TypeCode.Function)
	{
		RTTIType retType = ReadType(module);
		if(retType == null)
			return null;
		int flags = __readInt();
        int paramCount = __readShort();
        array<RTTIType> paramTypes = new array<RTTIType>();
        for(int i = 0; i < paramCount; ++i)
		{
			RTTIType pType = ReadType(module);
			if(pType == null)
				return null;        
            paramTypes.add(pType);
		}
        RTTIFunction fn = new RTTIFunction("", flags, retType);
        for(int i = 0; i < paramTypes.count; ++i)
		{
			RTTIParameter param = new RTTIParameter(string.format("p%d", i), 0, paramTypes[i]);
			fn.addChild(param);
            fn.parameters.add(param);
		}
        return fn;
	}
	return null;
}

array<string> _ReadAttributes(int flags)
{
	if((flags & SymbolFlags.HasAttributes) == 0)
		return null;

	array<string> result = new array<string>();
	byte name[4096];
	__readString(name);
	while(strcmp(name, ""))
	{
		result.add(name);
		__readString(name);
	}
	return result;
}

bool _readTypeLog = false;

void _setReadTypeLog(bool value)
{
	_readTypeLog = value;
}

string GetModuleName(ulong hModule)
{
	byte modulePath[256];
	GetModuleFileNameA(hModule, modulePath, 256);
	string result = path.getFileNameWithoutExtension(modulePath);
	if(result == "Jargon")
		result = "jargon";
	return result;
}

bool _readTypeInfo(byte *address)
{
	if(RTTIRoot.instance == null)
	{
		RTTIRoot.instance = new RTTIRoot();
	}

	RTTIModule module = new RTTIModule(GetModuleName((ulong)address), (ulong)address);
	RTTIRoot.instance.addChild(module);

	byte *ptr = address;
	short dosHeader = *(short*)ptr;
	ptr += 2;
	if(dosHeader != 0x5A4D) {
		printf("Not a DOS header");
		return false;
	}
	if(_readTypeLog) printf("DOS Header OK\n");

	ptr = address + 0x3c;
	int ntOffset = *(int*)ptr;
	
	ptr = address + ntOffset;	
	int peHeader = *(int*)ptr;
	ptr += 4;
	
	if(peHeader != 0x00004550) {
		printf("Not a PE header");
		return false;
	}
	if(_readTypeLog) printf("NT Header OK\n");
	
	ptr += 2; // machine
	ushort numSections = *(ushort*)ptr;
	ptr += 2;
	ptr += 4; // TimeDateStamp
	ptr += 4; // PointerToSymbolTable
	ptr += 4; // NumberOfSymbols
	ushort sizeOfOptionalHeader = *(ushort*)ptr;
	ptr += 2;
	ptr += 2; // Characteristics
	
	ptr += sizeOfOptionalHeader;

	if(_readTypeLog) printf("NumSections: %d\n", (int)numSections);
	
	for(int i = 0; i < numSections; ++i) 
	{
		byte secName[9];
		for(int j = 0; j < 8; j++) 
			secName[j] = *ptr++;
		secName[8] = 0;
		
		uint virtualSize = *(uint*)ptr;
		ptr += 4;
		uint virtualAddress = *(uint*)ptr;
		ptr += 4;
		uint sizeOfRawData = *(uint*)ptr;
		ptr += 4;
		uint pointerToRawData = *(uint*)ptr;
		ptr += 4;
		
		ptr += 16;
	
		if(!strcmp(secName, ".module")) {
			if(_readTypeLog) printf("Module data:\n");
			if(_readTypeLog) printf("\tVirtual Size: %x\n", virtualSize);
			if(_readTypeLog) printf("\tVirtual Address: %x\n", virtualAddress);
			if(_readTypeLog) printf("\tRaw Data Size: %x\n", sizeOfRawData);
			if(_readTypeLog) printf("\tRaw Data Pointer: %x\n", pointerToRawData);
			
			ptr = address + virtualAddress;
			
			__initBinaryRead(ptr);

			SymbolType st = __readByte();
			if(st != SymbolType.Module) {
				printf("Bad data\n");
				return false;
			}
			if(_readTypeLog) printf("\tData Present\n");
			uint version = __readInt();
			if(version != 0x01000000 && version != 0x01010000) {
				printf("Bad version");
				return false;
			}
			if(_readTypeLog) printf("\tVersion OK\n");
			byte name[256];
			__readString(name);
			if(_readTypeLog) printf("\tModule Name: %s\n", (byte*)name);

			// usings
			__readString(name);
			while(strcmp(name, "")) {
				RTTIModuleUsing mu = new RTTIModuleUsing();
				mu.name = name;
				mu.module = RTTIRoot.Instance.Find(mu.name);
				if(mu.module == null)
				{
					println("WARNING! Module %s not loaded", name);
				}
				module.usings.add(mu);
				__readString(name);
			}

			// forward declarations
			if(version == 0x01010000)
			{
				st = __readByte();
				while(st != 0)
				{
					__readString(name);
					RTTIClassType cfwd = new RTTIClassType(name, 0);
					module.addChild(cfwd);
					st = __readByte();
				}
			}

			int flags = 0;
			st = __readByte();
			array<string> attribs = null;

			while(st != SymbolType.None)
			{
				if(st == SymbolType.Constant)
				{
					flags = __readShort();
					RTTIType t = ReadType(module);
					__readString(name);
					if(_readTypeLog) printf("constant %s\n", (byte*)name);
					RTTIConstValue cv = {};
					if(t == RTTIType.Bool || t == RTTIType.Byte || t == RTTIType.UByte) {
						byte value = __readByte();
						cv.b = value;
						if(_readTypeLog) printf("\tvalue %d\n", value);
					}
					if(t == RTTIType.Short || t == RTTIType.UShort) {
						int value = __readShort();
						cv.s = value;
						if(_readTypeLog) printf("\tvalue %d\n", value);
					}
					if(t == RTTIType.Int || t == RTTIType.UInt) {
						int value = __readInt();
						cv.i = value;
						if(_readTypeLog) printf("\tvalue %d\n", value);
					}
					if(t == RTTIType.Long || t == RTTIType.ULong) {
						long value = __readInt();
						cv.l = value;
						if(_readTypeLog) printf("\tvalue %lld\n", value);
					}
					else if(t == RTTIType.Float) {
						float value = __readFloat();
						cv.f = value;
						if(_readTypeLog) printf("\tvalue %f\n", value);
					}
					else if(t == RTTIType.Double) {
						double value = __readDouble();
						cv.d = value;
						if(_readTypeLog) printf("\tvalue %f\n", value);
					}
					RTTIConstant c = new RTTIConstant(flags, name, t, cv);
					module.addChild(c);
				}
				else if(st == SymbolType.Enum)
				{
					flags = __readShort();
					attribs = _ReadAttributes(flags);
					RTTIType et = ReadType(module);
					__readString(name);
					if(_readTypeLog) printf("enum %s\n", (byte*)name);

					RTTIEnumType etype = new RTTIEnumType(name, et, flags);
					etype.attributes = attribs;
					module.addChild(etype);
					RTTIType.allTypes[name] = etype;

					int st2 = __readByte();
					while(st2 != 0) 
					{
						flags = __readShort();
						__readString(name);
						long value = __readLong();
						if(_readTypeLog) printf("\tvalue %s=%d\n", (byte*)name, value);
						RTTIEnumValue ev = new RTTIEnumValue(name, flags, value);
						etype.addChild(ev);
						st2 = __readByte();
					}
				}
				else if(st == SymbolType.Function)
				{
					flags = __readShort();
					attribs = _ReadAttributes(flags);
					RTTIType t = ReadType(module);
					__readString(name);
					if(_readTypeLog) printf("function %s\n", (byte*)name);

					RTTIFunction fn = new RTTIFunction(name, flags, t);
					module.addChild(fn);

					fn.attributes = attribs;

					__readString(name); // verbatim
					if(strcmp(name, "") != 0)
						fn.verbatimString = name;
					else
						fn.address = GetProcAddress(module.handle, fn.name.c_str());

					fn.Call = fn.address;

					int st2 = __readByte();
					while(st2 != 0)
					{
						flags = __readShort();
						RTTIType pt = ReadType(module);
						__readString(name);
						int offs = __readByte();
						if(_readTypeLog) printf("\targ %d %s\n", offs, (byte*)name);

						RTTIParameter param = new RTTIParameter(name, flags, pt);
						param.offset = offs;
						fn.addChild(param);
						fn.parameters.add(param);

						st2 = __readByte();
					}
				}
				else if(st == SymbolType.Struct)
				{
					flags = __readShort();
					attribs = _ReadAttributes(flags);
					__readString(name);
					int sz = __readShort();
					int align = __readShort();
					if(_readTypeLog) printf("struct %s\n", (byte*)name);

					RTTIStructType stype = new RTTIStructType(name, flags);
					stype.attributes = attribs;
					stype.size = sz;
					stype.alignment = align;
					module.addChild(stype);

					int st2 = __readByte();
					while(st2 != 0)
					{
						flags = __readShort();
						attribs = _ReadAttributes(flags);
						RTTIType ft = ReadType(module);
						__readString(name);
						int offs = __readShort();
						int idx = __readShort();
						if(_readTypeLog) printf("\tfield %s\n", (byte*)name);

						RTTIField field = new RTTIField(name, flags, ft);
						field.offset = offs;
						field.index = idx;
						field.attributes = attribs;
						stype.addChild(field);

						st2 = __readByte();
					}
				}
				else if(st == SymbolType.Class)
				{
					flags = __readShort();
					attribs = _ReadAttributes(flags);
					__readString(name);
					byte baseName[256];
					strcpy(baseName, "");
					int ctype = __readByte();
					if(ctype == TypeCode.Struct)
					{
						__readString(baseName);
					}
					int sz = __readShort();
					int fcnt = __readShort();
					if(_readTypeLog) printf("class %s : %s\n", (byte*)name, (byte*)baseName);

					RTTIClassType classType;
					if(version == 0x01010000)
					{
						classType = module.Find(name);
						classType.flags = flags;
					}
					else
					{
						classType = new RTTIClassType(name, flags);
					}
					classType.attributes = attribs;
					classType.baseClass = RTTIType.GetType(baseName) as RTTIClassType;
					module.addChild(classType);

					int st2 = __readByte();
					while(st2 != 0)
					{
						if(st2 == SymbolType.Constant)
						{
							flags = __readShort();
							RTTIType t = ReadType(module);
							__readString(name);
							RTTIConstValue cv = {};
							if(_readTypeLog) printf("constant %s\n", (byte*)name);
							if(t == RTTIType.Bool || t == RTTIType.Byte || t == RTTIType.UByte) {
								byte value = __readByte();
								cv.b = value;
								if(_readTypeLog) printf("\tvalue %d\n", value);
							}
							if(t == RTTIType.Short || t == RTTIType.UShort) {
								int value = __readShort();
								cv.s = value;
								if(_readTypeLog) printf("\tvalue %d\n", value);
							}
							if(t == RTTIType.Int || t == RTTIType.UInt) {
								int value = __readInt();
								cv.i = value;
								if(_readTypeLog) printf("\tvalue %d\n", value);
							}
							if(t == RTTIType.Long || t == RTTIType.ULong) {
								long value = __readInt();
								cv.l = value;
								if(_readTypeLog) printf("\tvalue %lld\n", value);
							}
							else if(t == RTTIType.Float) {
								float value = __readFloat();
								cv.f = value;
								if(_readTypeLog) printf("\tvalue %f\n", value);
							}
							else if(t == RTTIType.Double) {
								double value = __readDouble();
								cv.d = value;
								if(_readTypeLog) printf("\tvalue %f\n", value);
							}
							RTTIConstant ck = new RTTIConstant(flags, name, t, cv);
							classType.addChild(ck);
						}
						else if(st2 == SymbolType.Field)
						{
							flags = __readShort();
							attribs = _ReadAttributes(flags);
							RTTIType ft = ReadType(module);
							__readString(name);
							int offs = __readShort();
							int idx = __readShort();
							if(_readTypeLog) printf("\tfield %s\n", (byte*)name);

							RTTIField field = new RTTIField(name, flags, ft);
							field.offset = offs;
							field.index = idx;
							field.attributes = attribs;
							classType.addChild(field);
						}
						else if(st2 == SymbolType.Method) 
						{
							flags = __readShort();
							attribs = _ReadAttributes(flags);
							__readString(name);
							byte fname[256];
							__readString(fname);
							if(strcmp(fname, "") == 0)
							{
								strcpy(fname, classType.name.c_str());
								strcat(fname, "__");
								strcat(fname, name);
							}

							int vslot = __readShort();
							if(_readTypeLog) printf("\tmethod %s -> %s [%d]\n", (byte*)name, (byte*)fname, vslot);
							
							RTTIMethod method = new RTTIMethod(name, flags);
							method.VSlot = vslot;
							method.attributes = attribs;
							classType.addChild(method);
							method.functionName = fname;
						}
						else if(st2 == SymbolType.Property) 
						{
							flags = __readShort();
							attribs = _ReadAttributes(flags);
							RTTIType pt = ReadType(module);
							__readString(name);
							byte getset = __readByte();

							RTTIProperty prop = new RTTIProperty(name, flags, pt);
							prop.Class = classType;
							prop.attributes = attribs;
							classType.addChild(prop);

							if((getset & 1) != 0)
								prop.getterName = string.format("get_%s", name);
							if((getset & 2) != 0)
								prop.setterName = string.format("set_%s", name);
						}
						st2 = __readByte();
					}
					__readString(name);
					while(strcmp(name, "")) {
						__readString(name);
					}
				}
				else if(st == SymbolType.Template)
				{
					flags = __readShort();
					attribs = _ReadAttributes(flags);
					__readString(name);
					__readString(name);
					while(strcmp(name, ""))
						__readString(name);
					byte ch = __readByte();
					while(ch != 0)
						ch = __readByte();
				}
				st = __readByte();
			}

			for(int i = 0; i < module.children.count; ++i)
			{
				RTTIClassType ctype = module.children[i] as RTTIClassType;
				if(ctype != null)
				{
					for(int j = 0; j < ctype.children.count; ++j)
					{
						RTTIMethod cm = ctype.children[j] as RTTIMethod;
						if(cm != null)
						{
							cm.function = module.Find(cm.functionName);
						}
						else
						{
							RTTIProperty cp = ctype.children[j] as RTTIProperty;
							if(cp != null)
							{
								if(cp.getterName != null)
									cp.getter = ctype.Find(cp.getterName);
								if(cp.setterName != null)
									cp.setter = ctype.Find(cp.setterName);							
							}
						}
					}
				}
			}
			
			return true;
		}
	}
	
	return false;
}

void _freeTypeInfo(byte *address)
{
	string moduleName = GetModuleName((ulong)address);

	RTTIModule module = _dynamicCast(RTTIRoot.Instance.Find(moduleName), "RTTIModule");
	for(int i = 0; i < module.children.count; ++i)
	{
		RTTIType type = _dynamicCast(module.children[i], "RTTIType");
		if(type != null && !type.IsFunction())
		{
			RTTIType.allTypes.remove(type.name);
		}
	}

	RTTIRoot.Instance.children.remove(module);
}

int DllMain(long hModule, int dwReason, void *pReserved)
{
	if(dwReason == 1)
	{
		_readTypeInfo((byte*)hModule);
	}
	else if(dwReason == 0)
	{
		_freeTypeInfo((byte*)hModule);
	}
	return 1;
}
