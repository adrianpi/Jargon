class RTTIField : RTTISymbol
{
	RTTIType fieldType;
	int offset;
	int index;

	RTTIType get ParentType() => _dynamicCast(this.parent, "RTTIType");

	RTTIField constructor(string name, SymbolFlags flags, RTTIType ftype)
	{
		base(SymbolType.Field, flags, name);
		this.fieldType = ftype;
		return this;
	}

	void SetBoolValue(void* obj, bool value)
	{
		if(fieldType != RTTIType.Bool || (flags & SymbolFlags.Static) != 0)
			return;
		byte* ptr = (byte*)obj + offset;
		*((bool*)ptr) = value ? 1 : 0;
	}

	bool GetBoolValue(void* obj)
	{
		if(fieldType != RTTIType.Bool || (flags & SymbolFlags.Static) != 0)
			return false;
		byte* ptr = (byte*)obj + offset;
		return *((bool*)ptr) != 0;
	}

	void SetByteValue(void* obj, byte value)
	{
		if((fieldType != RTTIType.Byte && fieldType != RTTIType.UByte) || (flags & SymbolFlags.Static) != 0)
			return;
		byte* ptr = (byte*)obj + offset;
		*((byte*)ptr) = value;
	}

	byte GetByteValue(void* obj)
	{
		if((fieldType != RTTIType.Byte && fieldType != RTTIType.UByte) || (flags & SymbolFlags.Static) != 0)
			return 0;
		byte* ptr = (byte*)obj + offset;
		return *((byte*)ptr);
	}

	void SetShortValue(void* obj, short value)
	{
		if((fieldType != RTTIType.Short && fieldType != RTTIType.UShort) || (flags & SymbolFlags.Static) != 0)
			return;
		byte* ptr = (byte*)obj + offset;
		*((short*)ptr) = value;
	}

	short GetShortValue(void* obj)
	{
		if((fieldType != RTTIType.Short && fieldType != RTTIType.UShort) || (flags & SymbolFlags.Static) != 0)
			return 0;
		byte* ptr = (byte*)obj + offset;
		return *((short*)ptr);
	}

	void SetIntValue(void* obj, int value)
	{
		if((fieldType != RTTIType.Int && fieldType != RTTIType.UInt) || (flags & SymbolFlags.Static) != 0)
			return;
		byte* ptr = (byte*)obj + offset;
		*((int*)ptr) = value;
	}

	int GetIntValue(void* obj)
	{
		if((fieldType != RTTIType.Int && fieldType != RTTIType.UInt) || (flags & SymbolFlags.Static) != 0)
			return 0;
		byte* ptr = (byte*)obj + offset;
		return *((int*)ptr);
	}

	void SetLongValue(void* obj, long value)
	{
		if((fieldType != RTTIType.Long && fieldType != RTTIType.ULong) || (flags & SymbolFlags.Static) != 0)
			return;
		byte* ptr = (byte*)obj + offset;
		*((long*)ptr) = value;
	}

	long GetLongValue(void* obj)
	{
		if((fieldType != RTTIType.Long && fieldType != RTTIType.ULong) || (flags & SymbolFlags.Static) != 0)
			return 0;
		byte* ptr = (byte*)obj + offset;
		return *((long*)ptr);
	}

	void SetFloatValue(void* obj, float value)
	{
		if(fieldType != RTTIType.Float || (flags & SymbolFlags.Static) != 0)
			return;
		byte* ptr = (byte*)obj + offset;
		*((float*)ptr) = value;
	}

	float GetFloatValue(void* obj)
	{
		if(fieldType != RTTIType.Float || (flags & SymbolFlags.Static) != 0)
			return 0;
		byte* ptr = (byte*)obj + offset;
		return *((float*)ptr);
	}

	void SetDoubleValue(void* obj, double value)
	{
		if(fieldType != RTTIType.Double || (flags & SymbolFlags.Static) != 0)
			return;
		byte* ptr = (byte*)obj + offset;
		*((double*)ptr) = value;
	}

	double GetDoubleValue(void* obj)
	{
		if(fieldType != RTTIType.Double || (flags & SymbolFlags.Static) != 0)
			return 0;
		byte* ptr = (byte*)obj + offset;
		return *((double*)ptr);
	}

	void SetPointerValue(void* obj, void *value)
	{
		if(!fieldType.IsPointer() || (flags & SymbolFlags.Static) != 0)
			return;
		byte *ptr = (byte*)obj + offset;
		*((void**)ptr) = value;
	}

	void* GetPointerValue(void* obj)
	{
		if(!fieldType.IsPointer() || (flags & SymbolFlags.Static) != 0)
			return null;
		byte *ptr = (byte*)obj + offset;
		return *((void**)ptr);
	}

	void SetObjectValue(void* obj, object value)
	{
		if(fieldType.IsClass() || (flags & SymbolFlags.Static) != 0)
		{
			byte *ptr = (byte*)obj + offset;
			*((object**)ptr) = value;
		}
	}

	object GetObjectValue(void* obj)
	{
		if(!fieldType.IsClass() || (flags & SymbolFlags.Static) != 0)
			return null;		
		byte *ptr = (byte*)obj + offset;
		return *((object**)ptr);
	}
}

