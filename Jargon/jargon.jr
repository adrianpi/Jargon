	RTTIPointerType constructor(RTTIType elemType)
	{
		base(SymbolType.Pointer, SymbolFlags.None, string.format("%s*", elemType.name));
		this.elementType = elemType;
		return this;
	}
}

class RTTIArrayType : RTTIType
