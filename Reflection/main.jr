using jargon;

// This example demonstrates how to use the RTTI Reflection API to inspect types
// and invoke functions.

struct Point
{
	[Internal]
	int x;
	int y;
}

const int TRUE = 1;
const int FALSE = 0;
const float PI = 3.141592f;

[Description("Returns int")]
int testSum(int a, int b)
{
	return a + b;
}

[Description("Returns float")]
float testSum2(float a, float b)
{
	return a + b;
}

[Serializable]
[Reflectable(true)]
[Description("This is a test class for reflection")]
class TestClass
{
	int a = 5;
	[Order(100)]
	int b = 2;

	[Serializable]
	int get A() => a;
	void set A(int value) { a = value; }

	static int get VAL() => 99;

	[Command("Do Foo")]
	void foo()
	{
		println("foo(): %d", a + b);
	}
}

[TestAttrib]
template class Templ<T>
{
	T field;
}

int start()
{
	// Get jargon module
	RTTIModule module = RTTIModule.GetModule("jargon");

	// Get an enum type and its values
	RTTIEnumType eSeekPos = module.GetEnum("SeekPos");
	RTTIEnumValue evStart = eSeekPos.GetValue("Start");
	RTTIEnumValue evCurrent = eSeekPos.GetValue("Current");
	RTTIEnumValue evEnd = eSeekPos.GetValue("End");
	println("SeekPos.Start is %d", evStart.value);
	println("SeekPos.Current is %d", evCurrent.value);
	println("SeekPos.End is %d", evEnd.value);
	println("SeekPos.End Parse: %d", eSeekPos.Parse("End"));
	println("SeekPos.End Stringify: %s", eSeekPos.Stringify(evEnd.value));

	// Get this module
	RTTIModule module2 = RTTIModule.GetModule("Reflection");

	// Get some constants
	RTTIConstant kTrue = module2.GetConstant("TRUE");
	println("TRUE is %d", kTrue.value.i);
	RTTIConstant kFalse = module2.GetConstant("FALSE");
	println("FALSE is %d", kFalse.value.i);
	RTTIConstant kPI = module2.GetConstant("PI");
	println("PI is %f", kPI.value.f);

	// Get Point struct info and fields
	RTTIStructType sPoint = module2.GetStruct("Point");
	RTTIField fX = sPoint.GetField("x");
	RTTIField fY = sPoint.GetField("y");
	println("Point size:%d align:%d", sPoint.size, sPoint.alignment);
	println("Point.x offset:%d index:%d", fX.offset, fX.index);
	println("Point.y offset:%d index:%d", fY.offset, fY.index);

	// Get testSum function and invoke it	
	RTTIFunction fTestSum = module2.GetFunction("testSum");
	//int (*pfTestSum)(int a, int b) = fTestSum.address;
	//int result = pfTestSum(30, 3);
	//NOTE: For simple arguments we can use the variadic call
	int result = fTestSum.Call(30, 3);
	println("testSum(30,3) is %d", result);

	RTTIFunction fTestSum2 = module2.GetFunction("testSum2");
	// For float args we need the proper signature
	float (*pfTestSum2)(float a, float b) = fTestSum2.address;
	float result2 = pfTestSum2(30.0f, 3.0f);
	println("testSum2(30.0, 3.0) is %f", result2);

	// Get TestClass info and create an instance
	RTTIClassType cTest = RTTIType.GetType("TestClass") as RTTIClassType;
	object* (*testCreator)() = cTest.GetCreator().address;
	object* test = testCreator();

	println("TestClass name: %s", cTest.name);
	println("TestClass base: %s", cTest.baseClass.name);

	// Get foo method and invoke it
	RTTIMethod mFoo = cTest.GetMethod("foo");
	RTTIFunction fFoo = mFoo.function;
	void (*pfFoo)(TestClass _this) = fFoo.address;

	pfFoo(test);

	// Get property A and set its value
	RTTIProperty pA = cTest.GetProperty("A");
	pA.SetIntValue(test, 7);

	// Get field b and set its value
	RTTIField fB = cTest.GetField("b");
	fB.SetIntValue(test, 3);

	// Invoke the method again using variadic form
	mFoo.function.Call(test);

	// Get value from a static property ('this' param is ignored)
	println("TestClass.VAL %d", cTest.GetProperty("VAL").GetIntValue(null));

	// Custom Attributes - There are for illustration purposes only, 
	// they don't do anything in this example nor have special meaning.

	println("TestClass attributes: %s", cTest.GetAttributes().join(", "));
	println("TestClass has Serializable: %d", cTest.HasAttribute("Serializable"));
	println("TestClass Reflectable: %d", cTest.GetAttributeBool("Reflectable"));
	println("TestClass Description: \'%s\'", cTest.GetAttributeString("Description"));
	println("TestClass::foo Command: \'%s\'", mFoo.GetAttributeString("Command"));
	println("TestClass Property A Serializable %d", pA.GetAttributeBool("Serializable"));
	println("TestClass Field b Order %d", fB.GetAttributeInt("Order"));
	println("testSum Description: \'%s\'", fTestSum.GetAttributeString("Description"));
	println("testSum2 Description: \'%s\'", fTestSum2.GetAttributeString("Description"));

	Templ<int> intT = new Templ<int>();

	RTTIClassType cTempl = RTTIType.GetType("Templ_int") as RTTIClassType;
	println("Templ<int> TestAttrib: %d", cTempl.GetAttributeBool("TestAttrib"));

	return 0;
}
