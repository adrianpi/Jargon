using jargon;

// TypeInfo.jr - Module serialization and deserialization for Jargon compiler
// This file contains utilities for reading/writing type information to/from binary format,
// including parsing PE file sections and serializing module metadata.

// BinaryReader - Utility class for reading primitive types from a byte buffer
// Reads data in little-endian format
class BinaryReader
{
    array<byte> buffer;  // Internal byte buffer to read from
    int pos = 0;         // Current read position in the buffer

    // Constructor - Initializes the reader with the given byte buffer
    BinaryReader constructor(array<byte> buff)
    {
        base();
        this.buffer = buff;
        return this;
    }

    // Reads a single byte from the buffer and advances position
    byte readByte()
    {
        return buffer[pos++];
    }

    // Reads a 16-bit short value in little-endian format
    short readShort()
    {
        ubyte b1 = buffer[pos++];
        ubyte b2 = buffer[pos++];
        return (short)(b1 | (b2 << 8));
    }

    // Reads a 32-bit integer value in little-endian format
    int readInt()
    {
        ubyte b1 = buffer[pos++];
        ubyte b2 = buffer[pos++];
        ubyte b3 = buffer[pos++];
        ubyte b4 = buffer[pos++];

        return b1 | (b2 << 8) | (b3 << 16) | (b4 << 24);
    }

    // Reads a 64-bit long value by reading two 32-bit integers
    long readLong()
    {
        ulong l = readUInt();
        l = l | ((ulong)readUInt() << 32U);
        return l;
    }

    // Reads an unsigned 32-bit integer value in little-endian format
    uint readUInt()
    {
        ubyte b1 = buffer[pos++];
        ubyte b2 = buffer[pos++];
        ubyte b3 = buffer[pos++];
        ubyte b4 = buffer[pos++];

        return b1 | (b2 << 8) | (b3 << 16) | (b4 << 24);
    }

    // Reads an unsigned 64-bit long value by reading two 32-bit unsigned integers
    ulong readULong()
    {
        ulong l = readUInt();
        l = l | ((ulong)readUInt() << 32U);
        return l;
    }

    // Reads a null-terminated string from the buffer
    string readString()
    {
        string str = "";
        byte c = buffer[pos++];
        while(c != 0)  // Read until null terminator
        {
            str = str + c;
            c = buffer[pos++];
        }
        return str;
    }

    // Reads a 32-bit floating point value using pointer reinterpretation
    float readFloat()
    {
        int i = readInt();
        float f = *(float*)&i;  // Reinterpret int bits as float
        return f;
    }

    // Reads a 64-bit double precision floating point value using pointer reinterpretation
    double readDouble()
    {
        ulong ul = readULong();
        double d = *(double*)&ul;  // Reinterpret ulong bits as double
        return d;
    }
}

// BinaryWriter - Utility class for writing primitive types to a byte buffer
// Writes data in little-endian format
class BinaryWriter
{
    array<byte> buffer;  // Internal byte buffer to write to

    // Constructor - Initializes the writer with the given byte buffer
    BinaryWriter constructor(array<byte> buff)
    {
        base();
        this.buffer = buff;
        return this;
    }

    // Writes a single byte to the buffer
    void writeByte(byte value)
    {
        buffer.add(value);
    }

    // Writes a 16-bit short value in little-endian format
    void writeShort(short value)
    {
        buffer.add((byte)(value & 0xff));
        buffer.add((byte)((value >> 8) & 0xff));
    }

    // Writes a 32-bit integer value in little-endian format
    void writeInt(int value)
    {
        buffer.add((value & 0xff));
        buffer.add(((value >> 8) & 0xff));
        buffer.add(((value >> 16) & 0xff));
        buffer.add(((value >> 24) & 0xff));
    }

    // Writes a 64-bit long value as two 32-bit integers
    void writeLong(long value)
    {
        writeInt(value & 0xffffffff);
        writeInt(value >> 32);
    }

    // Writes a null-terminated string to the buffer
    void writeString(string value)
    {
        for(int i = 0; i < value.length; ++i)
            buffer.add(value[i]);
        buffer.add(0);  // Null terminator
    }

    // Writes a 32-bit floating point value by writing its raw bytes
    void writeFloat(float value)
    {
        byte* b = (byte*)&value;
        for(int i = 0; i < 4; ++i)
            buffer.add(b[i]);
    }

    // Writes a 64-bit double precision floating point value by writing its raw bytes
    void writeDouble(double value)
    {
        byte* b = (byte*)&value;
        for(int i = 0; i < 8; ++i)
            buffer.add(b[i]);
    }
}

// TypeInfo - Main class for module serialization and deserialization
// Handles writing module metadata to binary format and reading it back,
// including support for extracting metadata from PE file sections
class TypeInfo
{
    // Recursively writes type information to the binary writer
    // Handles primitive types, pointers, arrays, and user-defined types (structs/classes)
    static void WriteType(BinaryWriter bw, TypeSymbol type)
    {
        if(type == null)
        {
            bw.writeByte((byte)TypeCode.None);
            return;
        }

        if(type.IsEnum())
        {
            bw.writeByte((byte)TypeCode.Enum);
            bw.writeString(type.Name);
            return;
        }

        bw.writeByte((byte)type.TypeCode);
        if(type.TypeCode == TypeCode.Pointer)
        {
            WriteType(bw, type.ElementType);
        }
        else if(type.TypeCode == TypeCode.Array)
        {
            bw.writeInt((int)(type as ArrayType).ArraySize);
            WriteType(bw, type.ElementType);
        }
        else if(type.TypeCode == TypeCode.Struct)
        {
            bw.writeString(type.Name);
        }
        else if(type.TypeCode == TypeCode.Function)
        {
            WriteType(bw, (type as Function).ReturnType);
            bw.writeInt((int)type.Flags);
            bw.writeShort((short)(type as Function).Parameters.count);
            for(int i = 0; i < (type as Function).Parameters.count; ++i)
                WriteType(bw, ((type as Function).Parameters[i] as LocalVariable).DataType);
        }
    }

    static void WriteAttributes(BinaryWriter bw, Symbol s)
    {
        if((s.Flags & SymbolFlags.HasAttributes) != 0)
        {
            for(int i = 0; i < s.attributes.count; ++i)
            {
                string attr = s.attributes[i];
                bw.writeString(attr);
            }
            bw.writeString("");
        }
    }

    // Serializes a module and all its symbols to binary format
    // Writes constants, enums, functions, structs, classes, and templates
    static void Write(array<byte> buffer, Module m)
    {
        BinaryWriter bw = new BinaryWriter(buffer);

        // Write module header
        bw.writeByte((int)SymbolType.Module);
        bw.writeInt((int)0x01010000);  // Version number
        bw.writeString(m.Name);

        //foreach(var u in m.Usings)
        for(int i = 0; i < m.Usings.count; ++i)
        {
            ModuleUsing u = m.Usings[i];
            bw.writeString(u.Name);
        }
        bw.writeString("");

        ConstantExpression cexpr = null;

        // Forward declarations
        for(int i = 0; i < m.Children.count; ++i)
        {
            Symbol c = m.Children[i];
            if(c is ClassType)
            {
                bw.writeByte((int)SymbolType.Class);
                bw.writeString(c.Name);                
            }
        }
        bw.writeByte(0);

        // Iterate through all module children and serialize non-external symbols
        for(int i = 0; i < m.Children.count; ++i)
        {
            Symbol c = m.Children[i];

            if ((c.Flags & SymbolFlags.External) == 0)  // Skip external symbols
            {
                // Write constant values with their type-specific data
                if(c.SymbolType == SymbolType.Constant)
                {
                    cexpr = (c as ConstantValue).Value as ConstantExpression;
                    if (cexpr != null)
                    {
                        bw.writeByte(c.SymbolType);
                        bw.writeShort(c.Flags);
                        WriteType(bw, c.DataType);
                        bw.writeString(c.Name);
                        // Write the constant value based on its type
                        if (cexpr.DataType.TypeCode == TypeCode.Bool)
                            bw.writeByte((byte)cexpr.value);
                        else if (cexpr.DataType.TypeCode == TypeCode.Byte || cexpr.DataType.TypeCode == TypeCode.UByte)
                            bw.writeByte((byte)cexpr.value);
                        else if (cexpr.DataType.TypeCode == TypeCode.Short || cexpr.DataType.TypeCode == TypeCode.UShort)
                            bw.writeShort((short)cexpr.value);
                        else if (cexpr.DataType.TypeCode == TypeCode.Int || cexpr.DataType.TypeCode == TypeCode.UInt)
                            bw.writeInt(cexpr.value);
                        else if (cexpr.DataType.TypeCode == TypeCode.Long || cexpr.DataType.TypeCode == TypeCode.ULong)
                            bw.writeLong(cexpr.value64);
                        else if (cexpr.DataType.TypeCode == TypeCode.Float)
                            bw.writeFloat(cexpr.fValue);
                        else if (cexpr.DataType.TypeCode == TypeCode.Double)
                            bw.writeDouble(cexpr.dValue);
                    }
                }
                // Write enum types and their values
                if(c.SymbolType == SymbolType.Enum)
                {
                    bw.writeByte(c.SymbolType);
                    bw.writeShort(c.Flags);
                    WriteAttributes(bw, c);
                    WriteType(bw, (c as EnumType).ElementType);
                    bw.writeString(c.Name);
                    // Write all enum values
                    for(int j = 0; j < c.Children.count; ++j)
                    {
                        Symbol cc = c.Children[j];
                        EnumValue ev = cc as EnumValue;
                        if (ev != null) 
                        {
                            bw.writeByte(cc.SymbolType);
                            bw.writeShort(cc.Flags);
                            bw.writeString(cc.Name);
                            bw.writeLong(ev.Value);
                        }
                    }
                    bw.writeByte(0);  // End of enum values marker
                }
                // Write function definitions including parameters
                else if(c.SymbolType == SymbolType.Function)
                {
                    bw.writeByte(c.SymbolType);
                    bw.writeShort(c.Flags);
                    WriteAttributes(bw, c);
                    WriteType(bw, (c as Function).ReturnType);
                    bw.writeString(c.Name);
                    // Write verbatim code if present (for external functions)
                    if ((c as Function).Verbatim != null)
                        bw.writeString((c as Function).Verbatim);
                    else
                        bw.writeString("");
                    // Write all function parameters
                    for(int j = 0; j < (c as Function).Parameters.count; ++j)
                    {
                        LocalVariable p = (c as Function).Parameters[j];
                        bw.writeByte(p.SymbolType);
                        bw.writeShort(p.Flags);
                        WriteType(bw, p.DataType);
                        bw.writeString(p.Name);
                        bw.writeByte(p.Offset);
                    }
                    bw.writeByte(0);  // End of parameters marker
                }
                // Write struct definitions including fields
                else if(c.SymbolType == SymbolType.Struct)
                {
                    bw.writeByte(c.SymbolType);
                    bw.writeShort(c.Flags);
                    WriteAttributes(bw, c);
                    bw.writeString(c.Name);
                    bw.writeShort((c as StructType).Size);
                    bw.writeShort((c as StructType).Alignment);
                    // Write all struct fields
                    for(int j = 0; j < c.Children.count; ++j)
                    {
                        FieldSymbol fs = c.Children[j] as FieldSymbol;
                        if (fs != null)
                        {
                            bw.writeByte(fs.SymbolType);
                            bw.writeShort(fs.Flags);
                            WriteAttributes(bw, fs);
                            WriteType(bw, fs.DataType);
                            bw.writeString(fs.Name);
                            bw.writeShort(fs.Offset);
                            bw.writeShort(fs.Index);
                        }
                    }
                    bw.writeByte(0);  // End of fields marker
                }
                // Write class definitions including fields, methods, and properties
                else if(c.SymbolType == SymbolType.Class)
                {
                    ClassType cls = (ClassType)c;
                    bw.writeByte(c.SymbolType);
                    bw.writeShort(c.Flags);
                    WriteAttributes(bw, c);
                    bw.writeString(c.Name);
                    WriteType(bw, cls.BaseClass);
                    bw.writeShort(cls.Size);
                    bw.writeShort(cls.FieldCount);
                    // Write all class members (constants, fields, methods, properties)
                    for(int j = 0; j < c.Children.count; ++j)
                    {
                        Symbol cc = c.Children[j];
                        ConstantValue cv = cc as ConstantValue;
                        FieldSymbol fs = cc as FieldSymbol;
                        MethodSymbol mthd = cc as MethodSymbol;
                        PropertySymbol ps = cc as PropertySymbol;
                        // Write class constant members
                        if(cv != null)
                        {
                            cexpr = cv.Value as ConstantExpression;
                            if (cexpr != null)
                            {
                                bw.writeByte(cc.SymbolType);
                                bw.writeShort(cc.Flags);
                                WriteType(bw, cc.DataType);
                                bw.writeString(cc.Name);
                                // Write constant value based on type
                                if (cexpr.DataType.TypeCode == TypeCode.Bool)
                                    bw.writeByte((byte)cexpr.value);
                                else if (cexpr.DataType.TypeCode == TypeCode.Byte || cexpr.DataType.TypeCode == TypeCode.UByte)
                                    bw.writeByte((byte)cexpr.value);
                                else if (cexpr.DataType.TypeCode == TypeCode.Short || cexpr.DataType.TypeCode == TypeCode.UShort)
                                    bw.writeShort((short)cexpr.value);
                                else if (cexpr.DataType.TypeCode == TypeCode.Int || cexpr.DataType.TypeCode == TypeCode.UInt)
                                    bw.writeInt(cexpr.value);
                                else if (cexpr.DataType.TypeCode == TypeCode.Long || cexpr.DataType.TypeCode == TypeCode.ULong)
                                    bw.writeLong(cexpr.value64);
                                else if (cexpr.DataType.TypeCode == TypeCode.Float)
                                    bw.writeFloat(cexpr.fValue);
                                else if (cexpr.DataType.TypeCode == TypeCode.Double)
                                    bw.writeDouble(cexpr.dValue);
                            }
                        }
                        // Write class field members
                        else if (fs != null)
                        {
                            bw.writeByte(cc.SymbolType);
                            bw.writeShort(cc.Flags);
                            WriteAttributes(bw, cc);
                            WriteType(bw, fs.DataType);
                            bw.writeString(cc.Name);
                            bw.writeShort(fs.Offset);
                            bw.writeShort(fs.Index);
                        }
                        // Write class method members
                        else if (mthd != null)
                        {
                            bw.writeByte(cc.SymbolType);
                            bw.writeShort(cc.Flags);
                            WriteAttributes(bw, cc);
                            bw.writeString(cc.Name);
                            Function fn = mthd.GetFunction();
                            string tname = string.format("%s__%s", cls.Name, mthd.Name);
                            // Write function name if it differs from default naming
                            if(fn.Name != tname)
                                bw.writeString(fn.Name);
                            else
                                bw.writeString("");
                            bw.writeShort(mthd.VSlot);         // Virtual table slot
                        }
                        // Write class property members
                        else if (ps != null)
                        {
                            bw.writeByte(cc.SymbolType);
                            bw.writeShort(cc.Flags);
                            WriteAttributes(bw, cc);
                            WriteType(bw, ps.DataType);
                            bw.writeString(cc.Name);
                            byte getset = 0;
                            if (ps.Getter != null)
                                getset |= 1;  // Bit 0: has getter
                            if (ps.Setter != null)
                                getset |= 2;  // Bit 1: has setter
                            bw.writeByte(getset);
                        }
                    }

                    bw.writeByte(0);  // End of class members marker
                    // Write virtual method table
                    for(int j = 0; j < (c as ClassType).VirtualMethods.count; ++j)
                    {
                        MethodSymbol vm = (c as ClassType).VirtualMethods[j];
                        if (vm != null) 
                            bw.writeString(vm.Name);
                    }
                    bw.writeString("");  // End of virtual methods marker
                }
                // Write template definitions
                else if(c.SymbolType == SymbolType.Template)
                {
                    bw.writeByte(c.SymbolType);
                    bw.writeShort(c.Flags);
                    WriteAttributes(bw, c);
                    bw.writeString(c.Name);
                    // Write template parameter names
                    for(int j = 0; j < (c as Template).TemplateParams.count; ++j)
                        bw.writeString((c as Template).TemplateParams[j]);
                    bw.writeString("");  // End of template parameters
                    bw.writeString(((c as Template).Source));  // Template source code
                }
            }
        }
        bw.writeByte(0);  // End of module symbols marker
    }

    // Reads a PE file section by name and returns its raw data
    // Used to extract the .module section containing type information
    static array<byte> GetSectionData(string filePath, string sectionName)
    {
        file f = file.open(filePath.c_str(), "rb");
        if(f == null)
            return null;

        // Verify DOS header ("MZ" signature)
        ushort dosHeader;
        f.read(&dosHeader, sizeof(ushort));
        if(dosHeader != 0x5A4D)  // "MZ" magic number
            return null;

        // Get offset to NT header from DOS stub
        f.seek(0x3c, SeekPos.Start);
        int ntOffset;
        f.read(&ntOffset, sizeof(int));

        // Verify NT header ("PE\0\0" signature)
        int ntHeader;
        f.seek(ntOffset, SeekPos.Start);
        f.read(&ntHeader, sizeof(int));
        if(ntHeader != 0x00004550)  // "PE\0\0" magic number
            return null;

        // Read IMAGE_FILE_HEADER fields
        f.seek(2, SeekPos.Current); // Skip Machine field
        ushort numSections;
        f.read(&numSections, sizeof(ushort));  // Number of sections
        f.seek(4, SeekPos.Current); // Skip Timestamp
        f.seek(4, SeekPos.Current); // Skip PointerToSymbolTable
        f.seek(4, SeekPos.Current); // Skip NumberOfSymbols
        ushort sizeOfOptionalHeader;
        f.read(&sizeOfOptionalHeader, sizeof(ushort));
        f.seek(2, SeekPos.Current); // Skip Characteristics

        // Skip optional header to reach section headers
        // Skip optional header to reach section headers
        f.seek(sizeOfOptionalHeader, SeekPos.Current);

        // Parse section headers to find the requested section
        for (ushort i = 0; i < numSections; i++)
        {
            // Read section name (8 bytes, null-padded)
            byte nameBytes[9];
            f.read(nameBytes, 8);
            nameBytes[8] = 0;  // Ensure null termination
            string secName = new string(nameBytes);
            // Read section header fields
            uint virtualSize;
            uint virtualAddress;
            uint sizeOfRawData;
            uint pointerToRawData;
            f.read(&virtualSize, sizeof(uint));
            f.read(&virtualAddress, sizeof(uint));
            f.read(&sizeOfRawData, sizeof(uint));
            f.read(&pointerToRawData, sizeof(uint));

            f.seek(16, SeekPos.Current);  // Skip remaining section header fields

            // If this is the requested section, read its data
            if(secName == sectionName)
            {
                array<byte> buffer = new array<byte>();
                f.seek(pointerToRawData, SeekPos.Start);  // Seek to section data
                // Read all section bytes
                for(int i = 0; i < virtualSize; i++)
                {
                    byte b;
                    f.read(&b, sizeof(byte));
                    buffer.add(b);
                }
                return buffer;
            }
        }
        return null;  // Section not found
    }

    // Recursively reads type information from the binary reader
    // Returns the appropriate TypeSymbol based on the TypeCode
    static TypeSymbol ReadType(BinaryReader br, Module module)
    {
        TypeCode tc = (TypeCode)br.readByte();
        if(tc == TypeCode.Enum)
        {
            string name = br.readString();
            TypeSymbol ts = module.Find(name) as TypeSymbol;
            if(ts == null)
            {
                for(int i = 0; i < module.Usings.count; ++i)
                {
                    ModuleUsing u = module.Usings[i];
                    ts = u.Module.Find(name) as TypeSymbol;
                    if (ts != null)
                        return ts;
                }
                assert(false);
                return null;
            }
            return ts;
        }
        if (tc == TypeCode.None)
            return null;
        // Return built-in primitive type symbols
        else if (tc == TypeCode.Void)
            return TypeSymbol.Void;
        else if (tc == TypeCode.Bool)
            return TypeSymbol.Bool;
        else if (tc == TypeCode.Byte)
            return TypeSymbol.Byte;
        else if (tc == TypeCode.UByte)
            return TypeSymbol.UByte;
        else if (tc == TypeCode.Short)
            return TypeSymbol.Short;
        else if (tc == TypeCode.UShort)
            return TypeSymbol.UShort;
        else if (tc == TypeCode.Int)
            return TypeSymbol.Int;
        else if (tc == TypeCode.UInt)
            return TypeSymbol.UInt;
        else if (tc == TypeCode.Long)
            return TypeSymbol.Long;
        else if (tc == TypeCode.ULong)
            return TypeSymbol.ULong;
        else if (tc == TypeCode.Float)
            return TypeSymbol.Float;
        else if (tc == TypeCode.Double)
            return TypeSymbol.Double;
        // Handle pointer types - recursively read the pointed-to type
        else if(tc == TypeCode.Pointer)
        {
            TypeSymbol t = ReadType(br, module);
            PointerType ptrt = t.GetPointerType();
            if(t is Function)
            {
                ptrt.StrongElementType = t;
            }
            return ptrt;
        }
        // Handle array types - read size and element type
        else if(tc == TypeCode.Array)
        {
            int sz = br.readInt();
            TypeSymbol t = ReadType(br, module);
            return t.GetArrayType(sz);
        }
        // Handle user-defined types (structs/classes) - lookup by name
        else if(tc == TypeCode.Struct)
        {
            string name = br.readString();
            TypeSymbol ts = module.Find(name) as TypeSymbol;
            if(ts == null)
            {
                for(int i = 0; i < module.Usings.count; ++i)
                {
                    ModuleUsing u = module.Usings[i];
                    ts = u.Module.Find(name) as TypeSymbol;
                    if (ts != null)
                        return ts;
                }
                assert(false);
                return null;
            }
            return ts;
        }
        else if(tc == TypeCode.Function)
        {
            TypeSymbol retType = ReadType(br, module);
            int flags = br.readInt();
            int paramCount = br.readShort();
            array<TypeSymbol> paramTypes = new array<TypeSymbol>();
            for(int i = 0; i < paramCount; ++i)
                paramTypes.add(ReadType(br, module));
            Function fn = new Function(null, "", retType);
            fn.Flags = flags;
            for(int i = 0; i < paramTypes.count; ++i)
                fn.Parameters.add(new LocalVariable(fn, string.format("p%d", i), paramTypes[i], null));
            return fn;
        }
        else
        {
            return null;  // Unknown type code
        }
    }

    static array<string> libSearchPaths = new array<string>();

    static void AddLibSearchPath(string path)
    {
        libSearchPaths.add(path);
    }

    static string LocateDLL(string dllName, string parentPath)
    {
        string dllpath = parentPath + "\\" + dllName + ".dll";
        if(file.exists(dllpath))
            return dllpath;
        for(int i = 0; i < libSearchPaths.count; ++i)
        {
            dllpath = libSearchPaths[i] + "\\" + dllName + ".dll";
            if(file.exists(dllpath))
                return dllpath;
        }
        return null;
    }

    static array<string> ReadAttributes(BinaryReader br, int flags)
    {
        if((flags & SymbolFlags.HasAttributes) != 0)
        {
            array<string> attrs = new array<string>();
            string attr = br.readString();
            while(attr != "")
            {
                attrs.add(attr);
                attr = br.readString();
            }
            return attrs;
        }
        return null;
    }

    // Parses a module from a compiled DLL file by reading the .module PE section
    // Deserializes all symbols and reconstructs the module's symbol table
    static Module ParseModule(string filePath)
    {
        array<byte> typeInfo = GetSectionData(filePath, ".module");
        if(typeInfo == null)
            return null;

        BinaryReader br = new BinaryReader(typeInfo);
        string strEmpty = new string("");

        // Verify module header
        SymbolType st = (SymbolType)br.readByte();
        if(st != SymbolType.Module)
            return null;
        uint version = (uint)br.readInt();
        if (version != 0x01000000 && version != 0x01010000)  // Check version compatibility
            return null;
        string name = br.readString();

        Module module = new Module(name);

        // Read module usings (currently not fully implemented)
        string un = br.readString();
        while(un != strEmpty)
        {
            if(loadedModules.contains(un.toLower()))
            {
                ModuleUsing mu = new ModuleUsing(un);
                mu.Module = loadedModules[un.toLower()];
                module.Usings.add(mu);
            }
            else
            {
                string dllPath = LocateDLL(un, path.getDirectoryName(filePath));
                if(dllPath != null)
                {
                    ModuleUsing mu = new ModuleUsing(un);
                    mu.Module = ParseModule(dllPath);
                    module.Usings.add(mu);
                    loadedModules[un.toLower()] = mu.Module;
                }
                else
                {
                    println("Could not locate %s dll", un);
                    assert(false);
                }
            }
            /*var mu = new ModuleUsing(un);
            mu.Module = ParseModule(mu.Name+".dll");
            module.Usings.Add(mu);*/
            un = br.readString();
        }

        if(version == 0x01010000)
        {
            // Forward declarations
            st = (SymbolType)br.readByte();
            while(st != SymbolType.None)
            {
                if(st == SymbolType.Class)
                {
                    name = br.readString();
                    ClassType cls = new ClassType(module, name);
                }
                else
                {
                    assert(false);
                }
                st = (SymbolType)br.readByte();
            }
        }

        int flags = 0;
        st = (SymbolType)br.readByte();

        // Create maps for resolving method and property references
        dictionary<MethodSymbol, string> methodMap = new dictionary<MethodSymbol, string>();
        dictionary<PropertySymbol, string> getterMap = new dictionary<PropertySymbol, string>();
        dictionary<PropertySymbol, string> setterMap = new dictionary<PropertySymbol, string>();
        array<string> attribs = null;

        // Parse all module symbols
        while(st != SymbolType.None)
        {
            // Parse constant values
            if(st == SymbolType.Constant)
            {
                flags = br.readShort();
                TypeSymbol t = ReadType(br, module);
                name = br.readString();
                ConstantExpression cexpr = null;
                // Read constant value based on type
                if (t.TypeCode == TypeCode.Bool)
                    cexpr = ConstantExpression.FromBool(br.readByte() != 0);
                else if (t.TypeCode == TypeCode.Byte)
                    cexpr = ConstantExpression.FromByte(br.readByte());
                else if(t.TypeCode == TypeCode.UByte)
                    cexpr = ConstantExpression.FromByte(br.readByte());
                else if (t.TypeCode == TypeCode.Short)
                    cexpr = ConstantExpression.FromShort(br.readShort());
                else if (t.TypeCode == TypeCode.UShort)
                    cexpr = ConstantExpression.FromUShort(br.readShort());
                else if (t.TypeCode == TypeCode.Int)
                    cexpr = ConstantExpression.FromInt(br.readInt());
                else if (t.TypeCode == TypeCode.UInt)
                    cexpr = ConstantExpression.FromUInt(br.readInt());
                else if (t.TypeCode == TypeCode.Long)
                    cexpr = ConstantExpression.FromLong(br.readLong());
                else if (t.TypeCode == TypeCode.ULong)
                    cexpr = ConstantExpression.FromULong(br.readLong());
                else if (t.TypeCode == TypeCode.Float)
                    cexpr = ConstantExpression.FromFloat(br.readFloat());
                else if (t.TypeCode == TypeCode.Double)
                   cexpr = ConstantExpression.FromDouble(br.readDouble());
                // Create constant value symbol
                ConstantValue cv = new ConstantValue(module, name, cexpr);
                cv.Flags = (SymbolFlags)flags;
            }
            // Parse enum types and their values
            else if(st == SymbolType.Enum)
            {
                flags = br.readShort();
                attribs = ReadAttributes(br, flags);
                TypeSymbol et = ReadType(br, module);
                name = br.readString();
                EnumType enu = new EnumType(module, name, et);
                enu.Flags = (SymbolFlags)flags;
                enu.attributes = attribs;
                // Read all enum values
                SymbolType st2 = (SymbolType)br.readByte();
                while(st2 != 0)
                {
                    flags = br.readShort();
                    name = br.readString();
                    long value = br.readLong();
                    EnumValue ev = new EnumValue(enu, name, value);
                    ev.Flags = (SymbolFlags)flags;
                    st2 = (SymbolType)br.readByte();
                }
            }
            // Parse function definitions
            else if(st == SymbolType.Function)
            {
                flags = br.readShort();
                attribs = ReadAttributes(br, flags);
                TypeSymbol t = ReadType(br, module);
                name = br.readString();
                Function fn = new Function(module, name, t);
                fn.Flags = (SymbolFlags)flags;
                fn.attributes = attribs;
                fn.Verbatim = br.readString();
                if (fn.Verbatim == strEmpty)
                    fn.Verbatim = null;
                // Read all function parameters
                SymbolType st2 = (SymbolType)br.readByte();
                while(st2 != 0)
                {
                    flags = br.readShort();
                    TypeSymbol pt = ReadType(br, module);
                    name = br.readString();
                    int offs = br.readByte();
                    LocalVariable p = new LocalVariable(fn, name, pt, null);
                    p.Flags = (SymbolFlags)flags;
                    p.Offset = offs;
                    fn.Parameters.add(p);
                    st2 = (SymbolType)br.readByte();
                }
            }                 
            // Parse struct definitions
            else if(st == SymbolType.Struct)
            {
                flags = br.readShort();
                attribs = ReadAttributes(br, flags);
                name = br.readString();
                int sz = br.readShort();
                int align = br.readShort();
                StructType struc = new StructType(module, name);
                struc.Flags = (SymbolFlags)flags;
                struc.attributes = attribs;
                struc.SetSize(sz);
                struc.Alignment = align;
                // Read all struct fields
                SymbolType st2 = (SymbolType)br.readByte();
                while (st2 != 0)
                {
                    flags = br.readShort();
                    attribs = ReadAttributes(br, flags);
                    TypeSymbol ft = ReadType(br, module);
                    name = br.readString();
                    int offs = br.readShort();
                    int idx = br.readShort();
                    FieldSymbol f = new FieldSymbol(struc, name, ft);
                    f.Flags = (SymbolFlags)flags;
                    f.Offset = offs;
                    f.Index = idx;
                    f.attributes = attribs;
                    st2 = (SymbolType)br.readByte();
                }
            }
            // Parse class definitions
            else if(st == SymbolType.Class)
            {
                flags = br.readShort();
                attribs = ReadAttributes(br, flags);
                name = br.readString();
                ClassType baseType = ReadType(br, module) as ClassType;
                int csz = br.readShort();
                int fcnt = br.readShort();
                ClassType cls;
                if(version == 0x01010000)
                    cls = module.Find(name) as ClassType;
                else
                    cls = new ClassType(module, name);
                assert(cls != null);
                cls.Flags = (SymbolFlags)flags;
                cls.attributes = attribs;
                cls.BaseClass = baseType;
                cls.SetSize(csz);
                cls.FieldCount = fcnt;
                // Read all class members (constants, fields, methods, properties)
                SymbolType st2 = (SymbolType)br.readByte();
                while (st2 != 0)
                {
                    if(st2 == SymbolType.Constant)
                    {
                        flags = br.readShort();
                        TypeSymbol t = ReadType(br, module);
                        name = br.readString();
                        ConstantExpression cexpr = null;
                        if (t.TypeCode == TypeCode.Bool)
                            cexpr = ConstantExpression.FromBool(br.readByte() != 0);
                        else if (t.TypeCode == TypeCode.Byte)
                            cexpr = ConstantExpression.FromByte(br.readByte());
                        else if(t.TypeCode == TypeCode.UByte)
                            cexpr = ConstantExpression.FromByte(br.readByte());
                        else if (t.TypeCode == TypeCode.Short)
                            cexpr = ConstantExpression.FromShort(br.readShort());
                        else if (t.TypeCode == TypeCode.UShort)
                            cexpr = ConstantExpression.FromUShort(br.readShort());
                        else if (t.TypeCode == TypeCode.Int)
                            cexpr = ConstantExpression.FromInt(br.readInt());
                        else if (t.TypeCode == TypeCode.UInt)
                            cexpr = ConstantExpression.FromUInt(br.readInt());
                        else if (t.TypeCode == TypeCode.Long)
                            cexpr = ConstantExpression.FromLong(br.readLong());
                        else if (t.TypeCode == TypeCode.ULong)
                            cexpr = ConstantExpression.FromULong(br.readLong());
                        else if (t.TypeCode == TypeCode.Float)
                            cexpr = ConstantExpression.FromFloat(br.readFloat());
                        else if (t.TypeCode == TypeCode.Double)
                           cexpr = ConstantExpression.FromDouble(br.readDouble());
                        ConstantValue cv = new ConstantValue(cls, name, cexpr);
                        cv.Flags = (SymbolFlags)flags;
                    }
                    if(st2 == SymbolType.Field)
                    {
                        flags = br.readShort();
                        attribs = ReadAttributes(br, flags);
                        TypeSymbol ft = ReadType(br, module);
                        name = br.readString();
                        int offs = br.readShort();
                        int idx = br.readShort();
                        FieldSymbol field = new FieldSymbol(cls, name, ft);
                        field.Flags = (SymbolFlags)flags;
                        // flag static fields as External when importing a class for static fields to work
                        if((field.Flags & SymbolFlags.Static) != 0)
                            field.Flags += SymbolFlags.External;                
                        field.Offset = offs;
                        field.Index = idx;
                        field.attributes = attribs;
                    }
                    else if(st2 == SymbolType.Method)                    
                    {
                        flags = br.readShort();
                        attribs = ReadAttributes(br, flags);
                        name = br.readString();
                        string fname = br.readString();
                        if(fname.length == 0) // If empty, use default naming
                            fname = string.format("%s__%s", cls.Name, name);
                        int vslot = br.readShort();
                        MethodSymbol mi = new MethodSymbol(cls, name, null);
                        mi.Flags = (SymbolFlags)flags;
                        mi.VSlot = vslot;
                        methodMap[mi] = fname;
                        mi.attributes = attribs;
                    }
                    else if(st2 == SymbolType.Property)
                    {
                        flags = br.readShort();
                        attribs = ReadAttributes(br, flags);
                        TypeSymbol pt = ReadType(br, module);
                        name = br.readString();
                        PropertySymbol prop = new PropertySymbol(cls, name, pt);
                        byte getset = br.readByte();
                        if((getset & 1) != 0)
                            getterMap[prop] = string.format("get_%s", name);
                        if((getset & 2) != 0)
                            setterMap[prop] = string.format("set_%s", name);
                        prop.attributes = attribs;
                    }                            
                    st2 = (SymbolType)br.readByte();
                }
                cls.VirtualMethods.clear();
                name = br.readString();
                while(name != strEmpty)
                {
                    MethodSymbol m = cls.FindChild(name) as MethodSymbol;
                    cls.VirtualMethods.add(m);
                    name = br.readString();
                }
                if (cls.VirtualMethods.count == 0)
                    cls.VirtualMethods.add(null);
            }
            else if(st == SymbolType.Template)
            {
                flags = br.readShort();
                attribs = ReadAttributes(br, flags);
                name = br.readString();
                Template tmpl = new Template(module, name);
                tmpl.Flags = (SymbolFlags)flags;
                tmpl.attributes = attribs;
                string tp = br.readString();
                while(tp != strEmpty)
                {
                    tmpl.TemplateParams.add(tp);
                    tp = br.readString();
                }
                tmpl.Source = br.readString();
            }
            st = (SymbolType)br.readByte();
        }

        array<MethodSymbol> methodKeys = methodMap.keys;
        for(int i = 0; i < methodKeys.count; ++i)
        {
            MethodSymbol m = methodKeys[i];
            Function fn = module.Find(methodMap[m]) as Function;
            m.SetFunction(fn);
        }

        array<PropertySymbol> getterKeys = getterMap.keys;
        for(int i = 0; i < getterKeys.count; ++i)
        {
            PropertySymbol p = getterKeys[i];
            MethodSymbol msym = p.Parent.Find(getterMap[p]) as MethodSymbol;
            p.Getter = msym;
        }

        array<PropertySymbol> setterKeys = setterMap.keys;
        for(int i = 0; i < setterKeys.count; ++i)
        {
            PropertySymbol p = setterKeys[i];
            MethodSymbol msym = p.Parent.Find(setterMap[p]) as MethodSymbol;
            p.Setter = msym;
        }

        return module;
    }

    static dictionary<string, Module> loadedModules = new dictionary<string, Module>();

    static void AddModule(Module module)
    {
        if(!loadedModules.contains(module.Name.toLower()))
            loadedModules[module.Name.toLower()] = module;
    }

    static void Finalize()
    {
        loadedModules.clear();
        loadedModules = null;
        libSearchPaths.clear();
        libSearchPaths = null;
    }

}
