using jargon;

// Parser2 - second stage parser responsible for resolving types, laying out
// structs/classes, registering methods/fields, and synthesizing runtime
// support such as static initialization functions and vtables. This stage
// performs semantic setup required before later passes fill in method
// bodies.
class Parser2 : StageParser
{
    Parser2 constructor(Module module, CompilerErrorListener errorListener)
    {
        base(module, errorListener);
        return this;
    }

    // OnStartParse - invoked when parsing of a new compile unit begins.
    // This stage uses the hook to create a per-unit static initializer
    // function which will be populated with static initialization actions
    // (e.g. vtable setup) as classes are discovered.
    void OnStartParse()
    {
        CreateStaticInitFunctions();
    }

    // CreateStaticInitFunctions - synthesize an internal function named
    // "static_init" that will hold static initialization code for this
    // compile unit. The function is marked internal and no-debug to indicate
    // it is generated and not intended for user debugging.
    void CreateStaticInitFunctions()
    {
        Function static_init = new Function(module, "static_init", TypeSymbol.Void);
        static_init.Body = new StatementBlock();
        static_init.Flags += SymbolFlags.Internal;
        static_init.Flags += SymbolFlags.NoDebug;

        unit.staticInit = static_init;
        static_init.Unit = unit;

        Function static_deinit = new Function(module, "static_deinit", TypeSymbol.Void);
        static_deinit.Body = new StatementBlock();
        static_deinit.Flags += SymbolFlags.Internal;
        static_deinit.Flags += SymbolFlags.NoDebug;

        unit.staticDeInit = static_deinit;
        static_deinit.Unit = unit;
    }

    // GetAlignment - compute the alignment requirement for a type. For structs,
    // the alignment is specified in the StructType symbol; for arrays, the
    // alignment is the same as the element type; for other types, the alignment
    // is the same as the type size (e.g. 4 for int32).
    static int GetAlignment(TypeSymbol type)
    {
        if (type.IsStruct())
            return (type as StructType).Alignment;
        else if(type.IsArray())
            return GetAlignment(type.ElementType);
        else
            return type.Size;   // otherwise align to the type size
    }

    // ParseStructure - complete struct/union layout by adding fields to the
    // previously-created StructType symbol. This routine reads member
    // declarations, validates disallowed constructs (like by-ref fields),
    // and computes offsets/size. For unions, all fields share offset 0 and
    // the struct size equals the largest field size.
    bool ParseStructure(bool isUnion)
    {
        if(scanner.Token != Token.Ident)
        {
            Error("Identifier expected");
            return false;
        }
        string name = scanner.TokenString;
        scanner.NextToken();
        StructType st = module.Find(name) as StructType;
        
        attributes = null;

        if(scanner.Token == Token.LBrace)
        {
            scanner.NextToken();
            while(scanner.Token != Token.RBrace && scanner.Token != Token.EOF)
            {
                if(scanner.Token == Token.LBracket)
                {
                    do
                    {
                        scanner.NextToken();
                        if(!ParseAttribute())
                            return false;
                    } while(scanner.Token == Token.LBracket);
                }

                Declaration decl = new Declaration();

                if (!ParseDeclaration(decl, true, null, false, false))
                    return false;

                // References are not allowed as struct members.
                // Report an error if a by-ref declarator was used.
                if (decl.isByRef)
                {
                    Error("Reference not allowed here");
                    return false;
                }

                // Create the FieldSymbol and compute layout information.
                FieldSymbol fs = new FieldSymbol(st, decl.name, decl.type);
                fs.Index = st.Children.count - 1;
                fs.Unit = unit;
                fs.attributes = attributes;
                if(fs.attributes != null)
                    fs.Flags += SymbolFlags.HasAttributes;
                attributes = null;
                TypeSymbol dt = fs.DataType;
                if(dt.IsClassRef())
                    fs.Flags += SymbolFlags.Weak;   // references in a struct are always weak
                                                    // as structs have no finalizers

                // Compute alignment and offsets: the alignment of a struct is the max
                // of its field alignments
                int alignment = GetAlignment(decl.type);
                st.Alignment = st.Alignment >? alignment;

                if (isUnion)
                {
                    // Union: all fields overlap at offset 0 and the struct size
                    // becomes the max of contained field sizes.
                    fs.Offset = 0;
                    fs.Index = 0;
                    st.SetSize(st.Size >? decl.type.Size);
                }
                else
                {
                    // Struct: fields are laid out sequentially with padding as needed
                    int offs = ((st.Size + alignment - 1) / alignment) * alignment;
                    fs.Offset = offs;
                    st.SetSize(offs + decl.type.Size);
                }

                if (!Expect(Token.Semicolon))
                    return false;
            }

            if (!Expect(Token.RBrace))
                    return false;

            // Final struct size is rounded up to the alignment
            int size = st.Size;
            if(size != 0 && st.Alignment != 0)
            {
                size = ((size + st.Alignment - 1) / st.Alignment) * st.Alignment;
                st.SetSize(size);
            }
            return true;
        }
        else
        {
            // Forward declaration ended with semicolon
            return Expect(Token.Semicolon);
        }
    }

    int FixPropertyVisibility(int existingFlags, int newVisibility)
    {
        // A property visibility is the less restrictive of setter and getter visibility.
        int existing = 0;
        if((existingFlags & SymbolFlags.Internal) != 0)
            existing = 1;
        else if((existingFlags & SymbolFlags.Protected) != 0)
            existing = 2;
        else if((existingFlags & SymbolFlags.Private) != 0)
            existing = 3;

        int newVis = 0;
        if((newVisibility & SymbolFlags.Internal) != 0)
            newVis = 1;
        else if((newVisibility & SymbolFlags.Protected) != 0)
            newVis = 2;
        else if((newVisibility & SymbolFlags.Private) != 0)
            newVis = 3;

        int vis = existing <? newVis;
        
        int mask = SymbolFlags.Internal | SymbolFlags.Protected | SymbolFlags.Private;
        int result = existingFlags & ~mask;

        if(vis == 1)
            result += SymbolFlags.Internal;
        else if(vis == 2)
            result += SymbolFlags.Protected;
        else if(vis == 3)
            result += SymbolFlags.Private;

        return result;
    }

    void CreateRawGetter(ClassType cls, Function fn, bool _static, bool _virtual, int visibility)
    {
        string rawName = string.format("%s__rawPtr", fn.Name);
        Function rawFn = new Function(module, string.format("%s__%s", cls.Name, rawName), TypeSymbol.Void.GetPointerType());
        rawFn.Flags += SymbolFlags.NoDebug;
        int offset = 1;
        LocalVariable _this = null;
        if(fn.Parameters.count > 0)
        {
            _this = new LocalVariable(rawFn, "_this", cls.GetPointerType(), null);
            _this.Offset = offset++;
            rawFn.Parameters.add(_this);
        }
        LocalVariable pValue = new LocalVariable(rawFn, "pValue", fn.ReturnType.GetPointerType(), null);
        pValue.Offset = offset++;
        rawFn.Parameters.add(pValue);
        unit.AddSymbol(rawFn);

        StatementBlock sb = new StatementBlock();

        FunctionCallExpression fcall = new FunctionCallExpression(new SymbolExpression(fn));
        if(fn.Parameters.count > 0)
            fcall.Arguments.add(new SymbolExpression(_this));
        AssignmentExpression assign = new AssignmentExpression(new DerefExpression(new SymbolExpression(pValue)), fcall);
        sb.Statements.add(new ExpressionStatement(assign));
        
        rawFn.Body = sb;

        MethodSymbol ms = new MethodSymbol(cls, rawName, rawFn);
        ms.Flags += visibility;

        if (_static)
        {
            ms.Flags += SymbolFlags.Static;
            rawFn.Flags += SymbolFlags.Static;
        }

        VirtualizeMethod(ms, rawFn, cls, _static, _virtual);
    }

    void CreateRawSetter(ClassType cls, Function fn, bool _static, bool _virtual, int visibility)
    {
        string rawName = string.format("%s__rawPtr", fn.Name);
        Function rawFn = new Function(module, string.format("%s__%s", cls.Name, rawName), TypeSymbol.Void.GetPointerType());
        rawFn.Flags += SymbolFlags.NoDebug;
        int offset = 1;
        LocalVariable _this = null;
        if(fn.Parameters.count > 1)
        {
            _this = new LocalVariable(rawFn, "_this", cls.GetPointerType(), null);
            _this.Offset = offset++;
            rawFn.Parameters.add(_this);
        }
        LocalVariable pValue = new LocalVariable(rawFn, "pValue", fn.Parameters[1].DataType.GetPointerType(), null);
        pValue.Offset = offset++;
        rawFn.Parameters.add(pValue);
        unit.AddSymbol(rawFn);

        StatementBlock sb = new StatementBlock();

        FunctionCallExpression fcall = new FunctionCallExpression(new SymbolExpression(fn));
        if(fn.Parameters.count > 1)
            fcall.Arguments.add(new SymbolExpression(_this));
        fcall.Arguments.add(new DerefExpression(new SymbolExpression(pValue)));
        sb.Statements.add(new ExpressionStatement(fcall));
        
        rawFn.Body = sb;

        MethodSymbol ms = new MethodSymbol(cls, rawName, rawFn);
        ms.Flags += visibility;

        if (_static)
        {
            ms.Flags += SymbolFlags.Static;
            rawFn.Flags += SymbolFlags.Static;
        }

        VirtualizeMethod(ms, rawFn, cls, _static, _virtual);
    }

    void VirtualizeMethod(MethodSymbol ms, Function fn, ClassType cls, bool _static, bool _virtual)
    {
        // Check if this method overrides a base class virtual method
        bool overridesBaseMethod = false;
        if (cls.BaseClass != null && !_static)
        {
            // Attempt to locate an overridden virtual method in the
            // base class; if found inherit its vslot index.
            MethodSymbol vm = cls.BaseClass.FindChild(fn.Name) as MethodSymbol;
            if (vm != null && (vm.Flags & SymbolFlags.Virtual) != 0)
            {
                ms.VSlot = vm.VSlot;
                cls.VirtualMethods[ms.VSlot] = ms;
                ms.Flags += SymbolFlags.Virtual;
                overridesBaseMethod = true;
            }
        }

        // If marked as virtual but doesn't override a base method,
        // assign a new VSlot
        if (_virtual && !overridesBaseMethod)
        {
            ms.Flags += SymbolFlags.Virtual;
            ms.VSlot = cls.VirtualMethods.count;
            cls.VirtualMethods.add(ms);
        }
    }

    // ParseClass - complete class layout and register methods/fields. This
    // phase wires up base classes, inherits virtual methods, creates a
    // factory function placeholder and processes member declarations. The
    // parser synthesizes helper methods (constructor, getClassName,
    // finalizer), builds the vtable global and creates an instance-init
    // method used to initialize instance fields.
    bool ParseClass()
    {
        if(scanner.Token != Token.Ident)
        {
            Error("Identifier expected");
            return false;
        }
        string name = scanner.TokenString;
        scanner.NextToken();
        ClassType cls = module.Find(name) as ClassType;
        attributes = null;
        // Optional base class specification following a ':' token
        if(scanner.Token == Token.Colon)
        {
            scanner.NextToken();
            ClassType baseClass = ParseType() as ClassType;
            if(baseClass == null)
            {
                Error("Class expected");
                return false;
            }
            // Inherit size and virtual method table entries from base class
            cls.BaseClass = baseClass;
            cls.SetSize(baseClass.Size);
            cls.FieldCount = baseClass.FieldCount;
            cls.VirtualMethods.clear();
            for(int i = 0; i < baseClass.VirtualMethods.count; ++i)
                cls.VirtualMethods.add(baseClass.VirtualMethods[i]);
        }
        else
        {
            if(cls.Name == "object")
            {
                // Root object class: create a vtable field which is a pointer
                // to a pointer (i.e. void** convention). This special field is
                // used at runtime to locate virtual methods.
                FieldSymbol vtable = new FieldSymbol(cls, "vtable", TypeSymbol.Void.GetPointerType().GetPointerType());
                vtable.Index = cls.FieldCount;
                cls.FieldCount++;
                vtable.Offset = 0;
                    cls.SetSize(8);
            }
        }        

        Function factory = cls.Factory;

        if(scanner.Token == Token.LBrace)
        {
            scanner.NextToken();

            Symbol prevScope = scope;
            scope = cls;

            while (scanner.Token != Token.RBrace && scanner.Token != Token.EOF)
            {
                if(scanner.Token == Token.LBracket)
                {
                    do
                    {
                        scanner.NextToken();
                        if(!ParseAttribute())
                            return false;
                    } while(scanner.Token == Token.LBracket);
                }

                bool _virtual = false;
                bool _static = false;
                bool _weak = false;
                bool _const = false;

                int visibility = 0;

                if(IsKeyword("public"))
                    visibility = 0;
                else if(IsKeyword("private"))
                    visibility = SymbolFlags.Private;
                else if(IsKeyword("protected"))
                    visibility = SymbolFlags.Protected;
                else if(IsKeyword("internal"))
                    visibility = SymbolFlags.Internal;

                if(IsKeyword("const"))
                {
                    _const = true;

                    if(attributes != null)
                    {
                        Error("Invalid attribute on const member");
                        return false;
                    }
                }
                else
                {
                    if (IsKeyword("virtual"))
                        _virtual = true;
                    else if (IsKeyword("static"))
                        _static = true;

                    if (IsKeyword("weak"))
                        _weak = true;
                }

                Declaration decl = new Declaration();

                // Parse the member declaration; note we pass 'true' for the
                // nameRequired flag and allow function types to be parsed but
                // do not fully validate bodies at this stage (noCheck = true).
                if (!ParseDeclaration(decl, true, null, false, true))
                {
                    scope = prevScope;
                    _class = null;
                    return false;
                }

                if (decl.isByRef)
                {
                    Error("Reference not allowed here");
                    scope = prevScope;
                    _class = null;
                    return false;
                }

                if (decl.type.IsFunction())
                {
                    // Method declaration: wrap function into a MethodSymbol
                    Function fn = (Function)decl.type as Function;
                    if(_weak)
                    {
                        Error("Methods cannot be weak");
                        scope = prevScope;
                        return false;
                    }
                    if(_const)
                    {
                        Error("Methods cannot be const");
                        scope = prevScope;
                        return false;
                    }
                    fn.line = scanner.Line;
                    // Handle property-like getters/setters and constructors
                    if (decl.isGetter)
                    {
                        fn.Name = string.format("get_%s", decl.name);
                    }
                    else if (decl.isSetter)
                    {
                        fn.Name = string.format("set_%s", decl.name);
                    }
                    else if (fn.Name == "constructor")
                    {
                        // Add constructor parameters to the class factory
                        for(int i = 0; i < fn.Parameters.count; ++i)
                        {
                            LocalVariable p = fn.Parameters[i];
                            LocalVariable p2 = new LocalVariable(factory, p.Name, p.DataType, null);
                            p2.Offset = p.Offset;
                            factory.Parameters.add(p2);
                        }
                    }

                    string fname = fn.Name;

                    // For instance methods, insert an implicit 'this' parameter
                    if (!_static)
                    {
                        LocalVariable _this = new LocalVariable(fn, "this", cls.GetPointerType(), null);
                        for(int i = 0; i < fn.Parameters.count; ++i)
                        {
                            fn.Parameters[i].Offset++;
                        }
                        _this.Offset = 1;
                        fn.Parameters.insert(0, _this);
                    }

                    // Create the method symbol that references the underlying function
                    MethodSymbol ms = new MethodSymbol(cls, fname, fn);

                    // If this member is a property getter/setter, attach it to the
                    // corresponding PropertySymbol on the class (creating the
                    // property if necessary).
                    if (decl.isGetter)
                    {
                        PropertySymbol p = cls.FindChild(decl.name) as PropertySymbol;
                        if (p == null)
                        {
                            p = new PropertySymbol(cls, decl.name, fn.ReturnType);
                            p.Flags |= visibility;
                            if(_static)
                                p.Flags |= SymbolFlags.Static;
                            p.attributes = attributes;
                            if(p.attributes != null)
                                p.Flags += SymbolFlags.HasAttributes;
                            attributes = null;
                        }
                        else
                        {
                            p.Flags = FixPropertyVisibility(p.Flags, visibility);
                        }
                        p.Getter = ms;

                        if(fn.ReturnType.IsStruct())
                        {
                            CreateRawGetter(cls, fn, _static, _virtual, visibility);
                        }
                    }
                    else if (decl.isSetter)
                    {
                        PropertySymbol p = cls.FindChild(decl.name) as PropertySymbol;
                        if (p == null)
                        {
                            p = new PropertySymbol(cls, decl.name, fn.Parameters[_static?0:1].DataType);
                            p.Flags |= visibility;
                            if(_static)
                                p.Flags |= SymbolFlags.Static;
                            p.attributes = attributes;
                            if(p.attributes != null)
                                p.Flags += SymbolFlags.HasAttributes;
                            attributes = null;
                        }
                        else
                        {
                            p.Flags = FixPropertyVisibility(p.Flags, visibility);
                        }
                        p.Setter = ms;

                        if(fn.Parameters[_static?0:1].DataType.IsStruct())
                        {
                            CreateRawSetter(cls, fn, _static, _virtual, visibility);
                        }
                    }
                    else
                    {
                        ms.attributes = attributes;
                        if(ms.attributes != null)
                            ms.Flags += SymbolFlags.HasAttributes;
                        attributes = null;
                    }
                    // Mark static/virtual flags on the method symbol and
                    // adjust vtable slot assignment when necessary.
                    if (_static)
                    {
                        ms.Flags += SymbolFlags.Static;
                        fn.Flags += SymbolFlags.Static;
                    }

                    VirtualizeMethod(ms, fn, cls, _static, _virtual);

                    // Static method extension: a static method whose first
                    // parameter is named 'this' is treated as an extension method
                    // for that type. The parser synthesizes an 'ext_<TypeName>'
                    // class to host such extension methods.
                    if (_static && fn.Parameters.count > 0 && fn.Parameters[0].Name == "this")
                    {
                        TypeSymbol typeToExtend = fn.Parameters[0].DataType;
                        if(typeToExtend.IsClassRef())
                            typeToExtend = typeToExtend.ElementType;
                        string extName = string.format("ext_%s", TypeToFName(typeToExtend));
                        ClassType extCls = FindType(extName) as ClassType;
                        if(extCls == null)
                            extCls = new ClassType(module, extName);
                        MethodSymbol extensionMethod = new MethodSymbol(extCls, fn.Name, fn);
                        fn.Name = string.format("ext_%s", fn.Name);
                    }
                    
                    // Mangle function name to include class scope and register
                    // the function symbol with the compile unit for later use.
                    fn.Name = string.format("%s__%s", cls.Name, fn.Name);
                    module.AddChild(fn);
                    unit.AddSymbol(fn);
                    ms.Flags += visibility;

                    // Method bodies can either be provided as braces (function
                    // definition) or as a double-arrow shorthand or omitted.
                    if (scanner.Token == Token.LBrace)
                    {
                        // Skip method body at this stage; later passes will parse
                        // the body and generate code.
                        SkipBraces();
                        if (!Expect(Token.RBrace))
                        {
                            scope = prevScope;
                            return false;
                        }
                    }
                    else if(scanner.Token == Token.DoubleArrow)
                    {
                        // Double-arrow indicates an inline code snippet that we
                        // skip until the trailing semicolon.
                        scanner.NextToken();
                        while (scanner.Token != Token.Semicolon && scanner.Token != Token.EOF)
                            scanner.NextToken();
                        if (!Expect(Token.Semicolon))
                        {
                            scope = prevScope;
                            return false;
                        }
                    }
                    else
                    {
                        Error("Syntax error");
                        scope = prevScope;
                        return false;
                    }
                }
                else
                {
                    if(_const)
                    {
                        if(!Expect(Token.Assign))
                        {
                            scope = prevScope;
                            return false;
                        }
                        ConstantExpression constVal = ParseConstantExpression();
                        if (constVal == null)
                        {
                            scope = prevScope;
                            return false;
                        }
                        Expression value = ForceCast(constVal, decl.type);
                        ConstantValue cf = new ConstantValue(cls, decl.name, value);
                        cf.Flags |= SymbolFlags.Static;
                        cf.Flags += visibility;
                    }
                    else
                    {
                        // Field declaration: create FieldSymbol and compute layout
                        FieldSymbol fs = new FieldSymbol(cls, decl.name, decl.type);
                        fs.Unit = unit;
                        fs.attributes = attributes;
                        if(fs.attributes != null)
                            fs.Flags += SymbolFlags.HasAttributes;
                        attributes = null;
                        if (!_static)
                        {
                            int alignment = GetAlignment(decl.type);
                            if (alignment == 0)
                            {
                                Error(string.format("Type '%s' is incomplete or has zero size", decl.type.Name));
                                scope = prevScope;
                                _class = null;
                                return false;
                            }
                            fs.Index = cls.FieldCount;
                            cls.FieldCount++;
                            int offs = ((cls.Size + alignment - 1) / alignment) * alignment;
                            fs.Offset = offs;
                            cls.SetSize(offs + decl.type.Size);
                        }
                        else
                        {
                            fs.Flags += SymbolFlags.Static;                        
                        }

                        if (_weak)
                            fs.Flags += SymbolFlags.Weak;

                        fs.Flags += visibility;

                        // Parse optional initializer for static fields
                        if (scanner.Token == Token.Assign)
                        {
                            scanner.NextToken();
                            if(scanner.Token == Token.LBrace)
                                fs.InitialValue = ParseInitList(fs.DataType);
                            else
                                fs.InitialValue = ParseExpression();
                            if (fs.InitialValue == null)
                            {
                                scope = prevScope;
                                return false;
                            }
                        }

                        // If this is a static field, create a companion GlobalVariable
                        // that will be used by the codegen/linker to represent storage.
                        if((fs.Flags & SymbolFlags.Static) != 0)
                        {
                            string gname = string.format("%s__%s", cls.Name, fs.Name);
                            GlobalVariable gv = module.Find(gname) as GlobalVariable;
                            if(gv == null) {
                                gv = new GlobalVariable(module, gname, fs.DataType, null);
                                unit.AddSymbol(gv);
                                gv.Unit = unit;
                            }
                        }

                        // Consume up to the trailing semicolon that ends the field decl
                        while(scanner.Token != Token.Semicolon && scanner.Token != Token.EOF)
                            scanner.NextToken();
                    }
                    if (!Expect(Token.Semicolon))
                    {
                        scope = prevScope;
                        _class = null;
                        return false;
                    }
                }
            }

            if (!Expect(Token.RBrace))
            {
                scope = prevScope;
                _class = null;
                return false;
            }

            if (cls.Name != "object")
            {
                // Ensure default constructor exists (delegates to base ctor)
                MethodSymbol ownCtorMethod = cls.Find("constructor") as MethodSymbol;
                if(ownCtorMethod == null)
                {
                    if (!CreateConstructor(cls))
                    {
                        scope = prevScope;
                        return false;
                    }
                }

                // Add virtual getClassName() method used by runtime reflection
                if (!CreateGetClassNameMethod(cls))
                {
                    scope = prevScope;
                    return false;
                }

                // Add finalizer method that releases member references and
                // chains to base finalize implementation.
                if (!CreateFinalizer(cls))
                {
                    scope = prevScope;
                    return false;
                }
            }        
            // Create virtual table global var and populate its static init
            if (!CreateVirtualTable(cls))
            {
                scope = prevScope;
                return false;
            }

            // Create per-class instance initialization method called by the
            // constructor to initialize instance fields.
            if (!CreateInstanceInitMethod(cls))
            {
                scope = prevScope;
                return false;
            }
            
            scope = prevScope;
            _class = null;
            return true;
        }
        return false;
    }

    // CreateConstructor - synthesize a default constructor function for a
    // class when the user did not provide one. The generated function calls
    // the base class constructor and returns the constructed object.
    bool CreateConstructor(ClassType cls)
    {
        Function ownCtor = new Function(module, string.format("%s__constructor", cls.Name), cls.GetPointerType());
        LocalVariable ownCtorThis = new LocalVariable(ownCtor, "this", cls.GetPointerType(), null);
        ownCtorThis.Offset = 1;
        ownCtor.Parameters.add(ownCtorThis);
        ownCtor.Body = new StatementBlock();
        unit.AddSymbol(ownCtor);
        MethodSymbol baseCtorMethod = cls.BaseClass.FindChild("constructor") as MethodSymbol;
        if(baseCtorMethod == null)
        {
            Error("No base ctor method");
            return false;
        }
        Function baseCtorFn = baseCtorMethod.GetFunction();
        if(baseCtorFn == null)
        {
            Error("No base ctor function");
            return false;
        }
        FindOrImport(baseCtorFn.Name);
        if (baseCtorFn.Parameters.count > 1)
        {
            Error(string.format("No default constructor for %s", cls.BaseClass.Name));
            return false;
        }
        FunctionCallExpression baseFCall = new FunctionCallExpression(new SymbolExpression(baseCtorFn));
        baseFCall.Arguments.add(new SymbolExpression(ownCtorThis));

        LocalVariable lv = new LocalVariable(ownCtor.Body.Scope, string.format("__temp%d", scanner.Line), ownCtorThis.DataType, null);
        lv.Offset = -(++ownCtor.LocalsCount);
        ownCtor.Locals.add(lv);

        AssignmentExpression assign = new AssignmentExpression(new SymbolExpression(lv), baseFCall);
        ownCtor.Body.Statements.add(new ExpressionStatement(assign));

        ownCtor.Body.Statements.add(new ReturnStatement(new SymbolExpression(lv)));

        ownCtor.Flags += SymbolFlags.NoDebug;

        return true;
    }

    // CreateGetClassNameMethod - synthesize a virtual method that returns the
    // class name as a string pointer. This method is used for runtime type
    // identification and defaults to delegating to base class vtable
    // slot when overriding. getClassName() is used by "is" and "as" operators 
    bool CreateGetClassNameMethod(ClassType cls)
    {
        Function getClassName = new Function(module, string.format("%s__getClassName", cls.Name), TypeSymbol.Byte.GetPointerType());
        getClassName.Flags += SymbolFlags.NoDebug;
        LocalVariable getClassNameThis = new LocalVariable(getClassName, "this", cls.GetPointerType(), null);
        getClassNameThis.Offset = 1;
        getClassName.Parameters.add(getClassNameThis);
        string clsName = module.AddString(cls.Name);
        unit.AddString(clsName);
        unit.AddSymbol(getClassName);
        getClassName.Body = new StatementBlock();
        getClassName.Body.Statements.add(new ReturnStatement(ConstantExpression.FromString(clsName)));

        MethodSymbol getClassNameMethod = new MethodSymbol(cls, "getClassName", getClassName);
        getClassNameMethod.Flags += SymbolFlags.Virtual;

        if (cls.BaseClass == null)
        {
            getClassNameMethod.VSlot = cls.VirtualMethods.count;
            cls.VirtualMethods.add(getClassNameMethod);
        }
        else
        {
            MethodSymbol getBaseClassName = cls.BaseClass.FindChild("getClassName") as MethodSymbol;
            if(getBaseClassName == null)
            {
                Error(string.format("No getClassName for %s", cls.BaseClass.Name));
                return false;
            }
            getClassNameMethod.VSlot = getBaseClassName.VSlot;
            cls.VirtualMethods[getClassNameMethod.VSlot] = getClassNameMethod;
        }
        return true;
    }

    // CreateFinalizer - generate a finalize method that releases non-static
    // strong references held in instance fields and then calls the base
    // class finalizer. The finalizer is registered in the class's vtable
    // using the same virtual slot as the user-declared finalize method.
    bool CreateFinalizer(ClassType cls)
    {
        Function finalize = new Function(module, string.format("%s__finalize", cls.Name), cls.GetPointerType());
        unit.AddSymbol(finalize);
        LocalVariable finalizeThis = new LocalVariable(finalize, "this", cls.GetPointerType(), null);
        finalizeThis.Offset = 1;
        finalize.Parameters.add(finalizeThis);
        finalize.Body = new StatementBlock();
        finalize.Flags += SymbolFlags.NoDebug;
        for(int i = 0; i < cls.Children.count; ++i)
        {
            FieldSymbol fs = cls.Children[i] as FieldSymbol;
            if (fs != null 
                && fs.DataType.IsClassRef()
                && (fs.Flags & SymbolFlags.Static) == 0
                && (fs.Flags & SymbolFlags.Weak) == 0)
            {
                // Generate call to object's release method for each strong
                // reference field so destructor semantics are honored.
                FieldExpression fe = new FieldExpression(new SymbolExpression(finalizeThis), fs);
                ClassType cls2 = fs.DataType.ElementType as ClassType;
                MethodSymbol rel = FindType("object").FindChild("release") as MethodSymbol;
                FunctionCallExpression fc = new FunctionCallExpression(new SymbolExpression(rel.DataType));
                fc.Arguments.add(fe);
                finalize.Body.Statements.add(new ExpressionStatement(fc));
            }
        }

        MethodSymbol baseFinalizeMethod = cls.BaseClass.FindChild("finalize") as MethodSymbol;
        Function baseFinalize = baseFinalizeMethod.DataType as Function;
        FindOrImport(baseFinalize.Name);
        FunctionCallExpression baseCall = new FunctionCallExpression(new SymbolExpression(baseFinalize));
        baseCall.Arguments.add(new SymbolExpression(finalizeThis));
        finalize.Body.Statements.add(new ExpressionStatement(baseCall));

        MethodSymbol finBase = cls.FindChild("finalize") as MethodSymbol;
        int vslot = finBase.VSlot;
        MethodSymbol finalizeMethod = new MethodSymbol(cls, "finalize", finalize.DataType as Function);
        finalizeMethod.VSlot = vslot;
        finalizeMethod.Flags += SymbolFlags.Virtual;
        cls.VirtualMethods[vslot] = finalizeMethod;

        return true;
    }

    // CreateVirtualTable - prepare the vtable global variable for a class by
    // building an array of function pointers (void**) where each slot
    // corresponds to a virtual method. The parser adds AddressOf expressions
    // for each method into an InitList which is then assigned into the
    // per-unit static initializer so vtables are constructed at program start.
    bool CreateVirtualTable(ClassType cls)
    {
        if (cls.VirtualMethods.count == 0)
            cls.VirtualMethods.add(null);   // llvm doesnt like empty arrays

        PointerType vptr = TypeSymbol.Void.GetPointerType();
        ArrayType vpar = vptr.GetArrayType(cls.VirtualMethods.count);
        GlobalVariable vtab = new GlobalVariable(module, string.format("%s__vtable", cls.Name), vpar, null);
        vtab.Unit = unit;
        unit.AddSymbol(vtab);
        InitList vini = new InitList(vpar);
        for(int i = 0; i < cls.VirtualMethods.count; ++i)
        {
            MethodSymbol v = cls.VirtualMethods[i];
            if(v != null)
            {
                Function fn = v.GetFunction();
                // Ensure we add a reference to the function symbol so it is
                // available during later stages.
                FindOrImport(fn.Name);
                vini.Expressions.add(new AddressOfExpression(new SymbolExpression(fn)));
            }
        }
        // Add vtable init into the unit's static init function so that it's
        // executed at program startup. StaticAssign will recursively create
        // assignments for array elements or nested aggregates.
        Function fnInit = unit.staticInit;
        StatementBlock sinitBody = fnInit.Body;
        StaticAssign(sinitBody,
            new SymbolExpression(vtab),
            vini, 0, null);

        return true;
    }

    // CreateInstanceInitMethod - synthesize a per-class instance init
    // function that can be invoked from constructors to initialize instance
    // fields. The method body is created here but populated later in other
    // parser stages.
    bool CreateInstanceInitMethod(ClassType cls)
    {
        Function init = new Function(module, string.format("%s__init", cls.Name), cls.GetPointerType());
        unit.AddSymbol(init);
        LocalVariable iniThis = new LocalVariable(init, "this", cls.GetPointerType(), null);
        iniThis.Offset = 1;
        init.Parameters.add(iniThis);
        init.Body = new StatementBlock();
        init.Flags += SymbolFlags.NoDebug;
        return true;
    }

    // ParseGlobalOrFunction - handle top-level function and global variable
    // declarations in more detail than Parser1: this stage registers function
    // symbols for later stages and processes modifiers such as 'external'
    // and 'verbatim'. Function bodies are still skipped.
    bool ParseGlobalOrFunction()
    {
        if(IsKeyword("const"))
        {
            while (scanner.Token != Token.EOF && scanner.Token != Token.Semicolon)
                scanner.NextToken();
            return Expect(Token.Semicolon);
        }

        int line = scanner.Line;

        if (IsType())
        {
            Declaration decl = new Declaration();
            if(!ParseDeclaration(decl, true, null, false, false))
            {
                return false;
            }

            if(decl.isByRef)
            {
                Error("Reference not allowed here");
                return false;
            }

            if(decl.type.IsFunction())
            {
                module.AddChild(decl.type);
                // Register the function signature (type) with the unit so
                // later passes can resolve method bodies and generate code.
                unit.AddSymbol(decl.type);
                decl.type.line = line;

                decl.type.attributes = attributes;
                if(decl.type.attributes != null)
                    decl.type.Flags += SymbolFlags.HasAttributes;
                attributes = null;

                if(scanner.Token == Token.LBrace)
                {
                    // Function body: skip for this stage
                    SkipBraces();
                    return Expect(Token.RBrace);
                }
                else if(scanner.Token == Token.DoubleArrow)
                {
                    // Inline shorthand: skip until semicolon
                    scanner.NextToken();
                    while (scanner.Token != Token.Semicolon && scanner.Token != Token.EOF)
                        scanner.NextToken();
                    return Expect(Token.Semicolon);
                }
                else
                {
                    // Function declaration modifiers
                    if (IsKeyword("external"))
                        decl.type.Flags += SymbolFlags.External;
                    else if (IsKeyword("verbatim"))
                    {
                        // Verbatim functions embed a literal string representing
                        // the implementation; capture and store it on the
                        // Function object for later code generation.
                        decl.type.Flags += SymbolFlags.Verbatim;
                        if(scanner.Token != Token.String)
                        {
                            Error("Verbatim string expected");
                            return false;
                        }
                        ((Function)decl.type).Verbatim = scanner.TokenString;
                        scanner.NextToken();
                    }

                    return Expect(Token.Semicolon);
                }
            }
            else
            {
                // Global variable declaration: skip initializer or consume
                // trailing semicolon.
                while(scanner.Token != Token.EOF)
                {
                    if (scanner.Token == Token.Semicolon)
                        break;
                    scanner.NextToken();
                }
                return Expect(Token.Semicolon);
            }
        }
        else
        {
            Error("Syntax error");
            return false;
        }
    }
}