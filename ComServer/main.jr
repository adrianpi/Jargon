using jargon;
using JargonCom;

/*

Register the COM server in the registry with the following keys:

HKEY_CLASSES_ROOT
    CLSID
        {EF30D8D6-99C5-408B-B202-9BF19AB77667}
            (Default)="Example Jargon COM Object"
            InprocServer32
                (Default)="C:\Jargon\x64\Debug\ComServer.dll"
                ThreadingModel="Apartment"

You can also use regsvr32.exe from a privileged console.
*/

int g_instances = 0;
int g_lockCount = 0;
long g_hModule = 0;

int MessageBoxA(long hWnd, byte* lpText, byte* lpCaption, uint uType) external;
uint GetModuleFileNameW(long hModule, short* lpFilename, uint nSize) external;
long RegCreateKeyExW(long hKey, short* lpSubKey, uint Reserved, short* lpClass, uint dwOptions, uint samDesired, void* lpSecurityAttributes, long* phkResult, uint* lpdwDisposition) external;
long RegSetValueExW(long hKey, short* lpValueName, uint Reserved, uint dwType, byte* lpData, uint cbData) external;
long RegCloseKey(long hKey) external;
long RegDeleteTreeW(long hKey, short* lpSubKey) external;

[ComInterface("A96BAFB4-5CDE-4560-A2EC-1B724984C621")]
class IMyComObject : IUnknown
{
    virtual void Foo();
}

[ComClass("EF30D8D6-99C5-408B-B202-9BF19AB77667")]
class MyComObject : IMyComObject
{
    int refCount = 1;

    MyComObject constructor()
    {
        g_instances++;
        return this;
    }

    uint QueryInterface(IID* riid, void** ppvObject)
    {
        IID iidUnk = uuidof(IUnknown);
        IID iidIObj = uuidof(IMyComObject);
        if(*riid == iidUnk || *riid == iidIObj)
        {
            *ppvObject = this;
            refCount++;
            return S_OK;
        }
        *ppvObject = null;
        return E_NOINTERFACE;
    }

    uint AddRef()
    {
        return ++refCount;
    }

    uint Release()
    {
        int rc = --refCount;
        if(rc == 0)
        {
            delete this;
            g_instances--;
        }
        return rc;
    }

    virtual void Foo()
    {
        MessageBoxA(0, "Foo method called", "MyComObject", 0);
    }
}

[ComClass("998C9DE2-5ADC-4FE5-ABAA-8431FD340E06")]
class MyClassFactory : IClassFactory
{
    int refCount = 1;

    uint QueryInterface(IID* riid, void** ppvObject)
    {
        IID iidUnk = uuidof(IUnknown);
        IID iidFact = uuidof(IClassFactory);
        if(*riid == iidUnk || *riid == iidFact)
        {
            *ppvObject = this;
            refCount++;
            return S_OK;
        }
        *ppvObject = null;
        return E_NOINTERFACE;
    }

    uint AddRef()
    {
        return ++refCount;
    }

    uint Release()
    {
        int rc = --refCount;
        if(rc == 0)
            delete this;
        return rc;
    }

    uint CreateInstance(IUnknown pUnkOuter, IID* riid, void** ppvObject)
    {
        if (pUnkOuter != null)
            return 0x80040110L; // CLASS_E_NOAGGREGATION

        if(*riid == uuidof(IMyComObject))
        {
            MyComObject* obj = new MyComObject();
            *ppvObject = obj;
            return S_OK;
        }
        return E_NOINTERFACE;
    }

    uint LockServer(bool fLock)
    {
        if(fLock)
            ++g_lockCount;
        else
            --g_lockCount;
        return S_OK;
    }
}

MyClassFactory myClassFactory = null;

uint DllGetClassObject(IID *rclsid, IID *riid, void **ppv)
{
    IID id = uuidof(MyComObject);
    if(*rclsid == uuidof(MyComObject))
    {
        uint hr = myClassFactory.QueryInterface(riid, ppv);
        return hr;
    }
    return 0x80040111; // CLASS_E_CLASSNOTAVAILABLE
}

uint DllCanUnloadNow()
{
    if(g_instances == 0 && g_lockCount == 0)
        return S_OK;
    else
        return S_FALSE;
}

int DllStart(long hModule, int dwReason, void *pReserved)
{
    if(dwReason == 1) // DLL_PROCESS_ATTACH
    {
        g_hModule = hModule;
        myClassFactory = new MyClassFactory();
    }
    else if(dwReason == 0) // DLL_PROCESS_DETACH
    {
        if(myClassFactory != null)
        {
            myClassFactory.Release();
            myClassFactory = null;
        }
    }
    return 1; // TRUE
}

uint DllRegisterServer()
{
    long HKEY_CLASSES_ROOT = 0x80000000;
    uint KEY_WRITE = 0x20006;
    uint REG_SZ = 1;

    short dllPath[1024];
    uint pathLen = GetModuleFileNameW(g_hModule, &dllPath[0], 1024);
    if(pathLen == 0)
    {
        return E_FAIL;
    }

    long hKeyCLSID = 0;
    long hKeyGuid = 0;
    long hKeyInproc = 0;
    uint disposition = 0;

    // Build the registry key path
    wstring rootKey = L"CLSID\\{";
    IID iid = uuidof(MyComObject);
    rootKey += wstring.fromString(GuidToString(&iid));
    rootKey += L"}";

    // Delete the key first if it exists to ensure clean registration
    RegDeleteTreeW(HKEY_CLASSES_ROOT, rootKey.c_str());

    // Create key HKEY_CLASSES_ROOT\CLSID\{...}
    long result = RegCreateKeyExW(HKEY_CLASSES_ROOT, rootKey.c_str(), 0, null, 0, KEY_WRITE, null, &hKeyGuid, &disposition);
    if(result != 0)
    {
        return E_FAIL;
    }

    wstring description = L"Example Jargon COM Object";
    RegSetValueExW(hKeyGuid, null, 0, REG_SZ, description.c_str(), description.length * 2);
    // Create InprocServer32 subkey
    result = RegCreateKeyExW(hKeyGuid, L"InprocServer32", 0, null, 0, KEY_WRITE, null, &hKeyInproc, &disposition);
    if(result != 0)
    {
        RegCloseKey(hKeyGuid);
        return E_FAIL;
    }

    // Set default value to DLL path
    RegSetValueExW(hKeyInproc, null, 0, REG_SZ, dllPath, pathLen * 2);

    // Set ThreadingModel
    wstring threadingModel = L"Apartment";
    RegSetValueExW(hKeyInproc, L"ThreadingModel", 0, REG_SZ, threadingModel.c_str(),
        threadingModel.length * 2);

    RegCloseKey(hKeyInproc);
    RegCloseKey(hKeyGuid);

    return S_OK;
}

uint DllUnregisterServer()
{
    long HKEY_CLASSES_ROOT = 0x80000000;

    // Delete HKEY_CLASSES_ROOT\CLSID\{...} and all subkeys
    wstring rootKey = L"CLSID\\{";
    IID iid = uuidof(MyComObject);
    rootKey += wstring.fromString(GuidToString(&iid));
    rootKey += L"}";

    long result = RegDeleteTreeW(HKEY_CLASSES_ROOT, rootKey.c_str());

    if(result != 0 && result != 2) // Allow ERROR_FILE_NOT_FOUND (2)
        return E_FAIL;

    return S_OK;
}
