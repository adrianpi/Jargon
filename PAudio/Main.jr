using jargon;

///////////////////////////////////////////////////////////////
// This is another interop example that generates a sawtooth 
// wave using the PortAudio library.
// To build this example, you will need to have the PortAudio
// library, available at http://www.portaudio.com/download.html
// You may need to adjust the library include path.
///////////////////////////////////////////////////////////////

// ============================================================
// Sawtooth wave state
// ============================================================

const double SAMPLE_RATE = 44100.0;
const double FREQUENCY   = 440.0;
const double AMPLITUDE   = 0.3;

// Phase accumulates from 0.0 to 1.0 then wraps
double phase = 0.0;

// ============================================================
// Audio callback - generates a mono 440Hz sawtooth wave
// ============================================================

int sawtoothCallback(void *input, void *output, uint frameCount, 
    PaStreamCallbackTimeInfo* timeInfo, PaStreamCallbackFlags statusFlags, void *userData)
{
    float *out = (float*)output;
    double phaseInc = FREQUENCY / SAMPLE_RATE;

    for(uint i = 0; i < frameCount; i++)
    {
        float sample = (2.0 * phase - 1.0) * AMPLITUDE;
        *out++ = sample; // left channel
        *out++ = sample; // right channel

        phase = phase + phaseInc;
        if(phase >= 1.0)
            phase = phase - 1.0;
    }

    return PaStreamCallbackResult.Continue;
}

// ============================================================
// Main - open default output and play sawtooth for 2 seconds
// ============================================================

int main(int argc, byte **argv)
{
    PaError err = Pa_Initialize();

    if(err != PaErrorCode.NoError)
    {
        println("Failed to initialize PortAudio: %s\n", Pa_GetErrorText(err));
        return 1;
    }

    PaStream stream = 0;
    err = Pa_OpenDefaultStream(
        &stream,
        0,                          // no input channels
        2,                          // stereo output
        PaSampleFormat.Float32,     // 32-bit float samples
        SAMPLE_RATE,
        256,                        // frames per buffer
        sawtoothCallback,
        null
    );

    if(err != PaErrorCode.NoError || stream == 0)
    {
        println("Failed to open stream: %s\n", Pa_GetErrorText(err));
        Pa_Terminate();
        return 1;
    }

    err = Pa_StartStream(stream);

    // Play for 2 seconds
    Pa_Sleep(2000);

    err = Pa_StopStream(stream);
    err = Pa_CloseStream(stream);

    Pa_Terminate();

    return 0;
}
